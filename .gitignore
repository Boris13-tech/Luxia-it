# ─────────────────────────────────────────────────────────────────────────────
# Luxia-IT .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment & secrets ─────────────────────────────────────────────────────
# Never commit real environment values.
.env
.env.local
.env.*.local

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/

# ── OS / editor artefacts ─────────────────────────────────────────────────────
.DS_Store
.thumbnail
*.log
.vscode/
.idea/
Thumbs.db
desktop.ini

# ── Internal / maintainer-only files ─────────────────────────────────────────
# These files exist for maintainers but must NOT be shipped to production
# and should NOT be publicly visible on GitHub.

# Phase 1-4 strategy document — internal provenance only.
Luxia-IT Strategy.dc.html

# Repository sync log — internal only.
github.md

# ── Runtime generated files ───────────────────────────────────────────────────
# Image-slot state is written at runtime by the preview environment.
image-slots.state.json

# ── Design tool internal files ────────────────────────────────────────────────
# .thumbnail is a preview image generated by the design tool, not source.
.thumbnail

# ── Working-directory artefacts (local only, not for GitHub) ──────────────────
# These are local extraction/working folders — never push to the repository.
extracted_preview/
Incomplete mobile app designrefine/
Incomplete mobile app designrefine.zip
