---
/**
 * Pied de page sur fond encre. Contrastes : texte 15,7:1, texte secondaire
 * 8,8:1, liens au survol 8,7:1. Seules les coordonnées validées s'affichent.
 */
import Logo from './Logo.astro';
import { facts } from '../data/facts';
import { localeFromPath } from '../i18n/config';
import { href } from '../i18n/routes';
import { ui } from '../i18n/ui';

const locale = localeFromPath(Astro.url.pathname);
const t = ui[locale];
const year = new Date().getFullYear();
const { email, phone, phoneHref, linkedin } = facts.contact;
---

<footer class="ftr">
  <div class="wrap ftr__top">
    <div class="ftr__brand">
      <a class="ftr__logo" href={href('home', locale)}>
        <Logo tone="reverse" />
        <span class="visually-hidden">{t.homeSuffix}</span>
      </a>
      <p class="ftr__tagline">{t.footerTagline}</p>
      <div>
        <p class="ftr__title" id="ftr-contact">{t.footerContact}</p>
        <ul class="ftr__links" aria-labelledby="ftr-contact">
          <li><a href={`mailto:${email}`}>{email}</a></li>
          <li><a href={phoneHref}>{phone}</a></li>
          {linkedin && <li><a href={linkedin} rel="noopener">LinkedIn</a></li>}
        </ul>
      </div>
    </div>

    <nav class="ftr__cols" aria-label={t.footerNav}>
      {
        t.footerColumns.map((col, i) => (
          <div>
            <p class="ftr__title" id={`ftr-col-${i}`}>{col.title}</p>
            <ul class="ftr__links" aria-labelledby={`ftr-col-${i}`}>
              {col.links.map((l) => (
                <li>
                  <a href={href(l.id, locale)}>{l.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>

  <div class="wrap ftr__bottom">
    <p>© {year} {facts.brand.name}</p>
    <ul class="ftr__legal" aria-label={t.footerLegal}>
      {
        t.legalItems.map((l) => (
          <li>
            <a href={href(l.id, locale)}>{l.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  .ftr {
    background-color: var(--dark);
    color: var(--on-dark-2);
    font-size: var(--fs-small);
  }

  .ftr :focus-visible {
    outline-color: var(--blue-light);
  }

  .ftr__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 48px var(--gap);
    padding-block: clamp(56px, 7vw, 88px) 48px;
  }

  .ftr__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }

  .ftr__logo {
    display: inline-flex;
  }

  .ftr__tagline {
    max-width: 22rem;
    color: var(--on-dark);
  }

  .ftr__cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px var(--gap);
  }

  .ftr__title {
    margin-bottom: 14px;
    font-family: var(--mono);
    font-size: var(--fs-meta);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--on-dark-2);
  }

  .ftr__links {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .ftr__links a,
  .ftr__legal a {
    display: inline-block;
    padding-block: 6px;
    color: var(--on-dark);
  }

  .ftr__links a:hover,
  .ftr__legal a:hover {
    color: var(--blue-light);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .ftr__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 32px;
    padding-block: 20px 28px;
    border-top: 1px solid var(--on-dark-line);
  }

  .ftr__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
  }

  @media (min-width: 720px) {
    .ftr__cols {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .ftr__top {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    }
  }
</style>
