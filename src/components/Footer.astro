---
/** Pied de page bleu Luxia : marque, coordonnées, plan du site, certifications. */
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import Tbd from './Tbd.astro';
import { company, footerColumns, legalLinks } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="ftr on-brand">
  <div class="container ftr__top">
    <div class="ftr__brand">
      <a href="/" aria-label="Luxia-IT — accueil"><Logo tone="reverse" /></a>
      <p class="ftr__descriptor">{company.descriptor}</p>
      <ul class="ftr__contact">
        <li><Icon name="phone" size={18} /> <Tbd text="À FOURNIR : téléphone" /></li>
        <li><Icon name="mail" size={18} /> <Tbd text="À FOURNIR : adresse e-mail" /></li>
        <li><Icon name="map-pin" size={18} /> <Tbd text="À FOURNIR : adresse" /></li>
      </ul>
      <ul class="ftr__social" aria-label="Réseaux sociaux">
        <li>
          <span class="ftr__social-link" aria-disabled="true" title="Lien LinkedIn à fournir">in</span>
        </li>
      </ul>
    </div>

    <nav class="ftr__cols" aria-label="Plan du site">
      {
        footerColumns.map((col) => (
          <div>
            <p class="ftr__title">{col.title}</p>
            <ul class="ftr__links">
              {col.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>

    <div class="ftr__badges">
      <p class="ftr__title">Certifications et adhésions</p>
      <ul class="ftr__badge-list">
        <li class="ftr__badge"><Tbd text="À FOURNIR" /></li>
        <li class="ftr__badge"><Tbd text="À FOURNIR" /></li>
        <li class="ftr__badge"><Tbd text="À FOURNIR" /></li>
      </ul>
    </div>
  </div>

  <div class="ftr__bottom">
    <div class="container ftr__bottom-inner">
      <p>© {year} Luxia-IT</p>
      <ul class="ftr__legal">
        {
          legalLinks.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>

<style>
  .ftr {
    background-color: var(--brand);
    font-size: 0.9375rem;
  }

  .ftr__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px var(--gap);
    padding-block: 56px;
  }

  .ftr__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }

  .ftr__descriptor {
    max-width: 22rem;
    font-weight: 300;
  }

  .ftr__contact {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ftr__contact li {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .ftr__social {
    display: flex;
    gap: 10px;
  }

  .ftr__social-link {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--white);
    border-radius: 50%;
    font-weight: 500;
    font-size: 0.875rem;
  }

  .ftr__cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px var(--gap);
  }

  .ftr__title {
    margin-bottom: 14px;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ftr__links {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ftr__links a,
  .ftr__legal a {
    transition: opacity var(--dur) var(--ease);
  }

  .ftr__links a:hover,
  .ftr__legal a:hover {
    opacity: 0.75;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .ftr__badge-list {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .ftr__badge {
    display: grid;
    place-items: center;
    width: 112px;
    height: 64px;
    padding: 8px;
    border-radius: var(--radius-sm);
    background-color: rgb(255 255 255 / 0.14);
    font-size: 0.75rem;
  }

  .ftr__bottom {
    background-color: var(--brand-deep);
    font-size: 0.8125rem;
  }

  .ftr__bottom-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
    padding-block: 14px;
  }

  .ftr__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 0;
  }

  .ftr__legal li + li::before {
    content: '|';
    margin-inline: 10px;
    opacity: 0.6;
  }

  /* Laisse la place au bouton « haut de page » */
  @media (max-width: 719.98px) {
    .ftr__bottom-inner {
      padding-right: 64px;
    }
  }

  @media (min-width: 900px) {
    .ftr__top {
      grid-template-columns: 1.3fr 1fr 1fr;
    }
  }
</style>
