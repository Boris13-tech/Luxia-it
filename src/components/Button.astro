---
/** Bouton « pilule » avec chevron, comme sur la référence. */
import Icon from './Icon.astro';

interface Props {
  href: string;
  variant?: 'primary' | 'light' | 'outline' | 'outline-white' | undefined;
  size?: 'md' | 'sm' | undefined;
  class?: string | undefined;
}

const { href, variant = 'primary', size = 'md', class: className } = Astro.props;
---

<a class:list={['btn', `btn--${variant}`, size === 'sm' && 'btn--sm', className]} href={href}>
  <Icon name="chevron-right" size={16} stroke={2} />
  <slot />
</a>
