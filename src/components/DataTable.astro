---
/**
 * Tableau de données. Sur petit écran, chaque ligne devient un bloc et
 * l'intitulé de colonne est repris avant chaque cellule (styles .table).
 * Une cellule peut porter un niveau de preuve.
 */
import LevelTag from './LevelTag.astro';
import type { Level } from '../data/evidence';

export type Cell = string | { text: string; level?: Level | undefined };

interface Props {
  caption: string;
  /** Afficher la légende visuellement (sinon réservée aux lecteurs d'écran). */
  showCaption?: boolean | undefined;
  columns: readonly { key: string; label: string }[];
  rows: readonly Record<string, Cell>[];
}

const { caption, showCaption = false, columns, rows } = Astro.props;
const [first, ...rest] = columns;
const text = (cell: Cell | undefined) => (typeof cell === 'string' ? cell : (cell?.text ?? ''));
const level = (cell: Cell | undefined) => (typeof cell === 'object' ? cell.level : undefined);
---

<table class="table">
  <caption class:list={[!showCaption && 'visually-hidden']}>{caption}</caption>
  <thead>
    <tr>
      {columns.map((c) => <th scope="col">{c.label}</th>)}
    </tr>
  </thead>
  <tbody>
    {
      first &&
        rows.map((row) => (
          <tr>
            <th scope="row">{text(row[first.key])}</th>
            {rest.map((c) => {
              const cell = row[c.key];
              const lvl = level(cell);
              return (
                <td data-label={c.label}>
                  {lvl && (
                    <span class="table__lvl">
                      <LevelTag level={lvl} />
                    </span>
                  )}
                  {text(cell)}
                </td>
              );
            })}
          </tr>
        ))
    }
  </tbody>
</table>

<style>
  .table__lvl {
    display: block;
    margin-bottom: 6px;
  }
</style>
