---
import { href } from '../i18n/routes';
import { platformHref } from '../data/platforms';
import { stackLayers, strategicPillars, unifiedCore, type StackLayer } from '../data/stack';
import Icon from './Icon.astro';
import LevelTag from './LevelTag.astro';
import StageTag from './StageTag.astro';
import HumanScene from './HumanScene.astro';

interface Props {
  compact?: boolean | undefined;
  showHuman?: boolean | undefined;
}

const { compact = false, showHuman = true } = Astro.props;

const upperLayers = stackLayers.slice(0, 3); // Niveaux 06, 05, 04
const lowerLayers = stackLayers.slice(3, 6); // Niveaux 03, 02, 01

function layerHref(layer: StackLayer): string {
  if (layer.platformSlug) return platformHref(layer.platformSlug);
  if (layer.route) return href(layer.route);
  return href('platforms');
}
---

<div class:list={['usm', compact && 'usm--compact']} data-stack-matrix>
  <div class="flip-grid flip-grid--3 usm__grid" role="list" aria-label="Niveaux supérieurs : IA, preuves et souveraineté d’exécution">
    {
      upperLayers.map((layer) => (
        <article class="flip-card" data-flip-card data-flipped="false" role="listitem">
          <div class="flip-card__inner">
            <div class="flip-card__face flip-card__face--front">
              <div class="usm__card-top">
                <span class="usm__lvl">Niveau {layer.number}</span>
                <div class="usm__tags">
                  <StageTag stage={layer.stage} />
                  <LevelTag level={layer.level} />
                </div>
              </div>

              <h3 class="usm__title">{layer.name}</h3>
              <p class="usm__sub">{layer.subtitle}</p>

              {layer.workflow && (
                <ol class="usm__flow" aria-label="Chaîne de gouvernance des agents IA">
                  {layer.workflow.map((step, i) => (
                    <li class:list={['usm__step', i === layer.workflow!.length - 1 && 'usm__step--done']}>
                      <span>{step}</span>
                      {i < layer.workflow!.length - 1 && <Icon name="arrow-right" size={11} stroke={1.8} />}
                    </li>
                  ))}
                </ol>
              )}

              <button type="button" class="flip-card__hint" data-flip-trigger aria-expanded="false">
                <span>Cliquer pour retourner et explorer</span>
                <Icon name="arrow-right" size={14} stroke={1.8} />
              </button>
            </div>

            <div class="flip-card__face flip-card__face--back">
              <div class="usm__card-top">
                <span class="usm__lvl">Niveau {layer.number}</span>
                <a class="link usm__ext" href={layerHref(layer)}>
                  <span>{layer.ctaLabel ?? 'Voir la fiche'}</span>
                  <Icon name="arrow-right" size={14} stroke={1.8} />
                </a>
              </div>
              <p class="usm__summary">{layer.summary}</p>
              <ul class="usm__caps">
                {(compact ? layer.capabilities.slice(0, 3) : layer.capabilities).map((cap) => (
                  <li>
                    <Icon name="check" size={14} stroke={2} />
                    <span>{cap}</span>
                  </li>
                ))}
              </ul>
              <button type="button" class="flip-card__hint flip-card__hint--back" aria-label={`Retourner la carte ${layer.name}`}>
                <span>Revenir au recto</span>
              </button>
            </div>
          </div>
        </article>
      ))
    }
  </div>

  {
    showHuman && (
      <div class="usm__human-guard">
        <HumanScene
          src="/images/phase-ai-governance-human.jpg"
          alt="Une responsable sécurité et un ingénieur IA examinent ensemble un point de contrôle humain sur un poste avant d’autoriser une action critique."
          chapter="Supervision en direct"
          phaseTitle="L’humain valide chaque action critique avant exécution"
          caption="Un agent prépare et soumet son plan ; le responsable habilité tranche en un clic."
          layout="split"
          focal="top"
          ctaHref="/plateformes/alma/"
          ctaLabel="Découvrir ALMA"
        />
      </div>
    )
  }

  <div class="usm__spine" aria-label="Noyau d’intégration LUXIA">
    <div class="usm__spine-brand">
      <svg class="usm__prism" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
        <polygon points="12,3 21,19 3,19" fill="none" stroke="currentColor" stroke-width="1.6" />
        <line x1="12" y1="8" x2="12" y2="15" stroke="currentColor" stroke-width="1.4" />
      </svg>
      <div>
        <p class="usm__spine-title">{unifiedCore.name}</p>
        <p class="usm__spine-domains">{unifiedCore.domains.join(' · ')}</p>
      </div>
    </div>
    <p class="usm__spine-copy">{unifiedCore.statement}</p>
  </div>

  <div class="flip-grid flip-grid--3 usm__grid" role="list" aria-label="Niveaux fondateurs : confiance fédérée, politiques et identités">
    {
      lowerLayers.map((layer) => (
        <article class="flip-card" data-flip-card data-flipped="false" role="listitem">
          <div class="flip-card__inner">
            <div class="flip-card__face flip-card__face--front">
              <div class="usm__card-top">
                <span class="usm__lvl">Niveau {layer.number}</span>
                <div class="usm__tags">
                  <StageTag stage={layer.stage} />
                  <LevelTag level={layer.level} />
                </div>
              </div>

              <h3 class="usm__title">{layer.name}</h3>
              <p class="usm__sub">{layer.subtitle}</p>

              <ul class="usm__scopes" aria-label={`Périmètres couverts par ${layer.name}`}>
                {layer.scopes.map((scope) => (
                  <li>{scope}</li>
                ))}
              </ul>

              <button type="button" class="flip-card__hint" data-flip-trigger aria-expanded="false">
                <span>Cliquer pour retourner et explorer</span>
                <Icon name="arrow-right" size={14} stroke={1.8} />
              </button>
            </div>

            <div class="flip-card__face flip-card__face--back">
              <div class="usm__card-top">
                <span class="usm__lvl">Niveau {layer.number}</span>
                <a class="link usm__ext" href={layerHref(layer)}>
                  <span>{layer.ctaLabel ?? 'Voir la fiche'}</span>
                  <Icon name="arrow-right" size={14} stroke={1.8} />
                </a>
              </div>
              <p class="usm__summary">{layer.summary}</p>
              <ul class="usm__caps">
                {(compact ? layer.capabilities.slice(0, 3) : layer.capabilities).map((cap) => (
                  <li>
                    <Icon name="check" size={14} stroke={2} />
                    <span>{cap}</span>
                  </li>
                ))}
              </ul>
              <button type="button" class="flip-card__hint flip-card__hint--back" aria-label={`Retourner la carte ${layer.name}`}>
                <span>Revenir au recto</span>
              </button>
            </div>
          </div>
        </article>
      ))
    }
  </div>

  <div class="usm__pillars" aria-label="Piliers stratégiques de la plateforme LUXIA">
    {
      strategicPillars.map((pillar) => (
        <div class="usm__pillar">
          <h3 class="usm__pillar-title">
            {pillar.leftTitle}
            <span class="usm__pillar-sep">·</span>
            {pillar.rightTitle}
          </h3>
          <p class="usm__pillar-text">{pillar.detail}</p>
        </div>
      ))
    }
  </div>
</div>

<style>
  .usm {
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 3vw, 36px);
  }

  .usm__card-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .usm__lvl {
    font-family: var(--mono);
    font-size: var(--fs-meta);
    letter-spacing: 0.06em;
    color: var(--link);
    font-weight: 600;
  }

  .usm__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .usm__title {
    font-family: var(--display);
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  .usm__sub {
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--ink-2);
  }

  .usm__summary {
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--ink-2);
  }

  .usm__ext {
    font-size: var(--fs-meta);
  }

  .usm__flow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 8px;
    padding-block: 8px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .usm__step {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--ink-2);
  }

  .usm__step :global(svg) {
    color: var(--ink-3);
  }

  .usm__step--done {
    color: var(--link);
    font-weight: 600;
  }

  .usm__scopes {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 0;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--ink-3);
  }

  .usm__scopes li + li::before {
    content: ' · ';
    margin-inline: 6px;
    color: var(--line-strong);
  }

  .usm__caps {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .usm__caps li {
    display: grid;
    grid-template-columns: 16px minmax(0, 1fr);
    align-items: start;
    gap: 8px;
    font-size: var(--fs-small);
    line-height: 1.4;
    color: var(--ink-2);
  }

  .usm__caps :global(svg) {
    margin-top: 3px;
    color: var(--link);
  }

  .usm__human-guard {
    padding-block: clamp(12px, 2vw, 22px);
    border-top: 1px solid var(--line);
  }

  /* Colonne vertébrale : Plateforme unifiée LUXIA */
  .usm__spine {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: clamp(20px, 2.8vw, 28px);
    border-block: 1px solid var(--line-strong);
    background-color: var(--blue-tint);
  }

  .usm__spine-brand {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .usm__prism {
    flex-shrink: 0;
    color: var(--link);
  }

  .usm__spine-title {
    font-family: var(--display);
    font-size: var(--fs-h4);
    font-weight: 600;
    color: var(--ink);
  }

  .usm__spine-domains {
    font-family: var(--mono);
    font-size: var(--fs-meta);
    letter-spacing: 0.04em;
    color: var(--link);
  }

  .usm__spine-copy {
    max-width: 44rem;
    font-size: var(--fs-small);
    color: var(--ink);
  }

  /* Trois piliers de socle */
  .usm__pillars {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0 var(--gap);
    border-top: 1px solid var(--line);
  }

  .usm__pillar {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-block: clamp(20px, 2.5vw, 28px);
    border-bottom: 1px solid var(--line);
  }

  .usm__pillar:last-child {
    border-bottom: 0;
  }

  .usm__pillar-title {
    font-family: var(--display);
    font-size: var(--fs-h4);
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink);
  }

  .usm__pillar-sep {
    margin-inline: 6px;
    color: var(--ink-3);
    font-weight: 400;
  }

  .usm__pillar-text {
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--ink-2);
  }

  @media (min-width: 960px) {
    .usm__spine {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--gap);
    }

    .usm__pillars {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      border-bottom: 1px solid var(--line);
    }

    .usm__pillar {
      border-bottom: 0;
    }
  }
</style>
