---
import { href } from '../i18n/routes';
import { platformHref } from '../data/platforms';
import { stackLayers, strategicPillars, unifiedCore, type StackLayer } from '../data/stack';
import Icon from './Icon.astro';
import LevelTag from './LevelTag.astro';
import StageTag from './StageTag.astro';
import HumanScene from './HumanScene.astro';

interface Props {
  compact?: boolean | undefined;
  showHuman?: boolean | undefined;
}

const { compact = false, showHuman = true } = Astro.props;

const upperLayers = stackLayers.slice(0, 3); // Niveaux 06, 05, 04
const lowerLayers = stackLayers.slice(3, 6); // Niveaux 03, 02, 01

function layerHref(layer: StackLayer): string {
  if (layer.platformSlug) return platformHref(layer.platformSlug);
  if (layer.route) return href(layer.route);
  return href('platforms');
}
---

<div class:list={['usm', compact && 'usm--compact']} data-stack-matrix>
  {
    showHuman && (
      <div class="usm__human-brief">
        <HumanScene
          src="/images/phase-architecture-team.jpg"
          alt="Un architecte principal présente le découpage en couches techniques sur grand écran à deux ingénieurs autour d’une table de travail."
          chapter="Conception et intégration"
          phaseTitle="Une seule architecture cohérente, de l’infrastructure jusqu’aux agents d’IA"
          caption="Chaque niveau répond au suivant : le socle exécute, l’annuaire porte les identités, les politiques bornent les droits et la couche IA s’appuie sur cet historique sans bricolage parallèle."
          layout="wide"
          focal="top"
        />
      </div>
    )
  }

  <div class="usm__tier" role="list" aria-label="Niveaux supérieurs : IA, preuves et souveraineté d’exécution">
    {
      upperLayers.map((layer) => (
        <article class="usm__row" role="listitem">
          <div class="usm__meta">
            <div class="usm__code-line">
              <span class="usm__lvl">Niveau {layer.number}</span>
            </div>
            <div class="usm__tags">
              <StageTag stage={layer.stage} />
              <LevelTag level={layer.level} />
            </div>
          </div>

          <div class="usm__main">
            <div class="usm__head">
              <h3 class="usm__title">{layer.name}</h3>
              <p class="usm__sub">{layer.subtitle}</p>
            </div>
            <p class="usm__summary">{layer.summary}</p>

            {layer.workflow && (
              <ol class="usm__flow" aria-label="Chaîne de gouvernance des agents IA">
                {layer.workflow.map((step, i) => (
                  <li class:list={['usm__step', i === layer.workflow!.length - 1 && 'usm__step--done']}>
                    <span>{step}</span>
                    {i < layer.workflow!.length - 1 && <Icon name="arrow-right" size={12} stroke={1.8} />}
                  </li>
                ))}
              </ol>
            )}

            <ul class="usm__scopes" aria-label={`Périmètres couverts par ${layer.name}`}>
              {layer.scopes.map((scope) => (
                <li>{scope}</li>
              ))}
            </ul>
          </div>

          <div class="usm__spec">
            <ul class="usm__caps">
              {(compact ? layer.capabilities.slice(0, 3) : layer.capabilities).map((cap) => (
                <li>
                  <Icon name="check" size={14} stroke={2} />
                  <span>{cap}</span>
                </li>
              ))}
            </ul>
            <div class="usm__action">
              <a class="link" href={layerHref(layer)}>
                <span>{layer.ctaLabel ?? 'Voir la fiche technique'}</span>
                <Icon name="arrow-right" size={15} stroke={1.8} />
              </a>
            </div>
          </div>
        </article>
      ))
    }
  </div>

  {
    showHuman && (
      <div class="usm__human-guard">
        <HumanScene
          src="/images/phase-ai-governance-human.jpg"
          alt="Une responsable sécurité et un ingénieur IA examinent ensemble un point de contrôle humain sur un poste avant d’autoriser une action critique."
          chapter="LUXIA AI Security et ALMA"
          phaseTitle="L’humain garde la main avant toute action sensible"
          caption="Un agent autonome peut analyser et préparer une modification, jamais l’appliquer en silence : le point de blocage demande une validation explicite et laisse une trace datée."
          layout="split"
          focal="top"
          ctaHref="/plateformes/alma/"
          ctaLabel="Voir ALMA en détail"
        />
      </div>
    )
  }

  <div class="usm__spine" aria-label="Noyau d’intégration LUXIA">
    <div class="usm__spine-brand">
      <svg class="usm__prism" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
        <polygon points="12,3 21,19 3,19" fill="none" stroke="currentColor" stroke-width="1.6" />
        <line x1="12" y1="8" x2="12" y2="15" stroke="currentColor" stroke-width="1.4" />
      </svg>
      <div>
        <p class="usm__spine-title">{unifiedCore.name}</p>
        <p class="usm__spine-domains">{unifiedCore.domains.join(' · ')}</p>
      </div>
    </div>
    <p class="usm__spine-copy">{unifiedCore.statement}</p>
  </div>

  <div class="usm__tier" role="list" aria-label="Niveaux fondateurs : confiance fédérée, politiques et identités">
    {
      lowerLayers.map((layer) => (
        <article class="usm__row" role="listitem">
          <div class="usm__meta">
            <div class="usm__code-line">
              <span class="usm__lvl">Niveau {layer.number}</span>
            </div>
            <div class="usm__tags">
              <StageTag stage={layer.stage} />
              <LevelTag level={layer.level} />
            </div>
          </div>

          <div class="usm__main">
            <div class="usm__head">
              <h3 class="usm__title">{layer.name}</h3>
              <p class="usm__sub">{layer.subtitle}</p>
            </div>
            <p class="usm__summary">{layer.summary}</p>

            <ul class="usm__scopes" aria-label={`Périmètres couverts par ${layer.name}`}>
              {layer.scopes.map((scope) => (
                <li>{scope}</li>
              ))}
            </ul>
          </div>

          <div class="usm__spec">
            <ul class="usm__caps">
              {(compact ? layer.capabilities.slice(0, 3) : layer.capabilities).map((cap) => (
                <li>
                  <Icon name="check" size={14} stroke={2} />
                  <span>{cap}</span>
                </li>
              ))}
            </ul>
            <div class="usm__action">
              <a class="link" href={layerHref(layer)}>
                <span>{layer.ctaLabel ?? 'Voir la fiche technique'}</span>
                <Icon name="arrow-right" size={15} stroke={1.8} />
              </a>
            </div>
          </div>
        </article>
      ))
    }
  </div>

  <div class="usm__pillars" aria-label="Piliers stratégiques de la plateforme LUXIA">
    {
      strategicPillars.map((pillar) => (
        <div class="usm__pillar">
          <h3 class="usm__pillar-title">
            {pillar.leftTitle}
            <span class="usm__pillar-sep">·</span>
            {pillar.rightTitle}
          </h3>
          <p class="usm__pillar-text">{pillar.detail}</p>
        </div>
      ))
    }
  </div>
</div>

<style>
  .usm {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line);
  }

  .usm__tier {
    display: flex;
    flex-direction: column;
  }

  .usm__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px var(--gap);
    padding-block: clamp(22px, 3vw, 32px);
    border-bottom: 1px solid var(--line);
  }

  .usm__meta {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .usm__code-line {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-family: var(--mono);
    font-size: var(--fs-meta);
    letter-spacing: 0.06em;
  }

  .usm__lvl {
    color: var(--link);
    font-weight: 500;
  }

  .usm__code {
    color: var(--ink-3);
  }

  .usm__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .usm__main {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .usm__head {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .usm__title {
    font-family: var(--display);
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  .usm__sub {
    font-size: var(--fs-small);
    color: var(--ink-3);
  }

  .usm__summary {
    max-width: 48rem;
    font-size: var(--fs-small);
    line-height: 1.55;
    color: var(--ink-2);
  }

  .usm__human-brief {
    padding-block: clamp(22px, 3vw, 34px);
    border-bottom: 1px solid var(--line);
  }

  .usm__human-guard {
    padding-block: clamp(26px, 3.6vw, 42px);
    border-bottom: 1px solid var(--line);
  }

  .usm__flow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
    margin-top: 6px;
    padding-block: 10px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .usm__step {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--mono);
    font-size: 0.78125rem;
    color: var(--ink-2);
  }

  .usm__step :global(svg) {
    color: var(--ink-3);
  }

  .usm__step--done {
    color: var(--link);
    font-weight: 600;
  }

  .usm__scopes {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 0;
    margin-top: 4px;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--ink-3);
  }

  .usm__scopes li + li::before {
    content: ' · ';
    margin-inline: 8px;
    color: var(--line-strong);
  }

  .usm__spec {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
  }

  .usm__caps {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .usm__caps li {
    display: grid;
    grid-template-columns: 16px minmax(0, 1fr);
    align-items: start;
    gap: 8px;
    font-size: var(--fs-small);
    line-height: 1.45;
    color: var(--ink-2);
  }

  .usm__caps :global(svg) {
    margin-top: 3px;
    color: var(--link);
  }

  .usm__action {
    padding-top: 8px;
  }

  /* Colonne vertébrale : Plateforme unifiée LUXIA */
  .usm__spine {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: clamp(20px, 2.8vw, 28px);
    border-block: 1px solid var(--line-strong);
    background-color: var(--blue-tint);
  }

  .usm__spine-brand {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .usm__prism {
    flex-shrink: 0;
    color: var(--link);
  }

  .usm__spine-title {
    font-family: var(--display);
    font-size: var(--fs-h4);
    font-weight: 600;
    color: var(--ink);
  }

  .usm__spine-domains {
    font-family: var(--mono);
    font-size: var(--fs-meta);
    letter-spacing: 0.04em;
    color: var(--link);
  }

  .usm__spine-copy {
    max-width: 44rem;
    font-size: var(--fs-small);
    color: var(--ink);
  }

  /* Trois piliers de socle */
  .usm__pillars {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0 var(--gap);
    border-top: 1px solid var(--line);
  }

  .usm__pillar {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-block: clamp(20px, 2.5vw, 28px);
    border-bottom: 1px solid var(--line);
  }

  .usm__pillar:last-child {
    border-bottom: 0;
  }

  .usm__pillar-title {
    font-family: var(--display);
    font-size: var(--fs-h4);
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink);
  }

  .usm__pillar-sep {
    margin-inline: 6px;
    color: var(--ink-3);
    font-weight: 400;
  }

  .usm__pillar-text {
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--ink-2);
  }

  @media (min-width: 960px) {
    .usm__row {
      grid-template-columns: 10rem minmax(0, 1.35fr) minmax(0, 1fr);
      align-items: start;
    }

    .usm__spine {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--gap);
    }

    .usm__pillars {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      border-bottom: 1px solid var(--line);
    }

    .usm__pillar {
      border-bottom: 0;
    }
  }
</style>
