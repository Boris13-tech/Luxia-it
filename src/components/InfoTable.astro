---
import Tbd from './Tbd.astro';

/** Tableau clé / valeur dans une carte (statut, référentiels, repères). */
interface Row {
  key: string;
  value?: string | undefined;
  tbd?: string | undefined;
  live?: boolean | undefined;
}

interface Props {
  rows: readonly Row[];
  label?: string | undefined;
}

const { rows, label } = Astro.props;
---

<dl class="itable" aria-label={label} data-reveal>
  {
    rows.map((r) => (
      <div class="itable__row">
        <dt>{r.key}</dt>
        <dd class:list={[r.live && 'is-live']}>
          {r.live && <span class="itable__dot" aria-hidden="true" />}
          {r.value} {r.tbd && <Tbd text={r.tbd} />}
        </dd>
      </div>
    ))
  }
</dl>

<style>
  .itable {
    background-color: var(--white);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .itable__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 4px var(--gap);
    padding: 18px 24px;
    border-bottom: 1px solid var(--gray-200);
    color: var(--slate);
  }

  .itable__row:last-child {
    border-bottom: 0;
  }

  .itable__row dt {
    font-weight: 500;
    color: var(--slate-darker);
  }

  .itable__row dd {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 10px;
  }

  .itable__row dd.is-live {
    color: #15703f;
    font-weight: 500;
  }

  .itable__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background-color: var(--live);
    box-shadow: 0 0 0 3px rgb(30 158 90 / 0.25);
  }

  @media (min-width: 720px) {
    .itable__row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    }
  }
</style>
