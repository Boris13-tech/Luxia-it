---
/** Bandeau d'ouverture des pages intérieures, avec fil d'Ariane. */
import HeroArt from './HeroArt.astro';

interface Crumb {
  label: string;
  href?: string | undefined;
}

interface Props {
  title: string;
  /** Partie du titre mise en valeur (orange), affichée après `title`. */
  hl?: string | undefined;
  after?: string | undefined;
  kicker?: string | undefined;
  lead?: string | undefined;
  crumbs?: readonly Crumb[] | undefined;
  image?: string | undefined;
}

const { title, hl, after, kicker, lead, crumbs = [], image } = Astro.props;
---

<section class="banner on-dark" aria-labelledby="page-title">
  <HeroArt image={image} compact />
  <div class="container banner__inner">
    {
      crumbs.length > 0 && (
        <nav class="crumbs" aria-label="Fil d'Ariane">
          <ol>
            <li>
              <a href="/">Accueil</a>
            </li>
            {crumbs.map((c) => (
              <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
            ))}
          </ol>
        </nav>
      )
    }
    {
      (kicker || Astro.slots.has('meta')) && (
        <div class="banner__meta">
          {kicker && <p class="banner__pre">{kicker}</p>}
          <slot name="meta" />
        </div>
      )
    }
    <h1 id="page-title" class="banner__title">
      {title}
      {hl && <span class="hl">{hl}</span>}
      {after}
    </h1>
    {lead && <p class="banner__lead">{lead}</p>}
    {
      Astro.slots.has('actions') && (
        <div class="banner__actions">
          <slot name="actions" />
        </div>
      )
    }
  </div>
  <svg class="banner__curve" viewBox="0 0 1440 70" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path d="M0 70 L0 40 Q720 -24 1440 40 L1440 70 Z"></path>
  </svg>
</section>

<style>
  .banner {
    position: relative;
    overflow: hidden;
    text-align: center;
    color: var(--gray-100);
  }

  .banner__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    padding-block: calc(var(--header-h) + clamp(48px, 7vw, 88px)) clamp(88px, 10vw, 128px);
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 0;
    font-size: var(--fs-small);
    color: var(--gray-200);
  }

  .crumbs li + li::before {
    content: '›';
    margin-inline: 10px;
    color: var(--brand-light);
  }

  .crumbs a:hover {
    color: var(--brand-light);
  }

  .banner__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 10px 18px;
  }

  .banner__pre {
    font-size: clamp(1rem, 0.9rem + 0.5vw, 1.375rem);
    font-weight: 300;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .banner__title {
    max-width: 20em;
    font-size: clamp(2rem, 1.2rem + 3vw, 3.3rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--gray-100);
  }

  .banner__lead {
    max-width: 44rem;
    font-size: clamp(1.0625rem, 0.95rem + 0.45vw, 1.3rem);
    font-weight: 300;
    color: var(--white);
  }

  .banner__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    padding-top: 8px;
  }

  .banner__curve {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    width: 100%;
    height: clamp(32px, 5vw, 70px);
    fill: var(--white);
  }
</style>
