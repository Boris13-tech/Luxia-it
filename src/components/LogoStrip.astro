---
/**
 * Bandeau « Ils nous font confiance ». Tant que les logos ne sont pas
 * fournis (avec l'accord écrit des clients), des emplacements s'affichent.
 */
import Tbd from './Tbd.astro';

interface Props {
  count?: number | undefined;
}

const { count = 5 } = Astro.props;
---

<section class="logos" aria-labelledby="logos-title">
  <div class="container">
    <h2 class="logos__title t-h3" id="logos-title" data-reveal>Ils nous font confiance</h2>
    <ul class="logos__list" data-reveal>
      {
        Array.from({ length: count }, () => (
          <li class="logos__item">
            <Tbd text="À FOURNIR : logo client" />
          </li>
        ))
      }
    </ul>
    <p class="logos__note t-small">Logos affichés uniquement avec l’accord écrit des organisations concernées.</p>
  </div>
</section>

<style>
  .logos {
    padding-block: clamp(48px, 6vw, 72px);
  }

  .logos__title {
    text-align: center;
    margin-bottom: 36px;
  }

  .logos__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .logos__item {
    display: grid;
    place-items: center;
    min-height: 96px;
    padding: 12px;
    border-radius: var(--radius-sm);
    background-color: var(--gray-50);
    border: 1px solid var(--gray-200);
    text-align: center;
    font-size: 0.8125rem;
  }

  .logos__note {
    margin-top: 18px;
    text-align: center;
  }

  @media (min-width: 720px) {
    .logos__list {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
</style>
