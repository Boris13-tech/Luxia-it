---
/**
 * Niveau de preuve d'une affirmation. Le sens est porté par le texte ; la
 * forme du repère (plein, bordé, gris, contour, pointillé) le double, sans
 * dépendre de la couleur seule (critère 1.4.1).
 */
import { levels, type Level } from '../data/evidence';

interface Props {
  level: Level;
}

const { level } = Astro.props;
---

<span class:list={['lvl', `lvl--${level}`]}>
  <span class="lvl__mark" aria-hidden="true"></span>
  <span class="visually-hidden">Niveau de preuve :</span>
  {levels[level].label}
</span>

<style>
  /* Contrastes texte/fond : 5,8 à 6,7:1 (vérifiés) */
  .lvl {
    display: inline-flex;
    /* Taille du contenu, même dans un conteneur flex étiré */
    width: fit-content;
    align-self: flex-start;
    align-items: center;
    gap: 7px;
    padding: 4px 11px 4px 9px;
    border-radius: 999px;
    font-family: var(--font);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.3;
    color: #4a4f5c;
    background-color: #e6e8ee;
  }

  .lvl__mark {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: currentColor;
  }

  .lvl--production {
    color: #2f5e3d;
    background-color: var(--sage-tint);
  }

  .lvl--ci {
    color: #1a4f9c;
    background-color: var(--blue-tint);
  }

  .lvl--designed {
    color: #7a4f05;
    background-color: var(--ochre-tint);
  }

  .lvl--target {
    color: #5a554f;
    background-color: #efe9df;
  }

  .lvl--target .lvl__mark {
    background-color: transparent;
    border: 1.5px dashed currentColor;
  }
</style>
