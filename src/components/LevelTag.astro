---
/**
 * Niveau de preuve d'une affirmation. Le sens est porté par le texte ; la
 * forme du repère (plein, bordé, gris, contour, pointillé) le double, sans
 * dépendre de la couleur seule (critère 1.4.1).
 */
import { levels, type Level } from '../data/evidence';

interface Props {
  level: Level;
}

const { level } = Astro.props;
---

<span class:list={['lvl', `lvl--${level}`]}>
  <span class="lvl__mark" aria-hidden="true"></span>
  <span class="visually-hidden">Niveau de preuve :</span>
  {levels[level].label}
</span>

<style>
  .lvl {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1.3;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .lvl__mark {
    flex: none;
    width: 10px;
    height: 10px;
    border: 1.5px solid var(--ink-3);
  }

  .lvl--production {
    color: var(--ink);
  }

  .lvl--production .lvl__mark {
    background-color: var(--blue);
    border-color: var(--blue);
  }

  .lvl--ci {
    color: var(--ink);
  }

  .lvl--ci .lvl__mark {
    background-color: var(--blue);
    border-color: var(--blue);
    box-shadow: inset 0 0 0 2px var(--white);
  }

  .lvl--implemented .lvl__mark {
    background-color: var(--ink-3);
  }

  .lvl--target .lvl__mark {
    border-style: dashed;
  }
</style>
