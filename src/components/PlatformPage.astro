---
/**
 * Gabarit des pages plateformes. Les sections se construisent à partir de
 * src/data/platforms.ts ; une section sans contenu ne s'affiche pas.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from './PageHead.astro';
import SectionHead from './SectionHead.astro';
import ClaimList from './ClaimList.astro';
import ArchDiagram from './ArchDiagram.astro';
import DataTable from './DataTable.astro';
import EvidenceScale from './EvidenceScale.astro';
import LevelTag from './LevelTag.astro';
import StageTag from './StageTag.astro';
import CtaBlock from './CtaBlock.astro';
import Tabs from './Tabs.astro';
import Icon from './Icon.astro';
import { facts, formatDate } from '../data/facts';
import { getPlatform, type Platform } from '../data/platforms';
import { href } from '../i18n/routes';

interface Props {
  slug: Platform['slug'];
}

const p = getPlatform(Astro.props.slug);
const contact = `${href('contact')}?sujet=${p.slug}`;
// Sécurité, exploitation et déploiement : regroupés en onglets quand il y en a plusieurs.
const groups = [
  { id: 'securite', label: 'Sécurité', title: 'Mesures de sécurité', lead: undefined, claims: p.security },
  { id: 'exploitation', label: 'Exploitation', title: 'Comment elle est exploitée', lead: undefined, claims: p.operations },
  {
    id: 'deploiement',
    label: 'Déploiement',
    title: 'Où elle peut fonctionner',
    lead: 'Un seul modèle est en service aujourd’hui. Les autres sont des principes d’architecture, sans déploiement à ce jour.',
    claims: p.deployment,
  },
].filter((g) => g.claims.length > 0);
// Au-delà, les éléments d'une liste sont repliés (divulgation progressive).
const VISIBLE = 4;

const sections = [
  { id: 'probleme', show: true },
  { id: 'architecture', show: true },
  { id: 'capacites', show: p.capabilities.length > 0 },
  { id: 'ensuite', show: p.next.length > 0 },
  { id: 'integrations', show: p.integrations.length > 0 },
  { id: 'confiance', show: p.security.length + p.operations.length + p.deployment.length > 0 },
  { id: 'limites', show: p.limits.length > 0 },
].filter((s) => s.show);
const n = (id: string) => String(sections.findIndex((s) => s.id === id) + 1).padStart(2, '0');
const alt = (id: string) => sections.findIndex((s) => s.id === id) % 2 === 1;
---

<BaseLayout title={p.name} description={p.description} crumbs={[{ label: 'Plateformes', href: href('platforms') }, { label: p.name }]}>
  <PageHead kicker={p.role} title={p.name} lead={p.lead} crumbs={[{ label: 'Plateformes', href: href('platforms') }, { label: p.name }]}>
    <dl class="pstate">
      <div>
        <dt class="kicker">Étape</dt>
        <dd><StageTag stage={p.stage} /></dd>
      </div>
      <div>
        <dt class="kicker">État</dt>
        <dd>{p.stageNote}</dd>
      </div>
      <div>
        <dt class="kicker">Preuves lues le</dt>
        <dd><time datetime={facts.evidenceAsOf}>{formatDate(facts.evidenceAsOf)}</time></dd>
      </div>
    </dl>
    <Fragment slot="actions">
      <a class="btn btn--primary" href={contact}>Demander une présentation</a>
      <a class="more" href="#echelle">Lire les niveaux de preuve <Icon name="arrow-down" size={16} /></a>
    </Fragment>
  </PageHead>

  <section class:list={['section', alt('probleme') && 'section--alt']} id="probleme" aria-labelledby="probleme-title">
    <div class="wrap">
      <SectionHead id="probleme-title" index={n('probleme')} kicker="Le problème" title="Ce que la plateforme résout" lead={p.problem.intro} />
      <ul class="ruled ruled--3">
        {
          p.problem.points.map((pt) => (
            <li>
              <h3 class="ruled__title">{pt.title}</h3>
              <p class="ruled__text">{pt.text}</p>
            </li>
          ))
        }
      </ul>
      {
        p.principle && (
          <figure class="principle">
            <LevelTag level={p.principle.level} />
            <p class="principle__title">{p.principle.title}</p>
            <p class="principle__text">{p.principle.text}</p>
          </figure>
        )
      }
    </div>
  </section>

  <section class:list={['section', alt('architecture') && 'section--alt']} id="architecture" aria-labelledby="architecture-title">
    <div class="wrap">
      <SectionHead id="architecture-title" index={n('architecture')} kicker="Architecture" title="Comment elle est construite" />
      <ArchDiagram title={`Architecture de ${p.name}`} {...p.diagram} />
    </div>
  </section>

  {
    p.capabilities.length > 0 && (
      <section class:list={['section', alt('capacites') && 'section--alt']} id="capacites" aria-labelledby="capacites-title">
        <div class="wrap">
          <SectionHead
            id="capacites-title"
            index={n('capacites')}
            kicker="Capacités"
            title="Ce qui fonctionne aujourd’hui"
            lead="Chaque capacité indique son niveau de preuve. Aucune n’est présentée au-delà de ce qui a été démontré."
          />
          <ClaimList claims={p.capabilities.slice(0, VISIBLE)} columns={2} />
          {
            p.capabilities.length > VISIBLE && (
              <details class="disclosure more-claims">
                <summary>
                  Voir {p.capabilities.length - VISIBLE === 1 ? 'l’autre' : `les ${p.capabilities.length - VISIBLE} autres`} capacités
                </summary>
                <div class="disclosure__body">
                  <ClaimList claims={p.capabilities.slice(VISIBLE)} columns={2} />
                </div>
              </details>
            )
          }
        </div>
      </section>
    )
  }

  {
    p.next.length > 0 && (
      <section class:list={['section', alt('ensuite') && 'section--alt']} id="ensuite" aria-labelledby="ensuite-title">
        <div class="wrap">
          <SectionHead
            id="ensuite-title"
            index={n('ensuite')}
            kicker="Feuille de route"
            title="Ce qui n’est pas encore disponible"
            lead="Conçu ou visé, mais pas en service. Le niveau indique jusqu’où chaque élément est allé."
          />
          <ClaimList claims={p.next.slice(0, VISIBLE)} columns={2} />
          {
            p.next.length > VISIBLE && (
              <details class="disclosure more-claims">
                <summary>
                  Voir {p.next.length - VISIBLE === 1 ? 'l’autre' : `les ${p.next.length - VISIBLE} autres`} éléments
                </summary>
                <div class="disclosure__body">
                  <ClaimList claims={p.next.slice(VISIBLE)} columns={2} />
                </div>
              </details>
            )
          }
        </div>
      </section>
    )
  }

  {
    p.integrations.length > 0 && (
      <section class:list={['section', alt('integrations') && 'section--alt']} id="integrations" aria-labelledby="integrations-title">
        <div class="wrap">
          <SectionHead id="integrations-title" index={n('integrations')} kicker="Intégrations" title="Avec quoi elle se connecte" />
          <DataTable
            caption={`Intégrations de ${p.name} et niveau de preuve`}
            columns={[
              { key: 'name', label: 'Intégration' },
              { key: 'level', label: 'Niveau' },
              { key: 'note', label: 'Précision' },
            ]}
            rows={p.integrations.map((i) => ({ name: i.name, level: { text: '', level: i.level }, note: i.note }))}
          />
        </div>
      </section>
    )
  }

  {
    groups.length > 0 && (
      <section class:list={['section', alt('confiance') && 'section--alt']} id="confiance" aria-labelledby="confiance-title">
        <div class="wrap">
          <SectionHead
            id="confiance-title"
            index={n('confiance')}
            kicker="Sécurité et exploitation"
            title={groups.length > 1 ? 'Comment elle est protégée, exploitée et déployée' : groups[0]?.title ?? ''}
          />
          {groups.length > 1 ? (
            <Tabs label="Sécurité, exploitation et déploiement" items={groups.map((g) => ({ id: g.id, label: g.label }))}>
              {groups.map((g) => (
                <section class="tabs__panel" id={g.id}>
                  <h3 class="tabs__panel-title t-h3">{g.title}</h3>
                  {g.lead && <p class="group-lead">{g.lead}</p>}
                  <ClaimList claims={g.claims} columns={g.id === 'deploiement' ? 3 : 2} as="h4" />
                  {g.id === 'deploiement' && (
                    <p class="group-after">
                      <a class="more" href={href('architectures')}>
                        Comparer les modèles de déploiement <Icon name="arrow-right" size={16} />
                      </a>
                    </p>
                  )}
                </section>
              ))}
            </Tabs>
          ) : (
            groups.map((g) => <ClaimList claims={g.claims} columns={2} />)
          )}
        </div>
      </section>
    )
  }

  {
    p.limits.length > 0 && (
      <section class:list={['section', alt('limites') && 'section--alt']} id="limites" aria-labelledby="limites-title">
        <div class="wrap">
          <SectionHead id="limites-title" index={n('limites')} kicker="Limites" title="Ce que la plateforme ne fait pas aujourd’hui">
            <ul class="limits">
              {p.limits.map((l) => (
                <li>{l}</li>
              ))}
            </ul>
          </SectionHead>
        </div>
      </section>
    )
  }

  <section class="section section--alt" id="echelle" aria-labelledby="echelle-title">
    <div class="wrap">
      <SectionHead id="echelle-title" kicker="Lecture" title="Comment lire les niveaux de preuve" />
      <details class="disclosure">
        <summary>Les cinq niveaux de preuve et les cinq étapes</summary>
        <div class="disclosure__body">
          <EvidenceScale />
        </div>
      </details>
    </div>
  </section>

  <CtaBlock
    title={`Voir ${p.name} sur votre cas`}
    text="Nous présentons l’état réel de la plateforme, ses limites et ce qu’un premier échange de cadrage permettrait d’établir."
    href={contact}
    label="Demander une présentation"
    secondary={{ href: href('platforms'), label: 'Toutes les plateformes' }}
  />
</BaseLayout>

<style>
  .pstate {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-top: 1px solid var(--line);
  }

  .pstate > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 4px 24px;
    padding-block: 12px;
    border-bottom: 1px solid var(--line);
  }

  .pstate dd {
    color: var(--ink);
  }

  @media (min-width: 720px) {
    .pstate > div {
      grid-template-columns: 11rem minmax(0, 1fr);
      align-items: baseline;
    }
  }

  .principle {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: clamp(40px, 5vw, 64px);
    padding: clamp(24px, 3vw, 40px);
    background-color: var(--white);
    border-left: 3px solid var(--blue);
  }

  .principle__title {
    font-size: var(--fs-h3);
    font-weight: 500;
    line-height: 1.25;
    color: var(--ink);
  }

  .principle__text {
    max-width: 50rem;
  }

  .group-lead {
    max-width: 46rem;
    margin-bottom: 8px;
    color: var(--ink-2);
  }

  .group-after {
    margin-top: 24px;
  }

  .more-claims {
    margin-top: 8px;
  }

  .limits {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line);
  }

  .limits li {
    padding-block: 14px;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
  }
</style>
