---
/**
 * Logo Luxia-IT : emblème « A » (jambe bleu foncé, jambe bleu clair),
 * redessiné en vecteur à partir du fichier fourni
 * (public/brand/luxia-it-logo-original.png), suivi du nom et de la signature.
 *
 * L'emblème est décoratif : le nom accessible du lien qui entoure le logo
 * est son texte visible (« LUXIA-IT Identité & confiance »), critère 2.5.3.
 * Variante « reverse » pour les fonds sombres.
 */
interface Props {
  tone?: 'color' | 'reverse' | undefined;
}

const { tone = 'color' } = Astro.props;
---

<span class:list={['logo', `logo--${tone}`]}>
  <svg class="logo__mark" viewBox="6.5 1 39 35" width="36" height="32" aria-hidden="true" focusable="false">
    <polygon class="logo__light" points="23.6,8.4 32.2,8.4 44,34.6 34.6,34.6"></polygon>
    <polygon class="logo__dark" points="22,2 32.2,2 18.2,34.6 8,34.6"></polygon>
  </svg>
  <span class="logo__text">
    <span class="logo__name">LUXIA-IT</span>
    <span class="logo__tagline">Identité &amp; confiance</span>
  </span>
</span>

<style>
  .logo {
    --logo-dark: #1f5fbf;
    --logo-light: #8db3e8;
    --logo-name: var(--ink);
    --logo-tagline: var(--blue);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    line-height: 1;
  }

  .logo__mark {
    width: 36px;
    height: 32px;
  }

  .logo__dark,
  .logo__light {
    stroke-width: 1;
    stroke-linejoin: round;
  }

  .logo__dark {
    fill: var(--logo-dark);
    stroke: var(--logo-dark);
  }

  .logo__light {
    fill: var(--logo-light);
    stroke: var(--logo-light);
  }

  .logo__text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .logo__name {
    font-size: 1.1875rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--logo-name);
  }

  .logo__tagline {
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--logo-tagline);
  }

  /* Fond sombre : emblème blanc et bleu clair (contrastes 15,7:1 et 8,7:1) */
  .logo--reverse {
    --logo-dark: #ffffff;
    --logo-light: #8db3e8;
    --logo-name: var(--on-dark);
    --logo-tagline: var(--blue-light);
  }
</style>
