---
/**
 * Pictogrammes dessinés pour Luxia-IT : un fond organique teinté et un trait
 * arrondi à l'encre. Décoratifs (aria-hidden) : le texte voisin porte le sens.
 * Le trait se dessine quand le pictogramme entre dans l'écran
 * (src/styles/motion.css), sauf mouvement réduit.
 */
export type PictogramName =
  | 'person'
  | 'shield'
  | 'compass'
  | 'clipboard'
  | 'key'
  | 'conversation'
  | 'door'
  | 'journal'
  | 'cloud'
  | 'loop'
  | 'screen';

interface Props {
  name: PictogramName;
  tone?: 'blue' | 'terra' | 'ochre' | 'sage' | undefined;
  size?: number | undefined;
}

const { name, tone = 'blue', size = 64 } = Astro.props;

const strokes: Record<PictogramName, readonly string[]> = {
  person: ['M12 11.2a3.4 3.4 0 1 0 0-6.8 3.4 3.4 0 0 0 0 6.8z', 'M5.4 20c.9-3.6 3.6-5.4 6.6-5.4s5.7 1.8 6.6 5.4', 'M16.6 9.6l1.5 1.5 2.9-3.1'],
  shield: ['M12 3.2l7 2.9v5.2c0 4.5-2.9 7.9-7 9.6-4.1-1.7-7-5.1-7-9.6V6.1z', 'M8.6 12.1l2.4 2.4 4.4-4.8'],
  compass: ['M12 4.5l6.8 15', 'M12 4.5L5.2 19.5', 'M7.6 14.3h8.8', 'M12 4.5a1.4 1.4 0 1 0 0-.01'],
  clipboard: ['M7 5h10.2v15.6H7z', 'M9.6 3.6h5v2.8h-5z', 'M9.6 13l2 2 3.6-4'],
  key: ['M8.3 18.4a4 4 0 1 0 0-8 4 4 0 0 0 0 8z', 'M11.2 11.5l7.6-7.6', 'M15.8 6.9l2 2', 'M13.7 9l1.6 1.6'],
  conversation: ['M4.5 5.5h15v9.6h-8.4l-4 3.6v-3.6H4.5z', 'M8.2 9.3h7.6', 'M8.2 12h4.6'],
  door: ['M7 3.6h10.2v17H7z', 'M14.2 12.4h.01', 'M4.6 20.6h14.8'],
  journal: ['M6.4 4h11.2v16.4H6.4z', 'M9.2 8.2h5.6', 'M9.2 11.2h5.6', 'M9.2 14.2h3.4'],
  cloud: ['M7.4 18.2a3.9 3.9 0 0 1-.4-7.8 5.3 5.3 0 0 1 10.2-.9 3.8 3.8 0 0 1 .1 8.7z', 'M12 12.2v4', 'M10.2 14.2l1.8-2 1.8 2'],
  loop: ['M5 12a7 7 0 0 1 12.2-4.6', 'M19 12a7 7 0 0 1-12.2 4.6', 'M17.6 4.2v3.4h-3.4', 'M6.4 19.8v-3.4h3.4'],
  screen: ['M4 5.2h16v10.6H4z', 'M9 19.6h6', 'M12 15.8v3.8', 'M12 12.6a2.1 2.1 0 1 0 0-4.2 2.1 2.1 0 0 0 0 4.2z'],
};

// Fonds légèrement différents d'un pictogramme à l'autre : un aspect fait main.
const blobs = [
  'M12.4 1.6c5.4.2 10 4.2 9.9 10.1-.1 6.2-4.8 10.9-10.8 10.7C5.6 22.2 1.6 17.6 1.7 11.8 1.8 5.9 6.6 1.4 12.4 1.6z',
  'M11.6 1.8c6 .1 10.6 4.6 10.4 10.6-.2 5.6-4.9 9.9-10.6 9.8C5.7 22 1.7 17.2 1.8 11.6 2 6.2 6.1 1.7 11.6 1.8z',
  'M12.1 2.1c5.7-.3 9.9 4 10 9.6.1 6-4.3 10.6-10.2 10.6C6.2 22.3 1.7 17.9 1.9 12 2 6.6 6.6 2.4 12.1 2.1z',
];
const blob = blobs[name.length % blobs.length];
---

<svg class:list={['picto', `picto--${tone}`]} viewBox="0 0 24 24" width={size} height={size} aria-hidden="true" focusable="false">
  <path class="picto__blob" d={blob} />
  <g class="picto__ink">
    {strokes[name].map((d) => <path d={d} pathLength="1" />)}
  </g>
</svg>

<style>
  .picto {
    flex: none;
    overflow: visible;
  }

  .picto__blob {
    fill: var(--picto-tint);
    transform-origin: center;
  }

  .picto__ink path {
    fill: none;
    stroke: var(--picto-ink);
    stroke-width: 1.35;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Fond sombre teinté, trait lumineux de la même famille */
  .picto--blue {
    --picto-tint: #13234a;
    --picto-ink: #8cb8ff;
  }

  .picto--terra {
    --picto-tint: #2c1612;
    --picto-ink: #ff9c88;
  }

  .picto--ochre {
    --picto-tint: #2a2110;
    --picto-ink: #f0c070;
  }

  .picto--sage {
    --picto-tint: #0f2a1f;
    --picto-ink: #7fd3a8;
  }
</style>
