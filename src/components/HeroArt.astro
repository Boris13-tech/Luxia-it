---
/**
 * Fond des bandeaux d'ouverture : photo (si fournie) sous un voile marine,
 * bandes diagonales aux deux bleus du logo, emblème « A » en filigrane
 * et réseau de points.
 * Sans photo, l'illustration seule sert de fond.
 */
interface Props {
  /** Chemin d'une photo dans public/media/, ex. /media/hero.webp */
  image?: string | undefined;
  compact?: boolean | undefined;
}

const { image, compact = false } = Astro.props;

// Réseau de points déterministe (mêmes positions à chaque build).
let seed = 7;
const rand = () => {
  seed = (seed * 9301 + 49297) % 233280;
  return seed / 233280;
};
const nodes = Array.from({ length: 26 }, (_, i) => ({
  x: (i / 25) * 1440 + (rand() - 0.5) * 60,
  y: 600 + rand() * 180,
  r: 2 + rand() * 4,
  o: 0.25 + rand() * 0.45,
}));
const links = nodes.flatMap((n, i) =>
  nodes
    .slice(i + 1, i + 4)
    .filter((m) => Math.hypot(m.x - n.x, m.y - n.y) < 190)
    .map((m) => ({ x1: n.x, y1: n.y, x2: m.x, y2: m.y })),
);

// Emblème du logo (mêmes points que Logo.astro), agrandi en filigrane à droite.
const emblemDark = '22,2 32.2,2 18.2,34.6 8,34.6';
const emblemLight = '23.6,8.4 32.2,8.4 44,34.6 34.6,34.6';
---

<div class:list={['art', compact && 'art--compact']} aria-hidden="true">
  {image && <img class="art__photo" src={image} alt="" decoding="async" fetchpriority="high" />}
  <div class="art__veil"></div>
  <!-- Bandes aux deux bleus du logo, calées sur la marge du contenu :
       le logo de l'en-tête repose toujours sur la bande foncée. -->
  <div class="art__band"></div>
  <div class="art__band2"></div>
  <svg class="art__svg" viewBox="0 0 1440 800" preserveAspectRatio="xMidYMid slice" focusable="false">
    <g class="art__emblem" transform="translate(860 30) scale(21)">
      <polygon class="art__emblem-light" points={emblemLight}></polygon>
      <polygon class="art__emblem-dark" points={emblemDark}></polygon>
    </g>
    <g class="art__net">
      {links.map((l) => <line x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} />)}
      {nodes.map((n) => <circle cx={n.x} cy={n.y} r={n.r} opacity={n.o.toFixed(2)} />)}
    </g>
  </svg>
</div>

<style>
  .art {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background-color: var(--navy);
    background-image: linear-gradient(135deg, #0b1d3a 0%, var(--navy-2) 55%, var(--navy-3) 100%);
  }

  .art__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .art__veil {
    position: absolute;
    inset: 0;
    background-color: rgb(15 37 71 / 0.8);
  }

  .art__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .art__emblem-dark {
    fill: rgb(141 179 232 / 0.09);
  }

  .art__emblem-light {
    fill: rgb(141 179 232 / 0.05);
  }

  .art {
    /* Bord gauche du contenu (même calcul que .container) */
    --edge: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
  }

  .art__band,
  .art__band2 {
    position: absolute;
    top: -2px;
    bottom: -2px;
    transform: skewX(-12deg);
    transform-origin: top left;
  }

  .art__band {
    left: -60px;
    width: calc(var(--edge) + 300px);
    background-color: var(--brand);
    opacity: 0.92;
  }

  /* Seconde bande : le bleu clair du logo, juste à droite de celui-ci */
  .art__band2 {
    left: calc(var(--edge) + 258px);
    width: 16px;
    background-color: var(--brand-light);
    opacity: 0.9;
  }

  .art__net line {
    stroke: rgb(255 255 255 / 0.18);
    stroke-width: 1;
  }

  .art__net circle {
    fill: var(--white);
  }

  /* Bandeaux des pages intérieures (plus bas) : décor plus discret */
  .art--compact .art__net {
    opacity: 0.7;
  }

  .art--compact .art__emblem {
    opacity: 0.8;
  }

  /* Sur mobile, une bande plus étroite, sans la seconde */
  @media (max-width: 899.98px) {
    .art__band {
      left: -64px;
      width: 104px;
      transform: skewX(-10deg);
      transform-origin: center;
    }

    .art__band2 {
      display: none;
    }
  }
</style>
