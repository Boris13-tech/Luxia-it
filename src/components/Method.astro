---
/** Étapes numérotées d'une méthode, sur filets. */
interface Props {
  steps: readonly { title: string; text: string }[];
}

const { steps } = Astro.props;
---

<ol class:list={['method', steps.length > 4 ? 'method--5' : 'method--4']}>
  {
    steps.map((s) => (
      <li class="method__step">
        <span class="method__dot" aria-hidden="true" />
        <h3 class="method__title">{s.title}</h3>
        <p class="method__text">{s.text}</p>
      </li>
    ))
  }
</ol>

<style>
  .method {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0 var(--gap);
    counter-reset: step;
  }

  .method__step {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-block: 24px 28px;
    border-top: 1px solid var(--line);
  }

  .method__dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background-color: var(--blue);
    box-shadow: 0 0 0 5px var(--blue-tint);
  }

  .method__step:nth-child(3n + 2) .method__dot {
    background-color: var(--terra);
    box-shadow: 0 0 0 5px var(--terra-tint);
  }

  .method__step:nth-child(3n) .method__dot {
    background-color: var(--sage);
    box-shadow: 0 0 0 5px var(--sage-tint);
  }

  .method__title {
    font-size: var(--fs-h4);
    letter-spacing: 0;
  }

  .method__text {
    font-size: var(--fs-small);
    color: var(--ink-2);
  }

  @media (min-width: 720px) {
    .method {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .method--4 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .method--5 {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
</style>
