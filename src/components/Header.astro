---
/**
 * En-tête fixe, fond blanc cassé. Navigation plate (aucun menu au survol :
 * rien n'apparaît sans action explicite, critère 1.4.13). Sur mobile, un
 * bouton ouvre la navigation ; Échap la ferme et rend le focus au bouton.
 */
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { localeFromPath } from '../i18n/config';
import { href } from '../i18n/routes';
import { ui } from '../i18n/ui';

const path = Astro.url.pathname;
const locale = localeFromPath(path);
const t = ui[locale];
const home = href('home', locale);
const items = t.navItems.map((item) => ({ ...item, href: href(item.id, locale) }));
const isCurrent = (target: string) => target !== home && path.startsWith(target);
---

<header class="hdr" data-header>
  <div class="wrap hdr__bar">
    <a class="hdr__brand" href={home}>
      <Logo />
      <span class="visually-hidden">{t.homeSuffix}</span>
    </a>

    <nav class="hdr__nav" aria-label={t.nav}>
      <ul class="hdr__menu">
        {
          items.map((item) => (
            <li>
              <a class="hdr__link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hdr__end">
      <LanguageSwitcher />
      <a class="btn btn--primary btn--sm hdr__cta" href={`${href('contact', locale)}?sujet=cadrage`}>{t.cta}</a>
      <button class="hdr__burger" type="button" aria-expanded="false" aria-controls="menu-mobile" data-menu-trigger>
        <span class="visually-hidden" data-menu-label data-open-label={t.menuOpen} data-close-label={t.menuClose}>
          {t.menuOpen}
        </span>
        <span class="hdr__icon hdr__icon--open"><Icon name="menu" size={24} /></span>
        <span class="hdr__icon hdr__icon--close"><Icon name="x" size={24} /></span>
      </button>
    </div>
  </div>

  <div class="mnav" id="menu-mobile" data-menu>
    <nav class="wrap mnav__inner" aria-label={t.nav}>
      <ul>
        {
          items.map((item) => (
            <li>
              <a class="mnav__link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
                <Icon name="arrow-right" size={18} />
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn btn--primary mnav__cta" href={`${href('contact', locale)}?sujet=cadrage`}>{t.cta}</a>
    </nav>
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--paper);
    border-bottom: 1px solid var(--line);
  }

  .hdr__bar {
    display: flex;
    align-items: center;
    gap: 24px;
    height: var(--header-h);
  }

  .hdr__brand {
    flex: none;
    display: inline-flex;
    margin-right: auto;
  }

  .hdr__nav {
    display: none;
  }

  .hdr__menu {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .hdr__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink-2);
    transition: color var(--dur) var(--ease);
  }

  .hdr__link:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 6px;
  }

  .hdr__link[aria-current='page'] {
    color: var(--ink);
  }

  .hdr__link[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 4px;
    height: 2px;
    background-color: var(--blue);
  }

  .hdr__end {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .hdr__cta {
    display: none;
  }

  .hdr__burger {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    color: var(--ink);
  }

  .hdr__icon--close,
  .hdr__burger[aria-expanded='true'] .hdr__icon--open {
    display: none;
  }

  .hdr__burger[aria-expanded='true'] .hdr__icon--close {
    display: block;
  }

  /* Navigation mobile */
  .mnav {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    background-color: var(--paper);
    overflow-y: auto;
    overscroll-behavior: contain;
    visibility: hidden;
    opacity: 0;
    transition:
      opacity 160ms var(--ease),
      visibility 0s linear 160ms;
  }

  .mnav:global([data-open]) {
    visibility: visible;
    opacity: 1;
    transition: opacity 160ms var(--ease);
  }

  .mnav__inner {
    padding-block: 8px 40px;
  }

  .mnav__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 56px;
    border-bottom: 1px solid var(--line);
    font-size: 1.25rem;
    color: var(--ink);
  }

  .mnav__link[aria-current='page'] {
    color: var(--link);
  }

  .mnav__cta {
    width: 100%;
    margin-top: 28px;
  }

  @media (min-width: 1120px) {
    .hdr__nav {
      display: block;
    }

    .hdr__cta {
      display: inline-flex;
    }

    .hdr__burger,
    .mnav {
      display: none;
    }
  }
</style>

<script>
  import { initHeader } from '../scripts/header';
  initHeader();
</script>
