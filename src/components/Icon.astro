---
import { icons, type IconName } from '../data/icons';

interface Props {
  name: IconName;
  size?: number | undefined;
  stroke?: number | undefined;
  class?: string | undefined;
  /** Texte alternatif ; sans lui, l'icône est décorative. */
  label?: string | undefined;
}

const { name, size = 24, stroke = 1.5, class: className, label } = Astro.props;
const Svg = icons[name];
const a11y = label ? { 'aria-label': label, role: 'img' as const } : { 'aria-hidden': 'true' as const };
const extra = className ? { class: className } : {};
---

<Svg size={size} stroke-width={stroke} focusable="false" {...a11y} {...extra} />
