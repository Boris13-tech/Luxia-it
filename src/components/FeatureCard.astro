---
/** Carte blanche : icône, titre et texte centrés ; s'élève au survol. */
import Icon from './Icon.astro';
import Tbd from './Tbd.astro';
import type { IconName } from '../data/icons';

interface Props {
  icon?: IconName | undefined;
  title: string;
  text: string;
  tbd?: string | undefined;
  href?: string | undefined;
  align?: 'center' | 'left' | undefined;
  class?: string | undefined;
}

const { icon, title, text, tbd, href, align = 'center', class: className } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag class:list={['fcard', `fcard--${align}`, className]} href={href} data-reveal>
  {Astro.slots.has('media') && <div class="fcard__media"><slot name="media" /></div>}
  {icon && <span class="fcard__icon"><Icon name={icon} size={64} stroke={1.15} /></span>}
  <h3 class="fcard__title">{title}</h3>
  <p class="fcard__text">
    {text} {tbd && <Tbd text={tbd} />}
  </p>
  <slot />
  {href && <span class="fcard__more">En savoir plus <Icon name="chevron-right" size={16} stroke={2} /></span>}
</Tag>

<style>
  .fcard {
    display: flex;
    flex-direction: column;
    gap: 14px;
    height: 100%;
    padding: clamp(28px, 3vw, 40px) clamp(22px, 2.4vw, 32px);
    background-color: var(--white);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    color: var(--slate);
    transition:
      transform 300ms var(--ease),
      box-shadow 300ms var(--ease);
  }

  .fcard--center {
    align-items: center;
    text-align: center;
  }

  .fcard:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-hover);
  }

  .fcard__media {
    width: 100%;
    margin-bottom: 8px;
  }

  .fcard__icon {
    color: var(--brand);
    margin-bottom: 6px;
  }

  .fcard__title {
    font-size: var(--fs-h4);
    line-height: 1.3;
    color: var(--slate-darker);
  }

  .fcard__text {
    font-size: 0.9375rem;
    color: var(--fg-muted);
  }

  .fcard__more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    padding-top: 8px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--brand-text);
  }
</style>
