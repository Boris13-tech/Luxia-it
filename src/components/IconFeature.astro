---
/** Icône orange à gauche, titre et texte à droite ; lien rond optionnel. */
import Icon from './Icon.astro';
import Tbd from './Tbd.astro';
import type { IconName } from '../data/icons';

interface Props {
  icon: IconName;
  title: string;
  text: string;
  tbd?: string | undefined;
  href?: string | undefined;
  linkLabel?: string | undefined;
}

const { icon, title, text, tbd, href, linkLabel } = Astro.props;
---

<div class="ifeat" data-reveal>
  <span class="ifeat__icon"><Icon name={icon} size={64} stroke={1.15} /></span>
  <div class="ifeat__body">
    <div class="ifeat__head">
      <h3 class="ifeat__title">{title}</h3>
      {
        href && (
          <a class="ifeat__link" href={href} aria-label={linkLabel ?? `En savoir plus : ${title}`}>
            <Icon name="chevron-right" size={18} stroke={2} />
          </a>
        )
      }
    </div>
    <p class="ifeat__text">
      {text} {tbd && <Tbd text={tbd} />}
    </p>
  </div>
</div>

<style>
  .ifeat {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 24px;
    align-items: start;
  }

  .ifeat__icon {
    color: var(--brand);
  }

  :global(.on-brand) .ifeat__icon {
    color: var(--white);
  }

  .ifeat__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ifeat__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .ifeat__title {
    font-size: var(--fs-h3);
    line-height: 1.3;
  }

  .ifeat__text {
    font-size: 0.9375rem;
    color: var(--fg);
  }

  .ifeat__link {
    flex: none;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    transition:
      background-color var(--dur) var(--ease),
      color var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  .ifeat__link:hover {
    background-color: var(--white);
    color: var(--brand-text);
    transform: translateX(3px);
  }

  @media (max-width: 559.98px) {
    .ifeat {
      grid-template-columns: 48px minmax(0, 1fr);
      gap: 16px;
    }

    .ifeat__icon :global(svg) {
      width: 48px;
      height: 48px;
    }
  }
</style>
