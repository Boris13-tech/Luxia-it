---
/** Étapes numérotées, reliées par une ligne pointillée sur grand écran. */
interface Step {
  title: string;
  text: string;
}

interface Props {
  steps: readonly Step[];
  /** Sur fond orange, les pastilles sont blanches. */
  onBrand?: boolean | undefined;
}

const { steps, onBrand = false } = Astro.props;
---

<ol class:list={['steps', `steps--${Math.min(steps.length, 4)}`, onBrand && 'steps--on-brand']} data-reveal>
  {
    steps.map((s, i) => (
      <li class="steps__item">
        <span class="steps__num">{i + 1}</span>
        <h3 class="steps__title">{s.title}</h3>
        <p class="steps__text">{s.text}</p>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 36px var(--gap);
  }

  .steps__item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
  }

  .steps__num {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background-color: var(--brand);
    color: var(--white);
    font-size: 1.5rem;
    font-weight: 600;
    box-shadow: 0 0 0 6px rgb(31 95 191 / 0.15);
  }

  .steps--on-brand .steps__num {
    background-color: var(--white);
    color: var(--brand-text);
    box-shadow: 0 0 0 6px rgb(255 255 255 / 0.25);
  }

  .steps__title {
    font-size: var(--fs-h4);
  }

  .steps__text {
    max-width: 18rem;
    font-size: 0.9375rem;
  }

  @media (min-width: 900px) {
    .steps--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .steps--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .steps--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }

    .steps__item:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 30px;
      left: calc(50% + 44px);
      right: calc(-50% + 44px - var(--gap));
      border-top: 2px dashed currentColor;
      opacity: 0.35;
    }
  }
</style>
