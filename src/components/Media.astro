---
/**
 * Cadre pour une capture ou une vidéo réelle du logiciel.
 * Sans `src`, affiche un emplacement « À FOURNIR ». Avec `src` (fichier placé
 * dans public/media/), affiche l'image ou la vidéo muette en boucle.
 * Ne jamais y placer d'interface inventée.
 */
import Icon from './Icon.astro';

interface Props {
  kind?: 'capture' | 'video' | undefined;
  /** Ce qui doit être fourni, ex. « capture — console d'administration ». */
  need: string;
  caption?: string | undefined;
  index?: string | undefined;
  src?: string | undefined;
  poster?: string | undefined;
  alt?: string | undefined;
  ratio?: 'wide' | 'screen' | 'standard' | undefined;
}

const { kind = 'capture', need, caption, index, src, poster, alt = '', ratio = 'screen' } = Astro.props;
---

<figure class:list={['media', `media--${ratio}`]} data-reveal>
  <div class="media__frame">
    {
      src ? (
        kind === 'video' ? (
          <video class="media__asset" data-loop muted loop playsinline preload="metadata" poster={poster} aria-label={alt}>
            <source src={src} type="video/mp4" />
          </video>
        ) : (
          <img class="media__asset" src={src} alt={alt} loading="lazy" decoding="async" />
        )
      ) : (
        <div class="media__ph">
          <Icon name="monitor-cog" size={40} stroke={1.25} />
          <span class="media__kind">{kind === 'video' ? 'Vidéo muette en boucle' : "Capture d'écran"}</span>
          <span class="tbd">[À FOURNIR : {need}]</span>
        </div>
      )
    }
  </div>
  {
    caption && (
      <figcaption class="media__cap">
        {index && <span class="media__index">{index}</span>}
        <span>{caption}</span>
      </figcaption>
    )
  }
</figure>

<style>
  .media {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .media__frame {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius);
    background-color: var(--gray-100);
    border: 1px solid var(--gray-200);
    box-shadow: var(--shadow);
  }

  .media--wide .media__frame {
    aspect-ratio: 16 / 9;
  }

  .media--standard .media__frame {
    aspect-ratio: 4 / 3;
  }

  .media__asset {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }

  .media__ph {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 24px;
    text-align: center;
    color: var(--gray-400);
  }

  .media__kind {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gray-600);
  }

  .media__ph .tbd {
    font-size: var(--fs-small);
  }

  .media__cap {
    display: flex;
    gap: 10px;
    font-size: var(--fs-small);
    color: var(--fg-muted);
  }

  .media__index {
    font-weight: 600;
    color: var(--brand-text);
  }
</style>
