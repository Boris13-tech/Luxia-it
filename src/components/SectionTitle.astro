---
/** Titre de section en deux tons : un mot ou groupe de mots en orange. */
interface Props {
  before?: string | undefined;
  hl: string;
  after?: string | undefined;
  as?: 'h2' | 'h3' | undefined;
  align?: 'center' | 'left' | undefined;
  id?: string | undefined;
  kicker?: string | undefined;
}

const { before, hl, after, as: Tag = 'h2', align = 'center', id, kicker } = Astro.props;
---

<div class:list={['stitle', `stitle--${align}`]} data-reveal>
  {kicker && <p class="kicker">{kicker}</p>}
  <Tag class="stitle__h" id={id}>
    {before}<span class="hl">{hl}</span>{after}
  </Tag>
  {Astro.slots.has('default') && <div class="stitle__intro"><slot /></div>}
</div>

<style>
  .stitle {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: clamp(36px, 5vw, 60px);
  }

  .stitle--center {
    align-items: center;
    text-align: center;
  }

  .stitle__h {
    max-width: 22em;
    font-size: var(--fs-h1);
    line-height: 1.12;
  }

  .stitle__intro {
    max-width: 46rem;
    font-size: var(--fs-lead);
    font-weight: 200;
  }
</style>
