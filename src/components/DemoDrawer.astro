---
/**
 * Panneau latéral coulissant de demande de démonstration / cadrage.
 * S'ouvre au clic sur « Demander une démo » sans quitter l'univers en cours,
 * en assombrissant l'arrière-plan. Fonctionne avec /api/contact et se replie
 * vers /contact/ si JavaScript est désactivé.
 */
import Icon from './Icon.astro';
import { LIMITS, SUBJECTS } from '../../api/contact.ts';
import { facts } from '../data/facts';
import { href } from '../i18n/routes';

const { email } = facts.contact;
---

<div class="drawer-backdrop" data-drawer-backdrop hidden>
  <aside
    class="drawer"
    role="dialog"
    aria-modal="true"
    aria-labelledby="drawer-title"
    data-drawer
    tabindex="-1"
  >
    <div class="drawer__head">
      <p class="kicker">Cadrage / Démonstration</p>
      <button type="button" class="drawer__close" data-drawer-close aria-label="Fermer le panneau">
        <span>Fermer</span>
        <Icon name="x" size={16} stroke={1.8} />
      </button>
    </div>

    <div class="drawer__body">
      <h2 class="t-h2" id="drawer-title">Échanger avec un architecte LUXIA-IT</h2>
      <p class="t-small drawer__lead">
        Décrivez votre environnement d’identité, vos contraintes de souveraineté ou votre projet IA.
      </p>

      <div class="notice notice--ok" data-drawer-success hidden tabindex="-1">
        <p class="notice__title">Votre demande a été transmise.</p>
        <p>Nous vous répondons rapidement à l’adresse indiquée.</p>
      </div>

      <div class="notice" data-drawer-error hidden tabindex="-1">
        <p class="notice__title">Envoi impossible depuis ce panneau.</p>
        <p>
          Utilisez la <a class="link" href={href('contact')}>page contact dédiée</a> ou écrivez à{' '}
          <a class="link" href={`mailto:${email}`}>{email}</a>.
        </p>
      </div>

      <form class="form drawer__form" method="post" action="/api/contact" data-drawer-form>
        <div class="field">
          <label for="drawer-nom">Nom et prénom</label>
          <input
            id="drawer-nom"
            name="nom"
            type="text"
            autocomplete="name"
            required
            minlength={LIMITS.nom[0]}
            maxlength={LIMITS.nom[1]}
          />
        </div>

        <div class="field">
          <label for="drawer-email">E-mail professionnel</label>
          <input
            id="drawer-email"
            name="email"
            type="email"
            autocomplete="email"
            required
            maxlength={LIMITS.email[1]}
          />
        </div>

        <div class="field">
          <label for="drawer-org">Organisation</label>
          <input
            id="drawer-org"
            name="organisation"
            type="text"
            autocomplete="organization"
            required
            minlength={LIMITS.organisation[0]}
            maxlength={LIMITS.organisation[1]}
          />
        </div>

        <div class="field">
          <label for="drawer-sujet">Sujet principal</label>
          <select id="drawer-sujet" name="sujet" required>
            {Object.entries(SUBJECTS).map(([value, label]) => <option value={value}>{label}</option>)}
          </select>
        </div>

        <div class="field">
          <label for="drawer-message">Contexte et objectifs</label>
          <textarea
            id="drawer-message"
            name="message"
            rows="4"
            required
            minlength={LIMITS.message[0]}
            maxlength={LIMITS.message[1]}
          ></textarea>
        </div>

        <div class="hp" aria-hidden="true">
          <label for="drawer-site">Site web</label>
          <input id="drawer-site" name="site_web" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="drawer__actions">
          <button type="submit" class="btn btn--primary">
            <span>Envoyer la demande</span>
            <Icon name="arrow-right" size={16} stroke={1.8} />
          </button>
          <a class="link" href={href('contact')}>Ouvrir la page complète</a>
        </div>
      </form>
    </div>
  </aside>
</div>

<style>
  .drawer-backdrop {
    position: fixed;
    inset: 0;
    z-index: 120;
    display: flex;
    justify-content: flex-end;
    background: rgb(2 5 12 / 0.72);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    opacity: 0;
    transition: opacity 320ms var(--ease);
  }

  .drawer-backdrop[hidden] {
    display: none;
  }

  .drawer-backdrop[data-open='true'] {
    opacity: 1;
  }

  .drawer {
    width: min(520px, 100vw);
    height: 100%;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: clamp(24px, 4vw, 40px);
    background: linear-gradient(180deg, #0a1222 0%, #060911 100%);
    border-left: 1px solid var(--line-strong);
    box-shadow: -28px 0 64px rgb(0 0 0 / 0.7);
    transform: translateX(36px);
    transition: transform 380ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .drawer-backdrop[data-open='true'] .drawer {
    transform: translateX(0);
  }

  .drawer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line);
  }

  .drawer__close {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    font-family: var(--mono);
    font-size: 0.75rem;
    cursor: pointer;
    transition: border-color 200ms var(--ease), background-color 200ms var(--ease);
  }

  .drawer__close:hover {
    border-color: var(--link);
    background: var(--surface-2);
  }

  .drawer__body {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .drawer__lead {
    color: var(--ink-2);
  }

  .drawer__form {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 8px;
  }

  .drawer__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding-top: 8px;
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .drawer-backdrop,
    .drawer {
      transition: none;
    }
  }
</style>
