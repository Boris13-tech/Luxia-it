---
/**
 * Entreprise. Jalons tirés de iam-azure-pme/docs/product/ENTERPRISE-READINESS.md
 * et des rapports de certification qui y sont cités (lus le 23 octobre 2026).
 * Repères, dirigeants et certifications : uniquement depuis src/data/facts.ts.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import SectionHead from '../components/SectionHead.astro';
import EvidenceScale from '../components/EvidenceScale.astro';
import Timeline from '../components/Timeline.astro';
import CtaBlock from '../components/CtaBlock.astro';
import { facts } from '../data/facts';
import { platforms } from '../data/platforms';
import { href } from '../i18n/routes';

const beliefs = [
  {
    title: 'Souveraineté, au sens technique',
    text: 'Le cœur doit pouvoir identifier une personne et évaluer un accès sans dépendre d’un fournisseur externe.',
  },
  {
    title: 'Confiance, au sens de la preuve',
    text: 'Une capacité n’est annoncée qu’une fois démontrée. Ce qui ne l’est pas encore est nommé comme tel.',
  },
  {
    title: 'Contrôle, au sens de la trace',
    text: 'Chaque décision d’administration laisse une trace que son auteur ne peut pas réécrire.',
  },
];

const rules = [
  'Un changement fusionné ne vaut pas preuve.',
  'Aucune affirmation de conformité qui n’a pas été démontrée.',
  'Ce qui manque est consigné, pas dissimulé.',
];

const milestones = [
  {
    date: '2026-09-20',
    title: 'Décision d’architecture : un registre d’identité souverain',
    text: 'Identité canonique au cœur, fournisseurs remplaçables, un seul code pour le cloud, l’hybride et le souverain.',
  },
  {
    date: '2026-10-10',
    title: 'Ressources, habilitations et revues d’accès',
    text: 'Ressources, droits, séparation des tâches et revues d’accès vérifiés de bout en bout en production.',
    level: 'production' as const,
  },
  {
    date: '2026-10-11',
    title: 'Inscription des organisations',
    text: 'Une organisation s’inscrit, son fondateur se connecte avec une passkey ; plusieurs organisations coexistent.',
    level: 'production' as const,
  },
  {
    date: '2026-10-13',
    title: 'Journal en ajout seul et restauration démontrée',
    text: 'L’application ne peut plus modifier ni supprimer le journal ; la base est reconstruite à partir d’une sauvegarde indépendante.',
    level: 'production' as const,
  },
  {
    date: '2026-10-14',
    title: 'Connexion Microsoft Entra ID',
    text: 'Le cœur OIDC générique est vérifié en production par une connexion réelle.',
    level: 'production' as const,
  },
  {
    date: '2026-10-15',
    title: 'Connexions de fournisseurs pilotées',
    text: 'Cycle de vie, coupure d’urgence et isolation des connexions vérifiés en production.',
    level: 'production' as const,
  },
  {
    date: '2026-10-18',
    title: 'Bascule répétée dans la région cible',
    text: 'Restauration de données réelles à Francfort et bascule de l’application vers une base restaurée.',
    level: 'ci' as const,
  },
];

const certifications = facts.company.certifications;
const notClaimed = [
  certifications.length === 0 ? 'Aucune certification de sécurité à ce jour.' : null,
  'Aucun audit externe ni test d’intrusion à ce jour.',
  'Aucune référence client publiée.',
  'Aucune plateforme proposée commercialement à ce jour.',
].filter((s): s is string => s !== null);

const landmarks = [
  { key: 'Activité', value: 'Plateformes d’identité et de confiance, et services associés' },
  { key: 'Plateformes', value: platforms.map((p) => p.name).join(', ') },
  { key: 'Création', value: facts.company.founded },
  { key: 'Siège', value: facts.company.headquarters },
  { key: 'Forme juridique', value: facts.publisher.legalForm },
  { key: 'Équipe', value: facts.company.headcount },
  { key: 'Contact', value: `${facts.contact.email} · ${facts.contact.phone}` },
].filter((l): l is { key: string; value: string } => l.value !== null);
---

<BaseLayout
  title="Entreprise"
  description="Luxia-IT conçoit des plateformes d’identité et de confiance. Conviction, méthode de preuve, jalons vérifiés et ce que nous ne revendiquons pas."
  crumbs={[{ label: 'Entreprise' }]}
>
  <PageHead
    crumbs={[{ label: 'Entreprise' }]}
    kicker="Entreprise"
    title="Luxia-IT conçoit des plateformes d’identité et de confiance"
    lead="Pour les organisations dont les opérations dépendent de qui accède à quoi. Nous construisons peu de choses, et nous disons exactement où elles en sont."
  />

  <section class="section" id="vision" aria-labelledby="vision-title">
    <div class="wrap">
      <SectionHead
        id="vision-title"
        index="01"
        kicker="Conviction"
        title="L’identité d’une organisation doit lui appartenir"
        lead="Un fournisseur d’identité prouve qui est une personne ; il ne devrait posséder ni son compte, ni ses droits, ni son historique. Nos plateformes gardent ce registre au cœur et traitent chaque fournisseur comme un adaptateur remplaçable."
      />
      <ul class="ruled ruled--3">
        {
          beliefs.map((b) => (
            <li>
              <h3 class="ruled__title">{b.title}</h3>
              <p class="ruled__text">{b.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--alt" id="preuve" aria-labelledby="preuve-title">
    <div class="wrap">
      <SectionHead
        id="preuve-title"
        index="02"
        kicker="Méthode"
        title="Une échelle de preuve, appliquée à tout"
        lead="Nos dépôts suivent chaque capacité sur une échelle de maturité. Ce site en reprend les niveaux, sans les arrondir."
      >
        <ul class="rules">{rules.map((r) => <li>{r}</li>)}</ul>
      </SectionHead>
      <EvidenceScale />
    </div>
  </section>

  <section class="section" id="jalons" aria-labelledby="jalons-title">
    <div class="wrap">
      <SectionHead
        id="jalons-title"
        index="03"
        kicker="Jalons"
        title="Ce qui a été démontré, et quand"
        lead="Les jalons de LUXIA Identity, avec le niveau de preuve de chacun."
      />
      <Timeline items={milestones} />
    </div>
  </section>

  <section class="section section--alt" id="limites" aria-labelledby="limites-title">
    <div class="wrap">
      <SectionHead id="limites-title" index="04" kicker="Sans détour" title="Ce que nous ne revendiquons pas">
        <ul class="plain">{notClaimed.map((n) => <li>{n}</li>)}</ul>
        {
          certifications.length > 0 && (
            <>
              <h3 class="t-h4">Certifications obtenues</h3>
              <ul class="plain">{certifications.map((c) => <li>{c}</li>)}</ul>
            </>
          )
        }
      </SectionHead>
    </div>
  </section>

  <section class="section" id="reperes" aria-labelledby="reperes-title">
    <div class="wrap">
      <SectionHead id="reperes-title" index="05" kicker="Repères" title="Luxia-IT en bref">
        <dl class="facts">
          {
            landmarks.map((l) => (
              <div>
                <dt>{l.key}</dt>
                <dd>{l.value}</dd>
              </div>
            ))
          }
        </dl>
      </SectionHead>
      {
        facts.company.leaders.length > 0 && (
          <div class="leaders">
            <h3 class="t-h3">Direction</h3>
            <ul class="ruled ruled--3">
              {facts.company.leaders.map((person) => (
                <li>
                  <p class="ruled__title">{person.name}</p>
                  <p class="ruled__text">{person.role}</p>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>

  <CtaBlock
    title="Travailler avec Luxia-IT"
    text="Un projet d’identité, une question d’architecture ou une candidature : écrivez-nous."
    href={href('contact')}
    label="Nous écrire"
    secondary={{ href: href('careers'), label: 'Carrières' }}
  />
</BaseLayout>

<style>
  .rules,
  .plain {
    border-top: 1px solid var(--line);
  }

  .rules li,
  .plain li {
    padding-block: 12px;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
  }

  .facts {
    border-top: 2px solid var(--ink);
  }

  .facts > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2px 24px;
    padding-block: 12px;
    border-bottom: 1px solid var(--line);
  }

  .facts dt {
    font-family: var(--mono);
    font-size: var(--fs-meta);
    color: var(--ink-3);
  }

  .facts dd {
    color: var(--ink);
  }

  .leaders {
    margin-top: 56px;
  }

  .leaders h3 {
    margin-bottom: 16px;
  }

  @media (min-width: 720px) {
    .facts > div {
      grid-template-columns: 12rem minmax(0, 1fr);
    }
  }
</style>
