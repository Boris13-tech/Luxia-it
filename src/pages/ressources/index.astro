---
/** Ressources : guides pratiques (src/data/guides.ts) et documents de référence du site. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import Icon from '../../components/Icon.astro';
import { guideHref, guides, readingMinutes } from '../../data/guides';
import { formatDate } from '../../data/facts';
import { href } from '../../i18n/routes';

const references = [
  { title: 'Centre de confiance', text: 'Architecture de sécurité, exploitation, hébergement et limites de LUXIA Identity.', href: href('trust') },
  { title: 'Architectures de référence', text: 'Les modèles de déploiement, décrits sans raccourci.', href: href('architectures') },
  { title: 'Divulgation responsable', text: 'Signaler une vulnérabilité dans nos plateformes ou ce site.', href: href('security') },
];
---

<BaseLayout
  title="Ressources"
  description="Guides pratiques de gestion des identités et des accès : revues d’accès, séparation des tâches, clés d’accès. Et les documents de référence de Luxia-IT."
  crumbs={[{ label: 'Ressources' }]}
>
  <PageHead
    crumbs={[{ label: 'Ressources' }]}
    kicker="Ressources"
    title="Guides et documents de référence"
    lead="Des méthodes concrètes pour gouverner les identités et les accès, que vous utilisiez LUXIA Identity ou non."
  />

  <section class="section" aria-labelledby="guides-title">
    <div class="wrap">
      <h2 class="t-h3 list-title" id="guides-title">Guides pratiques</h2>
      <ul class="guides">
        {
          guides.map((g) => (
            <li class="guide">
              <p class="guide__meta">
                {g.topic} · {readingMinutes(g)} min de lecture · <time datetime={g.published}>{formatDate(g.published)}</time>
              </p>
              <h3 class="guide__title">
                <a href={guideHref(g.slug)}>{g.title}</a>
              </h3>
              <p class="guide__text">{g.description}</p>
              <span class="guide__more" aria-hidden="true">
                Lire le guide <Icon name="arrow-right" size={16} />
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="ref-title">
    <div class="wrap">
      <h2 class="t-h3 list-title" id="ref-title">Documents de référence</h2>
      <ul class="ruled ruled--3">
        {
          references.map((r) => (
            <li>
              <h3 class="ruled__title">
                <a class="ref-link" href={r.href}>
                  {r.title}
                </a>
              </h3>
              <p class="ruled__text">{r.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBlock
    title="Un sujet que vous aimeriez voir traité ?"
    text="Dites-nous quelle question d’identité ou d’accès vous occupe : elle peut devenir le prochain guide."
    href={`${href('contact')}?sujet=autre`}
    label="Nous écrire"
  />
</BaseLayout>

<style>
  .list-title {
    margin-bottom: 24px;
  }

  .guides {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }

  .guide {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition:
      border-color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  .guide:hover {
    border-color: var(--blue-light);
    box-shadow: 0 14px 30px -20px rgb(23 33 49 / 0.35);
  }

  .guide__meta {
    font-size: var(--fs-meta);
    font-weight: 500;
    color: var(--electric);
  }

  .guide__title {
    font-size: var(--fs-h4);
    line-height: 1.3;
  }

  .guide__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .guide__title a:focus-visible {
    outline: none;
  }

  .guide:has(a:focus-visible) {
    outline: 2px solid var(--blue);
    outline-offset: 2px;
  }

  .guide__text {
    font-size: var(--fs-small);
    color: var(--ink-2);
  }

  .guide__more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    padding-top: 8px;
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--link);
  }

  .ref-link {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 4px;
  }

  .ref-link:hover {
    color: var(--link);
    text-decoration-color: currentColor;
  }

  @media (min-width: 1024px) {
    .guides {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
