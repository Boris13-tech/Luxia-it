---
import PlatformPage from '../../components/PlatformPage.astro';
import { platforms } from '../../data/site';

const platform = platforms.find((p) => p.slug === 'luxia-identity')!;
---

<PlatformPage
  platform={platform}
  description="LUXIA Identity : gestion des identités et des accès. Authentification unifiée, fédération des fournisseurs d'identité et journaux d'audit, en cloud, sur site ou en environnement souverain."
  titleBefore="LUXIA "
  titleHl="Identity"
  lead="La gestion des identités et des accès, sur l’infrastructure que vous contrôlez."
  problemIntro="Les accès critiques ne peuvent pas dépendre d’un service que vous ne maîtrisez pas. LUXIA Identity centralise l’authentification et la fédération dans une plateforme que vous déployez et que vous contrôlez."
  problems={[
    {
      icon: 'users',
      title: 'Des identités dispersées',
      text: 'Annuaires, fournisseurs externes et comptes locaux coexistent sans politique commune. Chaque application applique ses propres règles.',
    },
    {
      icon: 'unplug',
      title: 'Une dépendance extérieure',
      text: 'L’authentification repose sur un service dont vous ne maîtrisez ni la localisation des données ni la disponibilité.',
    },
    {
      icon: 'search',
      title: 'Une traçabilité incomplète',
      text: 'Établir qui a accédé à quoi, et quand, demande une reconstitution manuelle à partir de plusieurs sources.',
    },
  ]}
  screens={[
    { need: "vidéo — console d'administration LUXIA Identity", caption: 'Console d’administration', kind: 'video' },
    { need: 'vidéo — flux de connexion', caption: 'Flux de connexion', kind: 'video' },
    { need: "capture — gestion des fournisseurs d'identité", caption: 'Gestion des fournisseurs' },
    { need: "capture — journaux d'audit", caption: 'Journaux d’audit' },
  ]}
  steps={[
    { title: 'Connexion', text: 'L’utilisateur ouvre une application ; la demande d’authentification est redirigée vers LUXIA Identity.' },
    { title: 'Fédération', text: 'La plateforme vérifie l’identité auprès du fournisseur configuré : annuaire ou fournisseur externe.' },
    { title: 'Politique d’accès', text: 'Les politiques déterminent si cet utilisateur peut ouvrir cette application.' },
    { title: 'Jeton et journal', text: 'L’application reçoit un jeton signé ; l’événement est inscrit au journal d’audit.' },
  ]}
  diagram={{
    inputs: { label: 'Accès', items: ['Utilisateurs', 'Administrateurs'] },
    core: { label: 'LUXIA Identity', items: ['Authentification', 'Fédération', 'Politiques d’accès', 'Journal d’audit'] },
    outputs: { label: 'Applications', items: ['Applications métier', 'Applications web', 'Outils internes'] },
    base: { label: 'Fournisseurs d’identité', items: ['Annuaire d’entreprise', 'Fournisseurs externes'] },
    links: { in: 'Connexion', out: 'Jeton signé', base: 'Fédération' },
  }}
  capabilities={[
    { icon: 'log-in', title: 'Authentification unifiée', text: 'Un point d’entrée unique pour vos applications, avec authentification unique (SSO).' },
    { icon: 'network', title: 'Fédération des fournisseurs', text: 'Annuaire interne et fournisseurs externes, connectés et administrés au même endroit.' },
    { icon: 'clipboard-check', title: 'Politiques d’accès', text: 'Des règles explicites par application et par groupe d’utilisateurs.' },
    { icon: 'fingerprint', title: 'Authentification multifacteur', text: 'Un second facteur exigé selon l’application ou le profil.', tbd: 'À CONFIRMER' },
    { icon: 'scroll-text', title: 'Journaux d’audit', text: 'Chaque authentification et chaque action d’administration, horodatée et consultable.' },
    { icon: 'user-cog', title: 'Console d’administration', text: 'Utilisateurs, applications, fournisseurs et politiques, avec des rôles d’administration distincts.' },
  ]}
  security={[
    { icon: 'lock', title: 'Chiffrement', text: 'Données chiffrées en transit et au repos.', tbd: 'À CONFIRMER : algorithmes et gestion des clés' },
    { icon: 'scroll-text', title: 'Traçabilité', text: 'Chaque action d’authentification et d’administration est journalisée et horodatée.' },
    { icon: 'user-cog', title: 'Séparation des rôles', text: 'Les droits d’administration sont distincts des droits d’usage et attribués par rôle.' },
    { icon: 'globe-lock', title: 'Maîtrise du périmètre', text: 'En déploiement on-premise ou souverain, aucune donnée d’identité ne quitte votre infrastructure.' },
  ]}
  referentials={[
    { key: 'RGPD', tbd: 'À CONFIRMER : périmètre et documentation' },
    { key: 'ISO/IEC 27001', tbd: 'À CONFIRMER : statut' },
    { key: 'Autres référentiels', tbd: 'À FOURNIR' },
  ]}
  statusRows={[
    { key: 'Statut', value: 'En production', live: true },
    { key: 'Version actuelle', tbd: 'À FOURNIR' },
    { key: 'Modèles de déploiement', value: 'Cloud, on-premise, souverain', tbd: 'À CONFIRMER' },
    { key: 'Documentation', tbd: 'À FOURNIR : lien' },
    { key: 'Support', tbd: 'À FOURNIR : modalités et horaires' },
  ]}
/>
