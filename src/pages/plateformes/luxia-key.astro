---
import PlatformPage from '../../components/PlatformPage.astro';
import { platforms } from '../../data/site';

const platform = platforms.find((p) => p.slug === 'luxia-key')!;
const tbd = 'À FOURNIR';
---

<PlatformPage
  platform={platform}
  description="LUXIA Key, plateforme de Luxia-IT."
  titleBefore="LUXIA "
  titleHl="Key"
  lead="La gestion des clés cryptographiques et des secrets, sous votre contrôle."
  leadTbd="HYPOTHÈSE — À CONFIRMER : description de LUXIA Key"
  problemIntro="Les clés qui protègent vos données doivent rester sous votre autorité."
  problemIntroTbd="À CONFIRMER"
  problems={[
    { icon: 'key-round', title: 'Constat 1', text: '', tbd: `${tbd} : problème résolu` },
    { icon: 'database', title: 'Constat 2', text: '', tbd: `${tbd} : problème résolu` },
    { icon: 'search', title: 'Constat 3', text: '', tbd: `${tbd} : problème résolu` },
  ]}
  screens={[
    { need: 'capture — interface principale LUXIA Key', caption: 'LUXIA Key — vue principale' },
    { need: 'capture — LUXIA Key', caption: 'Capture 2' },
    { need: 'capture — LUXIA Key', caption: 'Capture 3' },
    { need: 'capture — LUXIA Key', caption: 'Capture 4' },
  ]}
  steps={[
    { title: 'Étape 1', text: '[À FOURNIR]' },
    { title: 'Étape 2', text: '[À FOURNIR]' },
    { title: 'Étape 3', text: '[À FOURNIR]' },
  ]}
  diagram={{
    inputs: { label: 'Demandeurs', items: ['Applications', 'Services', 'Administrateurs'] },
    core: { label: 'LUXIA Key', items: ['Stockage des clés', 'Gestion des secrets', 'Rotation', 'Journal d’audit'] },
    outputs: { label: 'Usages', items: ['Opérations cryptographiques', 'Secrets délivrés'] },
    base: { label: 'Matériel de sécurité', items: ['Modules matériels (HSM)'] },
    links: { in: 'Requête authentifiée', out: 'Réponse', base: 'Protection des clés' },
    note: 'Schéma indicatif, à valider par l’équipe produit.',
  }}
  capabilities={[
    { icon: 'key-round', title: 'Cycle de vie des clés', text: '', tbd: `${tbd} : description` },
    { icon: 'lock', title: 'Gestion des secrets', text: '', tbd: `${tbd} : description` },
    { icon: 'activity', title: 'Rotation planifiée', text: '', tbd: `${tbd} : description` },
    { icon: 'scroll-text', title: 'Journal d’audit', text: '', tbd: `${tbd} : description` },
    { icon: 'server-cog', title: 'Modules matériels', text: '', tbd: 'À CONFIRMER' },
    { icon: 'plug', title: 'Intégration', text: '', tbd: `${tbd} : description` },
  ]}
  deploymentTbd="À CONFIRMER : modèles disponibles pour LUXIA Key"
  security={[
    { icon: 'shield-check', title: 'Mécanismes de sécurité', text: '', tbd: tbd },
    { icon: 'file-check', title: 'Documentation d’audit', text: '', tbd: tbd },
  ]}
  referentials={[{ key: 'Référentiels', tbd: tbd }]}
  statusRows={[
    { key: 'Statut', tbd: 'À CONFIRMER' },
    { key: 'Disponibilité', tbd: tbd },
    { key: 'Programme d’accès anticipé', tbd: 'À CONFIRMER' },
  ]}
/>
