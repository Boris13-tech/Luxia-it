---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import ClaimList from '../components/ClaimList.astro';
import Method from '../components/Method.astro';
import PlatformExplorer from '../components/PlatformExplorer.astro';
import IdentityFlow from '../components/IdentityFlow.astro';
import Pictogram, { type PictogramName } from '../components/Pictogram.astro';
import CtaBlock from '../components/CtaBlock.astro';
import Icon from '../components/Icon.astro';
import { facts } from '../data/facts';
import { href } from '../i18n/routes';

const audiences: { title: string; text: string; picto: PictogramName; tone: 'blue' | 'terra' | 'ochre' | 'sage' }[] = [
  {
    title: 'Vous dirigez un système d’information',
    text: 'Vous voulez un registre unique des identités et des accès, qui ne dépende pas des fournisseurs que vous utilisez aujourd’hui.',
    picto: 'screen',
    tone: 'blue',
  },
  {
    title: 'Vous répondez de la sécurité',
    text: 'Vous voulez des droits explicites, des revues d’accès, une séparation des tâches et un journal que personne ne peut réécrire après coup.',
    picto: 'shield',
    tone: 'terra',
  },
  {
    title: 'Vous concevez l’architecture',
    text: 'Vous voulez des décisions écrites et des modèles de déploiement décrits sans raccourci, avec ce qui est en service et ce qui ne l’est pas.',
    picto: 'compass',
    tone: 'ochre',
  },
  {
    title: 'Vous achetez ou vous auditez',
    text: 'Vous voulez savoir ce qui est démontré, ce qui ne l’est pas encore et où sont les données. Nous le disons dès le premier échange.',
    picto: 'clipboard',
    tone: 'sage',
  },
];

const answers = [
  {
    title: 'L’identité reste dans votre registre',
    text: 'Les fournisseurs d’identité se branchent sur la plateforme. Ils prouvent qui est une personne ; ils ne possèdent ni son compte, ni ses droits.',
    level: 'production' as const,
  },
  {
    title: 'Chaque droit est explicite',
    text: 'Ressources, habilitations, règles de séparation des tâches et revues d’accès, organisation par organisation.',
    level: 'production' as const,
  },
  {
    title: 'La trace ne se réécrit pas',
    text: 'Le journal d’administration et les preuves de connexion sont en ajout seul : l’application ne peut ni les modifier ni les supprimer.',
    level: 'production' as const,
  },
];

const method = [
  { title: 'Écrire avant de coder', text: 'Une décision, un périmètre et des critères de réussite, écrits et relus avant la première ligne.' },
  { title: 'Tester ce qui protège', text: 'Des tests automatisés à chaque changement, y compris sur les règles d’isolation de la base de données.' },
  { title: 'Répéter avant d’appliquer', text: 'Chaque migration est d’abord répétée sur une copie, avec un retour arrière écrit.' },
  { title: 'Vérifier pour de vrai', text: 'Une vérification en production, consignée, avant de dire qu’une capacité fonctionne.' },
  { title: 'Restaurer pour prouver', text: 'Une sauvegarde ne compte que si l’on a déjà su la restaurer.' },
];

const services: { title: string; text: string; anchor: string; picto: PictogramName; tone: 'blue' | 'terra' | 'ochre' | 'sage' }[] = [
  { title: 'Cadrage et architecture', text: 'Nous faisons ensemble l’inventaire des identités et des accès, des risques, puis l’architecture cible.', anchor: '#cadrage', picto: 'compass', tone: 'blue' },
  { title: 'Intégration et migration', text: 'Nous connectons vos fournisseurs, menons la recette avec vous et migrons par lots, toujours avec retour arrière.', anchor: '#integration', picto: 'loop', tone: 'ochre' },
  { title: 'Exploitation et sécurité', text: 'Nous tenons dans la durée : procédures, sauvegardes vérifiées, revue des accès à privilèges.', anchor: '#exploitation', picto: 'shield', tone: 'sage' },
];
---

<BaseLayout
  title="Plateformes d’identité et de confiance"
  description="Luxia-IT conçoit des plateformes d’identité et de confiance pour les opérations critiques : identités, accès et traces d’audit. Chaque capacité indique son niveau de preuve."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero__grid">
      <div class="hero__text">
        <p class="kicker">{facts.brand.signature}</p>
        <h1 class="t-display hero__title" id="hero-title">Savoir qui accède à quoi, et pouvoir le prouver.</h1>
        <p class="t-lead">
          Luxia-IT conçoit des plateformes d’identité et de confiance pour les organisations dont les opérations sont
          critiques. Nous disons franchement où en est chaque capacité.
        </p>
        <div class="actions">
          <a class="btn btn--primary" href={`${href('contact')}?sujet=cadrage`}>
            Parlons de votre projet
            <Icon name="arrow-right" size={18} />
          </a>
          <a class="more" href={href('platforms')}>
            Découvrir les plateformes
            <Icon name="arrow-right" size={16} />
          </a>
        </div>
      </div>

      <IdentityFlow />
    </div>
  </section>

  <section class="section section--blue" aria-labelledby="etat-title">
    <div class="wrap explorer-wrap">
      <div class="explorer-intro">
        <h2 class="t-h2" id="etat-title">Où en sont nos plateformes, aujourd’hui</h2>
        <p class="t-lead">Choisissez une plateforme : vous voyez le problème qu’elle traite, son étape réelle et la façon dont elle est déployée.</p>
      </div>
      <PlatformExplorer />
    </div>
  </section>

  <section class="section" aria-labelledby="publics-title">
    <div class="wrap">
      <SectionHead id="publics-title" kicker="Pour qui" title="Pour celles et ceux qui répondent des accès" />
      <ul class="ruled ruled--4 people">
        {
          audiences.map((a) => (
            <li>
              <Pictogram name={a.picto} tone={a.tone} />
              <h3 class="ruled__title">{a.title}</h3>
              <p class="ruled__text">{a.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="probleme-title">
    <div class="wrap">
      <SectionHead
        id="probleme-title"
        kicker="Le problème"
        title="Les accès critiques reposent sur des identités que personne ne maîtrise entièrement"
        lead="Annuaires, fournisseurs externes, comptes locaux : chaque source applique ses propres règles. Quand un fournisseur fait autorité, en changer remet en cause les comptes, les droits et l’historique. Et après un incident, il faut reconstituer qui a fait quoi à partir de journaux que leurs auteurs peuvent modifier."
      />
      <ClaimList claims={answers} columns={3} />
    </div>
  </section>

  <section class="section section--sage" aria-labelledby="methode-title">
    <div class="wrap">
      <SectionHead
        id="methode-title"
        kicker="Notre façon de travailler"
        title="La méthode que nous appliquons d’abord à nous-mêmes"
        lead="Un changement fusionné ne vaut pas preuve. Nous n’annonçons une capacité qu’une fois démontrée là où elle doit fonctionner."
      />
      <Method steps={method} />
    </div>
  </section>

  <section class="section" aria-labelledby="services-title">
    <div class="wrap">
      <SectionHead
        id="services-title"
        kicker="À vos côtés"
        title="Déployer et faire vivre l’identité"
        lead="L’identité reste notre point d’entrée. Le cloud Microsoft Azure et Entra, l’automatisation DevSecOps et l’IA appliquée s’y rattachent : là où vivent les identités, la manière de livrer, et les agents qui agissent."
      />
      <ul class="ruled ruled--3 people">
        {
          services.map((s) => (
            <li>
              <Pictogram name={s.picto} tone={s.tone} />
              <h3 class="ruled__title">
                <a class="svc-link" href={`${href('services')}${s.anchor}`}>
                  {s.title}
                </a>
              </h3>
              <p class="ruled__text">{s.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBlock
    title="Parlons de votre projet"
    text="Un premier échange, sans engagement : votre inventaire d’identités, vos contraintes de déploiement, et ce que LUXIA Identity couvre — ou ne couvre pas encore."
    href={`${href('contact')}?sujet=cadrage`}
    label="Nous écrire"
    secondary={{ href: href('company'), label: 'Qui est Luxia-IT' }}
  />
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(40px, 7vw, 104px) clamp(48px, 7vw, 104px);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px var(--gap);
    align-items: center;
  }

  .hero__text {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .hero__title {
    max-width: 14ch;
  }

  .hero__text .actions {
    margin-top: 4px;
  }

  .explorer-wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px var(--gap);
    align-items: start;
  }

  .explorer-intro {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .people > li {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }

  .people :global(.picto) {
    margin-bottom: 10px;
  }

  .svc-link {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 4px;
  }

  .svc-link:hover {
    color: var(--link);
    text-decoration-color: currentColor;
  }

  @media (min-width: 1024px) {
    .hero__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }

    .explorer-wrap {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    }

    .explorer-intro {
      position: sticky;
      top: calc(var(--header-h) + 40px);
    }
  }
</style>
