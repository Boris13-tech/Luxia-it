---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductScreen from '../components/ProductScreen.astro';
import ProductTour from '../components/ProductTour.astro';
import KeyFacts from '../components/KeyFacts.astro';
import ConstellationScene from '../components/ConstellationScene.astro';
import UnifiedStackMatrix from '../components/UnifiedStackMatrix.astro';
import KeyDeviceShowcase from '../components/KeyDeviceShowcase.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaBlock from '../components/CtaBlock.astro';
import Icon from '../components/Icon.astro';
import { useCases } from '../data/product';
import { guideHref, guides, readingMinutes } from '../data/guides';
import { href } from '../i18n/routes';

const demo = `${href('contact')}?sujet=demo`;

const roles = [
  {
    code: 'DIR / DSI',
    title: 'Direction des systèmes d’information',
    text: 'Un registre unique des identités, des droits et des dépendances applicatives — découplé d’un fournisseur unique et déployable selon vos contraintes d’hébergement.',
  },
  {
    code: 'RSSI / SEC',
    title: 'Sécurité et gouvernance Zero Trust',
    text: 'Connexions par passkeys résistantes au phishing, blocage natif des attributions incompatibles (SoD), validation hors bande via LUXIA Key et journal en ajout seul.',
  },
  {
    code: 'OPS / IA',
    title: 'Exploitation système, DevSecOps et agents IA',
    text: 'Automatisation de l’enrôlement et des révocations, gouvernance explicite des outils exposés aux agents ALMA et contrôle humain sur chaque action sensible.',
  },
  {
    code: 'AUDIT / METIER',
    title: 'Audit, conformité et responsables métier',
    text: 'Revues d’accès lisibles en quelques secondes et piste forensique reliant identité, politique appliquée, décision d’approbation et horodatage.',
  },
] as const;

const trustMarks = [
  { label: 'CSP stricte sans script en ligne', note: 'Zéro cookie publicitaire, zéro traceur tiers, zéro stockage navigateur' },
  { label: 'Authentification résistante au phishing', note: 'Passkeys WebAuthn / FIDO2 et compagnon applicatif LUXIA Key' },
  { label: 'Journal en ajout seul', note: 'L’application applicative ne peut ni altérer ni effacer l’historique d’audit' },
  { label: 'Répartition explicite des responsabilités', note: 'Déploiement managé, sur site client ou périmètre souverain isolé' },
] as const;

const advisoryPillars = [
  {
    code: 'ARCH-01',
    title: 'Cybersécurité & gouvernance des identités',
    text: 'Audit de maturité IAM, structuration Microsoft Entra ID, accès conditionnel, PIM/PAM, séparation des tâches et passage au sans-mot-de-passe.',
    anchor: '#cadrage',
  },
  {
    code: 'CLOUD-02',
    title: 'Architecture Cloud souverain & réseau critique',
    text: 'Conception de Landing Zones Microsoft Azure, segmentation Hub-Spoke, Private Link, DNS hybride, plans de reprise et maîtrise FinOps.',
    anchor: '#architecture',
  },
  {
    code: 'DEV-03',
    title: 'Ingénierie logicielle & usines DevSecOps',
    text: 'Industrialisation Bicep/Terraform, pipelines CI/CD fédérés sans secrets statiques (OIDC), durcissement Windows/Linux et automatisation d’exploitation.',
    anchor: '#integration',
  },
  {
    code: 'AI-04',
    title: 'Systèmes d’IA d’entreprise sous contrôle',
    text: 'Déploiement d’architectures RAG et d’agents outillés avec identités dédiées, filtrage des flux, approbation humaine et traçabilité complète.',
    anchor: '#securite-operationnelle',
  },
] as const;
---

<BaseLayout
  title="Plateforme unifiée de sécurité, identité et IA"
  description="Plateforme unifiée LUXIA en six niveaux — identités souveraines, LUXIA Key et gouvernance IA — et cabinet d’ingénierie cybersécurité, cloud et DevSecOps."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__stage">
      <ConstellationScene variant="identity" />
      <div class="wrap hero__text">
        <p class="hero__index">LUXIA-IT · ÉDITEUR TECHNOLOGIQUE & CABINET D’INGÉNIERIE</p>
        <h1 class="t-display hero__title" id="hero-title">
          Sécurité critique, identités souveraines et systèmes d’IA sous contrôle.
        </h1>
        <p class="t-lead hero__lead">
          Luxia-IT conçoit la plateforme unifiée LUXIA en six niveaux — de LUXIA Identity et LUXIA Key jusqu’à la gouvernance
          des agents IA — et accompagne les organisations comme cabinet d’architecture, de cybersécurité, de cloud et d’ingénierie IA.
        </p>
        <div class="actions hero__actions">
          <a class="btn btn--primary" href={demo}>
            <span>Demander un échange</span>
            <Icon name="arrow-right" size={18} />
          </a>
          <a class="btn btn--secondary" href="#stack">Explorer les six niveaux</a>
          <a class="link" href={href('services')}>
            <span>Voir le cabinet d’ingénierie</span>
            <Icon name="chevron-right" size={16} />
          </a>
        </div>
      </div>
    </div>

    <div class="wrap">
      <ProductScreen
        screen="overview"
        hero
        class="hero__screen"
        caption="Console d’administration LUXIA Identity : synthèse des risques actifs, habilitations en vigueur et contrôle d’audit."
      />
    </div>
  </section>

  <KeyFacts />

  <section class="section" id="stack" aria-labelledby="stack-title">
    <div class="wrap">
      <SectionHead
        id="stack-title"
        title="La plateforme unifiée LUXIA en six niveaux d’architecture"
        lead="De la preuve d’identité individuelle jusqu’aux agents autonomes gouvernés : chaque brique adresse une couche opérationnelle précise sans rupture ni boîte noire."
      />
      <UnifiedStackMatrix compact />
      <div class="section__footer">
        <a class="btn btn--secondary" href={href('platforms')}>
          <span>Consulter les spécifications complètes des 6 niveaux</span>
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </div>
  </section>

  <section class="section section--alt" id="luxia-key" aria-labelledby="key-showcase-title">
    <div class="wrap">
      <SectionHead
        id="key-showcase-title"
        title="LUXIA Key : compagnon d’entreprise et expérience utilisateur"
        lead="LUXIA Key accompagne la première brique de LUXIA Identity sur le terrain : authentification sans mot de passe par passkey et validation géolocalisée des connexions sensibles."
      />
      <KeyDeviceShowcase />
    </div>
  </section>

  <section class="section" id="visite" aria-labelledby="visite-title">
    <div class="wrap">
      <SectionHead
        id="visite-title"
        title="Tout le cycle de vie d’un accès, dans une seule console"
        lead="Parcourez les vues opérationnelles de LUXIA Identity : pilotage des habilitations, revues d’accès, séparation des tâches, connexion sans mot de passe et journal d’audit."
      />
      <ProductTour />
    </div>
  </section>

  <section class="section section--alt" id="cas" aria-labelledby="cas-title">
    <div class="wrap">
      <div class="head-bar">
        <SectionHead
          id="cas-title"
          title="Cinq situations opérationnelles maîtrisées dès le socle"
          lead="Arrivées, départs, accès tiers, incompatibilités métier et contrôle a posteriori : chaque règle repose sur des faits vérifiables."
        />
        <a class="more" href={href('solutions')}>
          <span>Toutes les situations</span>
          <Icon name="arrow-right" size={16} />
        </a>
      </div>

      <ol class="cases-matrix">
        {
          useCases.map((c, i) => (
            <li class="cases-matrix__item">
              <span class="cases-matrix__num">{String(i + 1).padStart(2, '0')}</span>
              <div class="cases-matrix__body">
                <h3 class="t-h4">{c.title}</h3>
                <p class="cases-matrix__sit">{c.situation}</p>
                <p class="cases-matrix__ans">{c.answer[0]}</p>
              </div>
              <div class="cases-matrix__link">
                <a class="link" href={`${href('solutions')}#${c.id}`}>
                  <span>Détails</span>
                  <Icon name="chevron-right" size={15} />
                </a>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" id="roles" aria-labelledby="roles-title">
    <div class="wrap">
      <SectionHead
        id="roles-title"
        title="Un seul système de vérité pour quatre métiers"
        lead="Chaque équipe lit la même donnée sous l’angle de sa responsabilité — sans exporter de feuilles de calcul ni perdre la source."
      />
      <ul class="roles-grid ruled">
        {
          roles.map((r) => (
            <li class="roles-grid__item">
              <p class="roles-grid__code">{r.code}</p>
              <h3 class="t-h4">{r.title}</h3>
              <p>{r.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--dark" id="confiance" aria-labelledby="confiance-title">
    <div class="wrap">
      <div class="trust-layout">
        <div class="trust-layout__intro">
          <h2 class="t-h2" id="confiance-title">Sécurité conçue pour l’inspection technique</h2>
          <p class="t-lead">
            Luxia-IT applique en production les standards d’isolation qu’elle préconise à ses clients : durcissement applicatif strict,
            télémétrie zéro-traceur et transparence totale sur l’état réel de chaque composant.
          </p>
          <div class="trust-layout__cta">
            <a class="btn btn--light" href={href('trust')}>
              <span>Consulter le dossier de confiance</span>
              <Icon name="arrow-right" size={16} />
            </a>
          </div>
        </div>

        <ul class="trust-specs">
          {
            trustMarks.map((m) => (
              <li>
                <h3>{m.label}</h3>
                <p>{m.note}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section" id="services" aria-labelledby="services-title">
    <div class="wrap">
      <div class="head-bar">
        <SectionHead
          id="services-title"
          title="Cabinet de conseil et d’ingénierie technologique"
          lead="Au-delà de nos plateformes, nos architectes et ingénieurs conçoivent, sécurisent et déploient vos solutions globales en entreprise."
        />
        <a class="more" href={href('services')}>
          <span>Explorer tous les services</span>
          <Icon name="arrow-right" size={16} />
        </a>
      </div>

      <ol class="advisory-grid ruled">
        {
          advisoryPillars.map((s) => (
            <li class="advisory-grid__item">
              <p class="advisory-grid__code">{s.code}</p>
              <h3 class="t-h4">
                <a class="advisory-grid__link" href={`${href('services')}${s.anchor}`}>
                  {s.title}
                </a>
              </h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--alt" id="ressources" aria-labelledby="ressources-title">
    <div class="wrap">
      <div class="head-bar">
        <SectionHead
          id="ressources-title"
          title="Notes techniques et guides de mise en œuvre"
          lead="Guides pragmatiques rédigés à partir de déploiements et de revues d’architecture réels."
        />
        <a class="more" href={href('resources')}>
          <span>Tous les guides</span>
          <Icon name="arrow-right" size={16} />
        </a>
      </div>

      <ul class="guides-grid ruled">
        {
          guides.slice(0, 3).map((g) => (
            <li class="guides-grid__item">
              <p class="guides-grid__meta">{readingMinutes(g)} min de lecture</p>
              <h3 class="t-h4">
                <a href={guideHref(g.slug)}>{g.title}</a>
              </h3>
              <p>{g.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBlock
    title="Évaluer un projet ou planifier une démonstration"
    text="Décrivez votre environnement — identités, réseau, infrastructure ou besoins IA — pour obtenir une étude technique ou une démonstration ciblée."
    href={demo}
    label="Demander un échange technique"
    secondary={{ href: href('platforms'), label: 'Plateforme unifiée en 6 niveaux' }}
  />
</BaseLayout>

<style>
  .hero {
    position: relative;
    padding-block: calc(var(--header-h) + clamp(32px, 5vw, 68px)) clamp(40px, 6vw, 72px);
    border-bottom: 1px solid var(--line);
  }

  .hero__stage {
    position: relative;
    overflow: hidden;
  }

  .hero__text {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    padding-bottom: clamp(32px, 5vw, 56px);
  }

  .hero__index {
    font-family: var(--mono);
    font-size: var(--fs-meta);
    letter-spacing: 0.08em;
    color: var(--link);
    padding: 4px 10px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background-color: var(--paper-2);
  }

  .hero__title {
    max-width: 18ch;
  }

  .hero__lead {
    max-width: 58ch;
  }

  .hero__actions {
    margin-top: 4px;
    align-items: center;
  }

  .section__footer {
    margin-top: 28px;
    display: flex;
    justify-content: flex-start;
  }

  .head-bar {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: clamp(24px, 3.5vw, 40px);
  }

  .head-bar :global(.shead) {
    margin-bottom: 0;
  }

  /* Matrice 5 cas d'usage */
  .cases-matrix {
    border-top: 1px solid var(--line);
  }

  .cases-matrix__item {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 14px 20px;
    padding-block: 22px;
    border-bottom: 1px solid var(--line);
    align-items: baseline;
  }

  .cases-matrix__num {
    font-family: var(--mono);
    font-size: var(--fs-meta);
    color: var(--ink-3);
  }

  .cases-matrix__body {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .cases-matrix__sit {
    font-size: var(--fs-small);
    color: var(--ink-2);
  }

  .cases-matrix__ans {
    font-size: var(--fs-small);
    color: var(--ink);
  }

  .cases-matrix__link {
    grid-column: 2;
  }

  /* Grilles Rôles & Services & Guides */
  .roles-grid,
  .advisory-grid,
  .guides-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background-color: var(--paper-2);
  }

  .roles-grid__item,
  .advisory-grid__item,
  .guides-grid__item {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: clamp(20px, 2.5vw, 28px);
    border-bottom: 1px solid var(--line);
  }

  .roles-grid__item:last-child,
  .advisory-grid__item:last-child,
  .guides-grid__item:last-child {
    border-bottom: 0;
  }

  .roles-grid__code,
  .advisory-grid__code,
  .guides-grid__meta {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--link);
  }

  .roles-grid__item p:last-child,
  .advisory-grid__item p:last-child,
  .guides-grid__item p:last-child {
    font-size: var(--fs-small);
    line-height: 1.55;
    color: var(--ink-2);
  }

  .advisory-grid__link,
  .guides-grid__item a {
    color: var(--ink);
    text-decoration: none;
  }

  .advisory-grid__link:hover,
  .guides-grid__item a:hover {
    color: var(--link);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* Section confiance sombre */
  .trust-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px var(--gap);
  }

  .trust-layout__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .trust-layout__cta {
    margin-top: 6px;
  }

  .trust-specs {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background-color: var(--paper);
  }

  .trust-specs li {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px 20px;
    border-bottom: 1px solid var(--line);
  }

  .trust-specs li:last-child {
    border-bottom: 0;
  }

  .trust-specs h3 {
    font-family: var(--display);
    font-size: var(--fs-h4);
    font-weight: 600;
    color: var(--ink);
  }

  .trust-specs p {
    font-size: var(--fs-small);
    color: var(--ink-2);
  }

  @media (min-width: 720px) {
    .head-bar {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }

    .roles-grid,
    .advisory-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .roles-grid__item,
    .advisory-grid__item {
      border-right: 1px solid var(--line);
    }

    .roles-grid__item:nth-child(2n),
    .advisory-grid__item:nth-child(2n) {
      border-right: 0;
    }

    .roles-grid__item:nth-last-child(-n + 2),
    .advisory-grid__item:nth-last-child(-n + 2) {
      border-bottom: 0;
    }

    .guides-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .guides-grid__item {
      border-bottom: 0;
      border-right: 1px solid var(--line);
    }

    .guides-grid__item:last-child {
      border-right: 0;
    }

    .trust-specs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .trust-specs li {
      border-right: 1px solid var(--line);
    }

    .trust-specs li:nth-child(2n) {
      border-right: 0;
    }

    .trust-specs li:nth-last-child(-n + 2) {
      border-bottom: 0;
    }
  }

  @media (min-width: 1024px) {
    .cases-matrix__item {
      grid-template-columns: 3.5rem minmax(0, 1fr) auto;
      align-items: start;
    }

    .cases-matrix__link {
      grid-column: auto;
    }

    .trust-layout {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
    }
  }
</style>
