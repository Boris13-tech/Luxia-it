---
/**
 * Accueil, centré sur le produit : la console de LUXIA Identity d'abord, puis
 * la visite guidée, les faits vérifiés, la sécurité et l'accompagnement.
 * Contenus : src/data/product.ts (fonctions et faits), src/data/guides.ts.
 * Aucun client, logo, chiffre d'affaires ni certification : il n'y en a pas.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductScreen from '../components/ProductScreen.astro';
import ProductTour from '../components/ProductTour.astro';
import KeyFacts from '../components/KeyFacts.astro';
import ConstellationScene from '../components/ConstellationScene.astro';
import Pictogram, { type PictogramName } from '../components/Pictogram.astro';
import CtaBlock from '../components/CtaBlock.astro';
import Icon from '../components/Icon.astro';
import { useCases } from '../data/product';
import { guideHref, guides, readingMinutes } from '../data/guides';
import { href } from '../i18n/routes';

const demo = `${href('contact')}?sujet=demo`;
// Titre découpé en mots : chacun se précise à son tour (src/styles/motion.css)
const titleWords = 'Gouvernez qui accède à quoi. Prouvez chaque décision.'.split(' ');

const roles: { title: string; text: string; picto: PictogramName; tone: 'blue' | 'terra' | 'ochre' | 'sage' }[] = [
  {
    title: 'Direction des systèmes d’information',
    text: 'Un registre unique des identités et des droits, qui ne dépend pas du fournisseur d’identité que vous utilisez aujourd’hui.',
    picto: 'screen',
    tone: 'blue',
  },
  {
    title: 'Sécurité',
    text: 'Des connexions résistantes à l’hameçonnage, des droits incompatibles bloqués à l’attribution, un journal en ajout seul.',
    picto: 'shield',
    tone: 'terra',
  },
  {
    title: 'Responsables métier',
    text: 'Des revues d’accès courtes, sur vos applications, où chaque décision tient en une justification.',
    picto: 'person',
    tone: 'ochre',
  },
  {
    title: 'Audit et conformité',
    text: 'La preuve de qui a eu accès à quoi, et de qui a décidé, sans reconstituer l’historique à la main.',
    picto: 'clipboard',
    tone: 'sage',
  },
];

const trust = [
  {
    title: 'Chaque organisation isolée par la base de données',
    text: 'Sécurité au niveau des lignes de PostgreSQL, en mode forcé. Le rôle de l’application ne peut pas la contourner.',
  },
  {
    title: 'Un opérateur sans droit chez vous',
    text: 'Luxia-IT ne détient aucun droit dans votre organisation. Une intervention d’urgence suit une liste fermée d’actions et vous est signalée.',
  },
  {
    title: 'Des sauvegardes que l’on a déjà restaurées',
    text: 'Chiffrées, hors du fournisseur de base de données, dans l’Union européenne. La restauration complète a été vérifiée en production.',
  },
];

const services = [
  { title: 'Cadrage et architecture', text: 'Inventaire des identités et des accès, risques, architecture cible.', anchor: '#cadrage' },
  { title: 'Intégration et migration', text: 'Connexion de vos fournisseurs, recette avec vos équipes, migration par lots avec retour arrière.', anchor: '#integration' },
  { title: 'Exploitation et sécurité', text: 'Procédures, sauvegardes vérifiées, revue des accès à privilèges, dans la durée.', anchor: '#exploitation' },
];
---

<BaseLayout
  title="Gouvernance des identités et des accès"
  description="LUXIA Identity : identités, cycle de vie, revues d’accès, séparation des tâches et journal d’audit en ajout seul. Connexion par Microsoft Entra ID ou par clé d’accès. Bêta privée en préparation."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__stage">
      <ConstellationScene variant="identity" />
      <div class="wrap hero__text">
        <p class="hero__badge"><span class="hero__badge-dot" aria-hidden="true"></span> LUXIA Identity · bêta privée en préparation, sur invitation</p>
        <h1 class="t-display hero__title" id="hero-title">
          {titleWords.map((w, i) => <>{i > 0 && ' '}<span class="hero__word">{w}</span></>)}
        </h1>
        <p class="t-lead hero__lead">
          LUXIA Identity réunit les personnes, les comptes et les droits de votre organisation dans un seul registre : arrivées et
          départs, revues d’accès, séparation des tâches et journal d’audit que personne ne peut réécrire.
        </p>
        <div class="actions hero__actions">
          <a class="btn btn--primary" href={demo}>
            Demander une démonstration
            <Icon name="arrow-right" size={18} />
          </a>
          <a class="btn btn--secondary" href="#visite">Visiter le produit</a>
        </div>
      </div>
    </div>
    <div class="wrap">
      <ProductScreen
        screen="overview"
        hero
        class="hero__screen"
        caption="La vue d’ensemble d’une organisation : les points à traiter, les accès en vigueur et la gouvernance."
      />
    </div>
  </section>

  <KeyFacts />

  <section class="section" id="visite" aria-labelledby="visite-title">
    <div class="wrap">
      <div class="head">
        <p class="kicker">Visite du produit</p>
        <h2 class="t-h2" id="visite-title">Tout le cycle de vie d’un accès, dans une seule console</h2>
        <p class="t-lead">De l’arrivée d’une personne à son départ : ses droits, leurs revues, les conflits évités et la trace de chaque décision.</p>
      </div>
      <ProductTour />
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="cas-title">
    <div class="wrap">
      <div class="head head--row">
        <div>
          <p class="kicker">Solutions</p>
          <h2 class="t-h2" id="cas-title">Cinq situations que LUXIA Identity règle</h2>
        </div>
        <a class="more" href={href('solutions')}>
          Toutes les solutions
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
      <ul class="cases">
        {
          useCases.map((c) => (
            <li class="case">
              <h3 class="case__title">
                <a href={`${href('solutions')}#${c.id}`}>{c.title}</a>
              </h3>
              <p class="case__text">{c.situation}</p>
              <span class="case__more" aria-hidden="true">
                <Icon name="arrow-right" size={16} />
              </span>
            </li>
          ))
        }
        <li class="case case--ask">
          <h3 class="case__title">
            <a href={demo}>Une autre situation ?</a>
          </h3>
          <p class="case__text">Décrivez-nous la vôtre : nous vous dirons si LUXIA Identity y répond, et sinon, ce que nous recommandons.</p>
          <span class="case__more" aria-hidden="true">
            <Icon name="arrow-right" size={16} />
          </span>
        </li>
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="roles-title">
    <div class="wrap">
      <div class="head">
        <p class="kicker">Pour qui</p>
        <h2 class="t-h2" id="roles-title">Une même console, quatre façons de s’en servir</h2>
      </div>
      <ul class="ruled ruled--4 roles">
        {
          roles.map((r) => (
            <li>
              <Pictogram name={r.picto} tone={r.tone} />
              <h3 class="ruled__title">{r.title}</h3>
              <p class="ruled__text">{r.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--dark" aria-labelledby="confiance-title">
    <div class="wrap trust">
      <div class="trust__intro">
        <p class="kicker kicker--dark">Sécurité</p>
        <h2 class="t-h2" id="confiance-title">Conçue pour être auditée, à commencer par nous</h2>
        <p class="trust__lead">
          Une plateforme d’identité ne vaut que si l’on peut vérifier ce qu’elle affirme. Architecture, hébergement, sauvegardes et
          limites actuelles : tout est décrit dans le centre de confiance.
        </p>
        <a class="btn btn--light" href={href('trust')}>
          Ouvrir le centre de confiance
          <Icon name="arrow-right" size={18} />
        </a>
      </div>
      <ul class="trust__list">
        {
          trust.map((t) => (
            <li>
              <h3 class="trust__title">{t.title}</h3>
              <p>{t.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="services-title">
    <div class="wrap">
      <div class="head head--row">
        <div>
          <p class="kicker">Accompagnement</p>
          <h2 class="t-h2" id="services-title">Nous déployons avec vous, et nous restons</h2>
        </div>
        <a class="more" href={href('services')}>
          Nos services
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
      <ul class="ruled ruled--3">
        {
          services.map((s) => (
            <li>
              <h3 class="ruled__title">
                <a class="svc-link" href={`${href('services')}${s.anchor}`}>
                  {s.title}
                </a>
              </h3>
              <p class="ruled__text">{s.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="ressources-title">
    <div class="wrap">
      <div class="head head--row">
        <div>
          <p class="kicker">Ressources</p>
          <h2 class="t-h2" id="ressources-title">Guides pratiques</h2>
        </div>
        <a class="more" href={href('resources')}>
          Toutes les ressources
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
      <ul class="guides">
        {
          guides.map((g) => (
            <li class="guide">
              <p class="guide__meta">
                {g.topic} · {readingMinutes(g)} min de lecture
              </p>
              <h3 class="guide__title">
                <a href={guideHref(g.slug)}>{g.title}</a>
              </h3>
              <p class="guide__text">{g.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBlock
    title="Voyez LUXIA Identity sur vos propres cas"
    text="Une démonstration sur vos situations réelles : arrivées et départs, revues d’accès, séparation des tâches. Nous vous disons aussi ce que la plateforme ne fait pas encore."
    href={demo}
    label="Demander une démonstration"
    secondary={{ href: href('identity'), label: 'Découvrir le produit' }}
  />
</BaseLayout>

<style>
  .hero {
    position: relative;
    margin-top: calc(var(--header-h) * -1);
    padding-bottom: clamp(48px, 6vw, 88px);
  }

  /* Scène : la constellation occupe toute la tête de page, sous l'en-tête */
  .hero__stage {
    position: relative;
    display: grid;
    align-items: end;
    min-height: clamp(600px, 92svh, 880px);
    padding-top: calc(var(--header-h) + 48px);
    padding-bottom: clamp(40px, 6vw, 72px);
  }

  .hero__text {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px 6px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    font-size: var(--fs-meta);
    font-weight: 500;
    color: var(--ink-2);
  }

  .hero__badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ochre);
    box-shadow: 0 0 0 4px var(--ochre-tint);
  }

  .hero__title {
    max-width: 15ch;
  }

  .hero__word {
    display: inline-block;
  }

  .hero__lead {
    max-width: 44rem;
  }

  .hero__actions {
    margin-top: 4px;
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 48rem;
    margin-bottom: clamp(32px, 4vw, 48px);
  }

  .head--row {
    max-width: none;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px 32px;
  }

  .head--row > div {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 44rem;
  }

  .cases {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }

  .case {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px 24px 52px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition:
      border-color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  .case:hover {
    border-color: var(--blue-light);
    box-shadow: 0 14px 30px -20px rgb(23 33 49 / 0.35);
  }

  .case--ask {
    background: var(--tint-blue);
    border-color: var(--blue-tint);
  }

  .case__title {
    font-size: var(--fs-h4);
    line-height: 1.3;
  }

  /* Toute la carte est cliquable, le lien reste le titre */
  .case__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .case__title a:focus-visible {
    outline: none;
  }

  .case:has(a:focus-visible) {
    outline: 2px solid var(--blue);
    outline-offset: 2px;
  }

  .case__text {
    font-size: var(--fs-small);
    color: var(--ink-2);
  }

  .case__more {
    position: absolute;
    left: 24px;
    bottom: 20px;
    color: var(--blue);
  }

  .roles > li {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }

  .roles :global(.picto) {
    margin-bottom: 10px;
  }

  .trust {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px var(--gap);
  }

  .trust__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .trust__intro h2 {
    color: var(--on-dark);
  }

  .trust__lead {
    color: var(--on-dark-2);
  }

  .trust__list {
    display: grid;
    gap: 0;
  }

  .trust__list li {
    padding-block: 22px;
    border-top: 1px solid var(--on-dark-line);
    color: var(--on-dark-2);
  }

  .trust__list li:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .trust__title {
    margin-bottom: 6px;
    font-size: var(--fs-h4);
    line-height: 1.3;
    color: var(--on-dark);
  }

  .svc-link {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 4px;
  }

  .svc-link:hover {
    color: var(--link);
    text-decoration-color: currentColor;
  }

  .guides {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }

  .guide {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .guide__meta {
    font-size: var(--fs-meta);
    font-weight: 500;
    color: var(--electric);
  }

  .guide__title {
    font-size: var(--fs-h4);
    line-height: 1.3;
  }

  .guide__title a:hover {
    color: var(--link);
  }

  .guide__text {
    font-size: var(--fs-small);
    color: var(--ink-2);
  }

  @media (min-width: 720px) {
    .cases {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .cases {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .guides {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .trust {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
    }
  }
</style>
