---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductScreen from '../components/ProductScreen.astro';
import ProductTour from '../components/ProductTour.astro';
import KeyFacts from '../components/KeyFacts.astro';
import ConstellationScene from '../components/ConstellationScene.astro';
import UnifiedStackMatrix from '../components/UnifiedStackMatrix.astro';
import KeyDeviceShowcase from '../components/KeyDeviceShowcase.astro';
import HumanScene from '../components/HumanScene.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaBlock from '../components/CtaBlock.astro';
import Icon from '../components/Icon.astro';
import { useCases } from '../data/product';
import { guideHref, guides, readingMinutes } from '../data/guides';
import { href } from '../i18n/routes';

const demo = `${href('contact')}?sujet=demo`;

const roles = [
  {
    title: 'Direction des systèmes d’information',
    text: 'Un registre unique des identités, des droits et des dépendances applicatives, découplé d’un fournisseur unique et déployable selon vos contraintes d’hébergement.',
  },
  {
    title: 'Sécurité et gouvernance Zero Trust',
    text: 'Connexions par passkeys résistantes au phishing, blocage natif des attributions incompatibles (SoD), validation hors bande via LUXIA Key et journal en ajout seul.',
  },
  {
    title: 'Exploitation système, DevSecOps et agents IA',
    text: 'Automatisation de l’enrôlement et des révocations, gouvernance explicite des outils exposés aux agents ALMA et contrôle humain sur chaque action sensible.',
  },
  {
    title: 'Audit, conformité et responsables métier',
    text: 'Revues d’accès lisibles en quelques secondes et piste forensique reliant identité, politique appliquée, décision d’approbation et horodatage.',
  },
] as const;

const trustMarks = [
  { label: 'CSP stricte sans script en ligne', note: 'Zéro cookie publicitaire, zéro traceur tiers, zéro stockage navigateur' },
  { label: 'Authentification résistante au phishing', note: 'Passkeys WebAuthn / FIDO2 et compagnon applicatif LUXIA Key' },
  { label: 'Journal en ajout seul', note: 'L’application ne peut ni altérer ni effacer l’historique d’audit' },
  { label: 'Répartition explicite des responsabilités', note: 'Déploiement managé, sur site client ou périmètre souverain isolé' },
] as const;

const advisoryPillars = [
  {
    title: 'Cybersécurité et gouvernance des identités',
    text: 'Audit de maturité IAM, structuration Microsoft Entra ID, accès conditionnel, PIM/PAM, séparation des tâches et passage au sans-mot-de-passe.',
    anchor: '#cadrage',
  },
  {
    title: 'Architecture Cloud souverain et réseau critique',
    text: 'Conception de Landing Zones Microsoft Azure, segmentation Hub-Spoke, Private Link, DNS hybride, plans de reprise et maîtrise FinOps.',
    anchor: '#architecture',
  },
  {
    title: 'Ingénierie logicielle et usines DevSecOps',
    text: 'Industrialisation Bicep/Terraform, pipelines CI/CD fédérés sans secrets statiques (OIDC), durcissement Windows/Linux et automatisation d’exploitation.',
    anchor: '#integration',
  },
  {
    title: 'Systèmes d’IA d’entreprise sous contrôle',
    text: 'Déploiement d’architectures RAG et d’agents outillés avec identités dédiées, filtrage des flux, approbation humaine et traçabilité complète.',
    anchor: '#securite-operationnelle',
  },
] as const;

const worldChapters = [
  { world: 'command', href: '#hero-title', label: '01 Commande' },
  { world: 'architecture', href: '#stack-title', label: '02 Architecture' },
  { world: 'key-studio', href: '#key-showcase-title', label: '03 LUXIA Key' },
  { world: 'workbench', href: '#visite-title', label: '04 Opérations' },
  { world: 'vault', href: '#confiance-title', label: '05 Confiance' },
  { world: 'advisory', href: '#services-title', label: '06 Conseil' },
] as const;
---

<BaseLayout
  title="Plateforme unifiée de sécurité, identité et IA"
  description="Plateforme unifiée LUXIA en six niveaux : identités souveraines, LUXIA Key, gouvernance IA et cabinet d’ingénierie cybersécurité, cloud et DevSecOps."
  world="command"
>
  <nav class="world-rail" aria-label="Chapitres visuels de la page">
    {
      worldChapters.map((c, i) => (
        <a href={c.href} data-world-link={c.world} aria-current={i === 0 ? 'true' : undefined}>
          <span class="world-rail__label">{c.label}</span>
          <span class="world-rail__dot" aria-hidden="true"></span>
        </a>
      ))
    }
  </nav>

  <!-- Monde 01 : Centre de commande identitaire -->
  <section class="hero" data-world-section="command" aria-labelledby="hero-title">
    <div class="hero__stage">
      <ConstellationScene variant="identity" />
      <div class="wrap hero__text">
        <h1 class="t-display hero__title" id="hero-title">
          Sécurité critique, identités souveraines et systèmes d’IA sous contrôle.
        </h1>
        <p class="t-lead hero__lead">
          Luxia-IT conçoit la plateforme unifiée LUXIA en six niveaux, de LUXIA Identity et LUXIA Key jusqu’à la gouvernance
          des agents IA. Notre cabinet d’architecture et d’ingénierie accompagne également les organisations en cybersécurité,
          infrastructure cloud et intelligence artificielle.
        </p>
        <div class="actions hero__actions">
          <a class="btn btn--primary" href={demo}>
            <span>Demander un échange</span>
            <Icon name="arrow-right" size={18} />
          </a>
          <a class="btn btn--secondary" href="#stack">Explorer les six niveaux</a>
          <a class="link" href={href('services')}>
            <span>Découvrir le cabinet de conseil</span>
            <Icon name="chevron-right" size={16} />
          </a>
        </div>
      </div>
    </div>

    <div class="wrap">
      <ProductScreen
        screen="overview"
        hero
        class="hero__screen"
        caption="Console d’administration LUXIA Identity : synthèse des risques actifs, habilitations en vigueur et contrôle d’audit."
      />
    </div>
  </section>

  <div data-world-section="command">
    <KeyFacts />
  </div>

  <!-- Monde 02 : Blueprint Architectural en 6 Niveaux -->
  <section class="world" data-world-section="architecture" id="stack" aria-labelledby="stack-title">
    <div class="wrap world__stage">
      <div class="world__threshold">
        <span class="world__code">Monde 02 · Architecture</span>
        <span>Plateforme unifiée en six niveaux</span>
      </div>
      <SectionHead
        id="stack-title"
        title="La plateforme unifiée LUXIA en six niveaux d’architecture"
        lead="De la preuve d’identité individuelle jusqu’aux agents autonomes gouvernés : chaque brique couvre une couche opérationnelle précise sans boîte noire."
      />
      <UnifiedStackMatrix compact />
      <div class="section__footer">
        <a class="btn btn--secondary" href={href('platforms')}>
          <span>Consulter les spécifications complètes des 6 niveaux</span>
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </div>
  </section>

  <!-- Monde 03 : Studio Matériel Clair Apple (LUXIA Key) -->
  <section class="world" data-world-section="key-studio" id="luxia-key" aria-labelledby="key-showcase-title">
    <div class="wrap world__stage">
      <div class="world__threshold">
        <span class="world__code">Monde 03 · Identité matérielle</span>
        <span>Studio LUXIA Key · Connexion et approbation sur le terrain</span>
      </div>
      <SectionHead
        id="key-showcase-title"
        title="LUXIA Key : compagnon d’entreprise et expérience utilisateur"
        lead="LUXIA Key accompagne la première brique de LUXIA Identity sur le terrain : authentification sans mot de passe par passkey et validation géolocalisée des connexions sensibles."
      />
      <KeyDeviceShowcase />
    </div>
  </section>

  <!-- Monde 04 : Atelier d'Exploitation Quotidienne -->
  <section class="world" data-world-section="workbench" id="visite" aria-labelledby="visite-title">
    <div class="wrap world__stage">
      <div class="world__threshold">
        <span class="world__code">Monde 04 · Exploitation</span>
        <span>Cycle de vie des accès, situations métier et responsabilités</span>
      </div>
      <SectionHead
        id="visite-title"
        title="Tout le cycle de vie d’un accès, dans une seule console"
        lead="Parcourez les vues opérationnelles de LUXIA Identity : pilotage des habilitations, revues d’accès, séparation des tâches, connexion sans mot de passe et journal d’audit."
      />
      <ProductTour />

      <div class="world__band" id="cas">
        <div class="head-bar">
          <SectionHead
            id="cas-title"
            title="Cinq situations opérationnelles maîtrisées dès le socle"
            lead="Arrivées, départs, accès tiers, incompatibilités métier et contrôle a posteriori : chaque règle repose sur des faits vérifiables."
          />
          <a class="more" href={href('solutions')}>
            <span>Toutes les situations</span>
            <Icon name="arrow-right" size={16} />
          </a>
        </div>

        <ol class="cases-matrix">
          {
            useCases.map((c, i) => (
              <li class="cases-matrix__item">
                <span class="cases-matrix__num">{String(i + 1).padStart(2, '0')}</span>
                <div class="cases-matrix__body">
                  <h3 class="t-h4">{c.title}</h3>
                  <p class="cases-matrix__sit">{c.situation}</p>
                  <p class="cases-matrix__ans">{c.answer[0]}</p>
                </div>
                <div class="cases-matrix__link">
                  <a class="link" href={`${href('solutions')}#${c.id}`}>
                    <span>Détails</span>
                    <Icon name="chevron-right" size={15} />
                  </a>
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="world__band" id="roles">
        <SectionHead
          id="roles-title"
          title="Un seul système de vérité pour quatre métiers"
          lead="Cliquez sur votre rôle pour voir immédiatement ce que la plateforme vous apporte."
        />
        <ul class="flip-grid flip-grid--2">
          {
            roles.map((r, i) => (
              <li class="flip-card" data-flip-card data-flipped="false">
                <div class="flip-card__inner">
                  <div class="flip-card__face flip-card__face--front">
                    <span class="role-card__num">0{i + 1}</span>
                    <h3 class="t-h4">{r.title}</h3>
                    <button type="button" class="flip-card__hint" data-flip-trigger aria-expanded="false">
                      <span>Voir ce que cela change pour ce métier</span>
                      <Icon name="arrow-right" size={14} stroke={1.8} />
                    </button>
                  </div>
                  <div class="flip-card__face flip-card__face--back">
                    <h3 class="t-h4">{r.title}</h3>
                    <p class="role-card__text">{r.text}</p>
                    <button type="button" class="flip-card__hint flip-card__hint--back" aria-label={`Retourner ${r.title}`}>
                      <span>Revenir</span>
                    </button>
                  </div>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Monde 05 : Coffre Cryptographique & Audit -->
  <section class="world" data-world-section="vault" id="confiance" aria-labelledby="confiance-title">
    <div class="wrap world__stage">
      <div class="world__threshold">
        <span class="world__code">Monde 05 · Preuves et contrôle</span>
        <span>Durcissement matériel, isolation et vérifications publiées</span>
      </div>

      <div class="trust-human">
        <HumanScene
          src="/images/phase-vault-audit.jpg"
          alt="Un ingénieur systèmes insère une clé de sécurité matérielle sur un poste d’administration dans une salle serveurs sécurisée."
          chapter="Contrôle physique et logique"
          phaseTitle="Ce que la plateforme promet doit pouvoir être vérifié sur pièces"
          caption="Isolation par ligne PostgreSQL, sauvegardes chiffrées hors du fournisseur principal avec restauration chronométrée et politique stricte sans traceur."
          layout="split"
          focal="top"
        />
      </div>

      <div class="trust-layout">
        <div class="trust-layout__intro">
          <h2 class="t-h2" id="confiance-title">Sécurité conçue pour l’inspection technique</h2>
          <p class="t-lead">
            Luxia-IT applique en production les standards d’isolation qu’elle préconise à ses clients : durcissement applicatif strict,
            télémétrie zéro traceur et transparence totale sur l’état réel de chaque composant.
          </p>
          <div class="trust-layout__cta">
            <a class="btn btn--light" href={href('trust')}>
              <span>Consulter le dossier de confiance</span>
              <Icon name="arrow-right" size={16} />
            </a>
          </div>
        </div>

        <ul class="trust-specs">
          {
            trustMarks.map((m) => (
              <li>
                <h3>{m.label}</h3>
                <p>{m.note}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Monde 06 : Cabinet de Conseil & Ingénierie -->
  <section class="world" data-world-section="advisory" id="services" aria-labelledby="services-title">
    <div class="wrap world__stage">
      <div class="world__threshold">
        <span class="world__code">Monde 06 · Conseil et architecture</span>
        <span>Accompagnement terrain de la conception jusqu’à la mise en production</span>
      </div>

      <div class="advisory-human">
        <HumanScene
          src="/images/phase-advisory-studio.jpg"
          alt="Deux architectes principaux analysent ensemble des schémas techniques et des dossiers d’architecture dans un bureau vitré."
          chapter="Ingénierie et conseil"
          phaseTitle="Des architectes qui conçoivent, rédigent et déploient à vos côtés"
          caption="Chaque mission s’appuie sur un cadrage chiffré, une architecture vérifiée en revue par les pairs et un passage en production documenté."
          layout="wide"
          focal="top"
          ctaHref={href('services')}
          ctaLabel="Explorer tous les services"
        />
      </div>

      <div class="head-bar">
        <SectionHead
          id="services-title"
          title="Cabinet de conseil et d’ingénierie technologique"
          lead="Cliquez sur un pôle pour afficher nos livrables concrets et accéder à l’offre."
        />
      </div>

      <ul class="flip-grid flip-grid--2">
        {
          advisoryPillars.map((s) => (
            <li class="flip-card" data-flip-card data-flipped="false">
              <div class="flip-card__inner">
                <div class="flip-card__face flip-card__face--front">
                  <h3 class="t-h4">{s.title}</h3>
                  <button type="button" class="flip-card__hint" data-flip-trigger aria-expanded="false">
                    <span>Retourner pour voir l’intervention</span>
                    <Icon name="arrow-right" size={14} stroke={1.8} />
                  </button>
                </div>
                <div class="flip-card__face flip-card__face--back">
                  <h3 class="t-h4">{s.title}</h3>
                  <p class="role-card__text">{s.text}</p>
                  <div class="advisory-card__foot">
                    <a class="link" href={`${href('services')}${s.anchor}`}>
                      <span>Détails du pôle</span>
                      <Icon name="arrow-right" size={14} stroke={1.8} />
                    </a>
                    <button type="button" class="flip-card__hint flip-card__hint--back" aria-label={`Retourner ${s.title}`}>
                      <span>Revenir</span>
                    </button>
                  </div>
                </div>
              </div>
            </li>
          ))
        }
      </ul>

      <div class="world__band" id="ressources">
        <div class="head-bar">
          <SectionHead
            id="ressources-title"
            title="Notes techniques et guides de mise en œuvre"
            lead="Guides pragmatiques rédigés à partir de déploiements et de revues d’architecture réels."
          />
          <a class="more" href={href('resources')}>
            <span>Tous les guides</span>
            <Icon name="arrow-right" size={16} />
          </a>
        </div>

        <ul class="guides-list ruled">
          {
            guides.slice(0, 3).map((g) => (
              <li class="guides-list__item">
                <p class="guides-list__meta">{readingMinutes(g)} min de lecture</p>
                <h3 class="t-h4">
                  <a href={guideHref(g.slug)}>{g.title}</a>
                </h3>
                <p>{g.description}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <div data-world-section="advisory">
    <CtaBlock
      title="Évaluer un projet ou planifier une démonstration"
      text="Décrivez votre environnement (identités, réseau, infrastructure ou besoins IA) pour obtenir une étude technique ou une démonstration ciblée."
      href={demo}
      label="Demander un échange technique"
      secondary={{ href: href('platforms'), label: 'Plateforme unifiée en 6 niveaux' }}
    />
  </div>
</BaseLayout>

<style>
  .hero {
    position: relative;
    padding-block: calc(var(--header-h) + clamp(32px, 4.8vw, 68px)) clamp(40px, 6vw, 72px);
    background-color: var(--paper);
    color: var(--ink);
  }

  .hero__stage {
    position: relative;
    overflow: hidden;
  }

  .hero__text {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
    padding-bottom: clamp(32px, 5vw, 56px);
  }

  .hero__title {
    max-width: 18ch;
  }

  .hero__lead {
    max-width: 58ch;
  }

  .hero__actions {
    margin-top: 6px;
    align-items: center;
    gap: 12px 18px;
  }

  .world__band {
    margin-top: clamp(48px, 7vw, 88px);
    padding-top: clamp(36px, 5vw, 64px);
    border-top: 1px solid var(--line);
  }

  .trust-human,
  .advisory-human {
    margin-bottom: clamp(32px, 4.5vw, 56px);
    padding-bottom: clamp(24px, 3.5vw, 42px);
    border-bottom: 1px solid var(--line);
  }

  .section__footer {
    margin-top: 28px;
    display: flex;
    justify-content: flex-start;
  }

  .head-bar {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: clamp(24px, 3.5vw, 40px);
  }

  .head-bar :global(.shead) {
    margin-bottom: 0;
  }

  .cases-matrix,
  .roles-list,
  .advisory-list,
  .guides-list,
  .trust-specs {
    border-top: 1px solid var(--line);
  }

  .cases-matrix__item {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 14px 20px;
    padding-block: 22px;
    border-bottom: 1px solid var(--line);
    align-items: baseline;
  }

  .cases-matrix__num {
    font-family: var(--mono);
    font-size: var(--fs-meta);
    color: var(--ink-3);
  }

  .cases-matrix__body {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .cases-matrix__sit {
    font-size: var(--fs-small);
    color: var(--ink-2);
  }

  .cases-matrix__ans {
    font-size: var(--fs-small);
    color: var(--ink);
  }

  .cases-matrix__link {
    grid-column: 2;
  }

  .roles-list,
  .advisory-list,
  .guides-list,
  .trust-specs {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0 var(--gap);
  }

  .roles-list__item,
  .advisory-list__item,
  .guides-list__item,
  .trust-specs li {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-block: clamp(20px, 2.6vw, 28px);
    border-bottom: 1px solid var(--line);
  }

  .guides-list__meta {
    font-family: var(--mono);
    font-size: var(--fs-meta);
    color: var(--ink-3);
  }

  .roles-list__item p:last-child,
  .advisory-list__item p:last-child,
  .guides-list__item p:last-child,
  .trust-specs p {
    font-size: var(--fs-small);
    line-height: 1.55;
    color: var(--ink-2);
  }

  .advisory-list__link,
  .guides-list__item a {
    color: var(--ink);
    text-decoration: none;
  }

  .advisory-list__link:hover,
  .guides-list__item a:hover {
    color: var(--link);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .role-card__num {
    font-family: var(--mono);
    font-size: var(--fs-meta);
    color: var(--link);
    font-weight: 600;
  }

  .role-card__text {
    font-size: var(--fs-small);
    line-height: 1.55;
    color: var(--ink-2);
  }

  .advisory-card__foot {
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .advisory-card__foot .flip-card__hint {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  .trust-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px var(--gap);
  }

  .trust-layout__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .trust-layout__cta {
    margin-top: 6px;
  }

  .trust-specs h3 {
    font-family: var(--display);
    font-size: var(--fs-h4);
    font-weight: 600;
    color: var(--ink);
  }

  @media (min-width: 720px) {
    .head-bar {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }

    .roles-list,
    .advisory-list,
    .trust-specs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .guides-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .cases-matrix__item {
      grid-template-columns: 3.5rem minmax(0, 1fr) auto;
      align-items: start;
    }

    .cases-matrix__link {
      grid-column: auto;
    }

    .role-card__num {
    font-family: var(--mono);
    font-size: var(--fs-meta);
    color: var(--link);
    font-weight: 600;
  }

  .role-card__text {
    font-size: var(--fs-small);
    line-height: 1.55;
    color: var(--ink-2);
  }

  .advisory-card__foot {
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .advisory-card__foot .flip-card__hint {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  .trust-layout {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
    }
  }
</style>
