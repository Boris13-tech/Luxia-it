---
/**
 * Divulgation responsable, alignée sur /.well-known/security.txt (même
 * adresse de contact, même page de politique). Adresse dédiée :
 * facts.contact.securityEmail si elle existe, sinon l'adresse de contact.
 * Périmètre vérifié le 24 octobre 2026 : les dépôts de code de LUXIA Identity
 * (Boris13-tech/iam-azure-pme), LUXIA Key (Boris13-tech/Luxia-key) et ALMA
 * (Boris13-tech/alma) sont publics sur GitHub.
 * Délais, récompense, règle de crédit et clause de bonne foi : à valider
 * (docs/suivi-contenus.md) ; rien de plus n'est promis ici.
 */
import LegalLayout from '../layouts/LegalLayout.astro';
import { facts } from '../data/facts';

const address = facts.contact.securityEmail ?? facts.contact.email;
const reportHref = `mailto:${address}?subject=${encodeURIComponent('[Sécurité] Signalement')}`;
---

<LegalLayout
  title="Divulgation responsable"
  kicker="Sécurité"
  description="Signaler une vulnérabilité affectant le site luxia-it.com ou les plateformes de Luxia-IT : adresse, informations utiles, règles et engagements."
  lead="Vous pensez avoir trouvé une vulnérabilité dans ce site ou dans l’une de nos plateformes ? Écrivez-nous avant toute publication."
  updated="2026-10-24"
  toc={[
    { id: 'signaler', label: 'Signaler' },
    { id: 'perimetre', label: 'Périmètre' },
    { id: 'regles', label: 'Règles' },
    { id: 'engagements', label: 'Nos engagements' },
    { id: 'security-txt', label: 'Format standard' },
    { id: 'historique', label: 'Historique des versions' },
  ]}
  history={[
    { date: '2026-10-24', text: 'Périmètre précisé (code source publié sur GitHub) ; sommaire et historique.' },
    { date: '2026-10-23', text: 'Première version.' },
  ]}
>
  <h2 id="signaler">Signaler</h2>
  <p>
    Écrivez à <a href={reportHref}>{address}</a>{!facts.contact.securityEmail && <>, avec l’objet « [Sécurité] »</>}. Indiquez
    :
  </p>
  <ul>
    <li>le produit, la version ou l’adresse concernés ;</li>
    <li>la vulnérabilité et son impact ;</li>
    <li>les étapes qui permettent de la reproduire.</li>
  </ul>
  <p>N’envoyez pas de données personnelles de tiers que vous auriez pu obtenir : décrivez-les.</p>

  <h2 id="perimetre">Périmètre</h2>
  <ul>
    <li>Le site luxia-it.com.</li>
    <li>
      Les plateformes LUXIA Identity, LUXIA Key et ALMA, y compris leur code source publié sur GitHub (compte
      Boris13-tech).
    </li>
  </ul>

  <h2 id="regles">Règles</h2>
  <ul>
    <li>N’accédez pas à des données qui ne vous appartiennent pas au-delà de ce qui est nécessaire pour démontrer la vulnérabilité.</li>
    <li>Ne dégradez pas la disponibilité des services ; n’utilisez ni ingénierie sociale ni attaque physique.</li>
    <li>Laissez-nous le temps de corriger avant toute publication.</li>
  </ul>

  <h2 id="engagements">Nos engagements</h2>
  <p>
    Nous accusons réception de chaque signalement, nous vous tenons informé de son traitement et, si vous le souhaitez,
    nous vous créditons une fois la correction publiée.
  </p>

  <h2 id="security-txt">Format standard</h2>
  <p>
    Ces informations sont aussi publiées au format standard (RFC 9116) dans{' '}
    <a href="/.well-known/security.txt">/.well-known/security.txt</a>.
  </p>
</LegalLayout>
