---
/**
 * Contact. Le formulaire fonctionne sans JavaScript (envoi classique, page de
 * résultat) ; le script ajoute la validation accessible, l'envoi sans
 * rechargement et le repli si le traitement est indisponible.
 * Listes et limites partagées avec le traitement serveur (api/contact.ts).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import { DEPLOYMENTS, LIMITS, SUBJECTS } from '../../api/contact.ts';
import { facts } from '../data/facts';
import { href } from '../i18n/routes';

const { email, phone, phoneHref, responseTime } = facts.contact;
---

<BaseLayout
  title="Contact"
  description="Écrire à Luxia-IT : échange de cadrage, présentation de LUXIA Identity, LUXIA Key ou ALMA, services. E-mail, téléphone et formulaire."
  crumbs={[{ label: 'Contact' }]}
>
  <PageHead
    crumbs={[{ label: 'Contact' }]}
    kicker="Contact"
    title="Écrire à Luxia-IT"
    lead="Décrivez votre contexte : fournisseurs d’identité, applications, contraintes de déploiement. Nous répondons à l’adresse que vous indiquez."
  />

  <section class="section" aria-label="Coordonnées et formulaire">
    <div class="wrap contact">
      <aside class="contact__info" aria-labelledby="coordonnees-title">
        <h2 class="t-h3" id="coordonnees-title">Coordonnées</h2>
        <dl class="contact__list">
          <div>
            <dt class="kicker">E-mail</dt>
            <dd><a class="contact__value" href={`mailto:${email}`}><Icon name="mail" size={18} /> {email}</a></dd>
          </div>
          <div>
            <dt class="kicker">Téléphone</dt>
            <dd><a class="contact__value" href={phoneHref}><Icon name="phone" size={18} /> {phone}</a></dd>
          </div>
          {
            responseTime && (
              <div>
                <dt class="kicker">Délai de réponse</dt>
                <dd>{responseTime}</dd>
              </div>
            )
          }
          <div>
            <dt class="kicker">Sécurité</dt>
            <dd>
              Pour signaler une vulnérabilité :{' '}
              <a class="link" href={href('security')}>divulgation responsable</a>.
            </dd>
          </div>
        </dl>
      </aside>

      <div class="contact__form">
        <div class="notice" data-fallback hidden tabindex="-1">
          <p class="notice__title">Le formulaire est momentanément indisponible.</p>
          <p>
            Écrivez-nous à <a class="link" href={`mailto:${email}`}>{email}</a> ou appelez le{' '}
            <a class="link" href={phoneHref}>{phone}</a>.
          </p>
        </div>

        <div class="notice notice--ok" data-success hidden tabindex="-1">
          <p class="notice__title">Votre message a été transmis.</p>
          <p>Nous vous répondrons à l’adresse indiquée. Rien n’est conservé par le site.</p>
        </div>

        <form class="form" method="post" action="/api/contact" data-contact-form aria-labelledby="form-title">
          <h2 class="t-h3" id="form-title">Formulaire</h2>
          <p class="t-small">Tous les champs sont obligatoires, sauf mention « facultatif ».</p>

          <div class="summary" role="alert" tabindex="-1" data-summary hidden>
            <p class="summary__title">Le formulaire contient des erreurs :</p>
            <ul data-summary-list></ul>
          </div>

          <div class="form__grid">
            <div class="field">
              <label for="nom">Nom et prénom</label>
              <input id="nom" name="nom" type="text" autocomplete="name" required minlength={LIMITS.nom[0]} maxlength={LIMITS.nom[1]} aria-describedby="nom-err" />
              <p class="field__error" id="nom-err" data-error-for="nom" hidden></p>
            </div>
            <div class="field">
              <label for="organisation">Organisation</label>
              <input id="organisation" name="organisation" type="text" autocomplete="organization" required minlength={LIMITS.organisation[0]} maxlength={LIMITS.organisation[1]} aria-describedby="organisation-err" />
              <p class="field__error" id="organisation-err" data-error-for="organisation" hidden></p>
            </div>
            <div class="field">
              <label for="fonction">Fonction <span class="opt">(facultatif)</span></label>
              <input id="fonction" name="fonction" type="text" autocomplete="organization-title" maxlength={LIMITS.fonction[1]} aria-describedby="fonction-err" />
              <p class="field__error" id="fonction-err" data-error-for="fonction" hidden></p>
            </div>
            <div class="field">
              <label for="email">E-mail professionnel</label>
              <input id="email" name="email" type="email" autocomplete="email" required maxlength={LIMITS.email[1]} aria-describedby="email-hint email-err" />
              <p class="field__hint" id="email-hint">Nous vous répondrons à cette adresse.</p>
              <p class="field__error" id="email-err" data-error-for="email" hidden></p>
            </div>
            <div class="field">
              <label for="sujet">Sujet</label>
              <select id="sujet" name="sujet" required aria-describedby="sujet-err">
                {Object.entries(SUBJECTS).map(([value, label]) => <option value={value}>{label}</option>)}
              </select>
              <p class="field__error" id="sujet-err" data-error-for="sujet" hidden></p>
            </div>
            <div class="field">
              <label for="deploiement">Déploiement envisagé <span class="opt">(facultatif)</span></label>
              <select id="deploiement" name="deploiement" aria-describedby="deploiement-err">
                {Object.entries(DEPLOYMENTS).map(([value, label]) => <option value={value}>{label}</option>)}
              </select>
              <p class="field__error" id="deploiement-err" data-error-for="deploiement" hidden></p>
            </div>
            <div class="field field--full">
              <label for="message">Votre contexte</label>
              <textarea id="message" name="message" rows="7" required minlength={LIMITS.message[0]} maxlength={LIMITS.message[1]} aria-describedby="message-hint message-err"></textarea>
              <p class="field__hint" id="message-hint">Entre {LIMITS.message[0]} et {LIMITS.message[1]} caractères. N’y indiquez ni mot de passe, ni secret, ni donnée sensible.</p>
              <p class="field__error" id="message-err" data-error-for="message" hidden></p>
            </div>

            <div class="hp" aria-hidden="true">
              <label for="site_web">Site web (laisser vide)</label>
              <input id="site_web" name="site_web" type="text" tabindex="-1" autocomplete="off" />
            </div>
          </div>

          <p class="form__privacy t-small">
            Ces informations servent uniquement à répondre à votre demande. Elles sont transmises par e-mail et ne sont
            pas conservées par le site. Voir la <a class="link" href={href('privacy')}>politique de confidentialité</a>.
          </p>

          <div class="form__actions">
            <button class="btn btn--primary" type="submit" data-submit>
              Envoyer
              <Icon name="arrow-right" size={18} />
            </button>
            <p class="form__status" role="status" data-status></p>
          </div>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 48px var(--gap);
    align-items: start;
  }

  .contact__info h2,
  .form h2 {
    margin-bottom: 16px;
  }

  .contact__list {
    border-top: 2px solid var(--ink);
  }

  .contact__list > div {
    padding-block: 14px;
    border-bottom: 1px solid var(--line);
  }

  .contact__list dd {
    margin-top: 6px;
    color: var(--ink);
  }

  .contact__value {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 1.125rem;
    color: var(--link);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .form {
    padding: clamp(20px, 3vw, 40px);
    background-color: var(--surface);
    border: 1px solid var(--line);
  }

  .form__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px var(--gap);
    margin-top: 24px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .field label {
    font-weight: 500;
    color: var(--ink);
  }

  .opt {
    font-weight: 400;
    color: var(--ink-3);
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-height: 48px;
    padding: 10px 12px;
    font: inherit;
    color: var(--ink);
    background-color: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
  }

  .field select {
    appearance: none;
    padding-right: 40px;
    background-image: url('/select-chevron.svg');
    background-repeat: no-repeat;
    background-position: right 14px center;
  }

  .field textarea {
    min-height: 168px;
    resize: vertical;
  }

  .field input:focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 1px;
    border-color: var(--blue);
  }

  .field [aria-invalid='true'] {
    border: 2px solid var(--error);
  }

  .field__hint {
    font-size: var(--fs-small);
    color: var(--ink-3);
  }

  .field__error {
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--error);
  }

  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form__privacy {
    margin-top: 24px;
  }

  .form__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
    margin-top: 24px;
  }

  .form__status:empty {
    display: none;
  }

  .form__status[data-state='error'] {
    color: var(--error);
    font-weight: 500;
  }

  .summary {
    margin-top: 20px;
    padding: 14px 16px;
    border-left: 3px solid var(--error);
    background-color: var(--terra-tint);
  }

  .summary__title {
    font-weight: 500;
    color: var(--error);
  }

  .summary ul {
    margin-top: 8px;
    padding-left: 1.2em;
    list-style: disc;
  }

  .summary a {
    color: var(--error);
    text-decoration: underline;
  }

  .notice {
    margin-bottom: 24px;
    padding: 18px 20px;
    background-color: var(--surface);
    border-left: 3px solid var(--ink);
  }

  .notice--ok {
    border-left-color: var(--success);
  }

  .notice__title {
    margin-bottom: 6px;
    font-weight: 500;
    color: var(--ink);
  }

  @media (min-width: 720px) {
    .form__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .field--full {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .contact {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    }
  }
</style>

<script>
  import { initContactForm } from '../scripts/contact';
  initContactForm();
</script>
