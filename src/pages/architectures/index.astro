---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import SectionHead from '../../components/SectionHead.astro';
import ArchDiagram from '../../components/ArchDiagram.astro';
import DataTable from '../../components/DataTable.astro';
import ClaimList from '../../components/ClaimList.astro';
import ModelComparator from '../../components/ModelComparator.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import Icon from '../../components/Icon.astro';
import { getPlatform } from '../../data/platforms';
import type { Claim } from '../../data/platforms';
import { href } from '../../i18n/routes';

const identity = getPlatform('luxia-identity');

const federation: Claim[] = [
  {
    title: 'Le fournisseur prouve, le registre décide',
    text: 'Une connexion de fournisseur atteste une identité. Le compte, les droits et l’historique restent dans LUXIA Identity : changer de fournisseur ne les remet pas en cause.',
    level: 'production',
  },
  {
    title: 'Connexions isolées et coupure d’urgence',
    text: 'Chaque organisation a ses propres connexions, isolées par la base de données. Chaque connexion peut être coupée sans toucher aux autres.',
    level: 'production',
  },
  {
    title: 'Ce que Microsoft atteste, rien de plus',
    text: 'Une connexion Microsoft Entra ID est enregistrée telle que Microsoft l’atteste. La plateforme ne revendique pas de second facteur qu’elle ne peut pas prouver.',
    level: 'production',
  },
];

const continuity: Claim[] = [
  {
    title: 'Restauration démontrée',
    text: 'Exercice du 13 octobre 2026 : base de production reconstruite à partir d’une sauvegarde indépendante, dans un environnement vide. Tables et objets identiques ; base restaurée et vérifiée en 81 secondes ; écart de données mesuré de 2 min 7 s. Ce sont les mesures d’un exercice, pas un engagement.',
    level: 'production',
  },
  {
    title: 'Bascule répétée',
    text: 'Le 18 octobre 2026 : restauration de données réelles dans la région cible, puis bascule de l’application vers une base restaurée.',
    level: 'ci',
  },
  {
    title: 'Haute disponibilité',
    text: 'Aujourd’hui, celle de la plateforme managée, sans engagement de niveau de service publié. Une répartition sur plusieurs zones est décrite dans l’architecture cible.',
    level: 'target',
  },
  {
    title: 'Objectifs de reprise (RTO, RPO)',
    text: 'Fixés avec chaque client, puis vérifiés par un exercice de reprise. Aucun objectif n’est publié à ce jour.',
    level: 'target',
  },
];
---

<BaseLayout
  title="Architectures de référence"
  description="Architectures de référence Luxia-IT : fédération multi-fournisseurs, comparaison des modèles opéré, sur site et souverain, continuité. Ce qui est en service et ce qui est visé."
  crumbs={[{ label: 'Architectures' }]}
>
  <PageHead
    crumbs={[{ label: 'Architectures' }]}
    kicker="Architectures de référence"
    title="Des architectures décrites telles qu’elles sont"
    lead="Pour chaque architecture : ce qui est en service, ce qui est visé, et qui en a la charge. Une architecture visée est nommée comme telle."
  >
    <nav class="toc" aria-label="Sur cette page">
      <ol>
        <li><a href="#federation">Fédération multi-fournisseurs</a></li>
        <li><a href="#modeles">Modèles de déploiement</a></li>
        <li><a href="#continuite">Continuité</a></li>
        <li><a href={href('runtime')}>Plateforme d’exécution</a></li>
      </ol>
    </nav>
  </PageHead>

  <section class="section" id="federation" aria-labelledby="federation-title">
    <div class="wrap">
      <SectionHead
        id="federation-title"
        index="01"
        kicker="Fédération multi-fournisseurs"
        title="Les fournisseurs se branchent sur le registre"
        lead="Plusieurs populations accèdent aux mêmes ressources avec des identités d’origines différentes. LUXIA Identity reste le registre ; chaque fournisseur est un adaptateur remplaçable."
      />
      <ArchDiagram
        title="Fédération multi-fournisseurs"
        inputs={{ label: 'Personnes', items: ['Collaborateurs', 'Partenaires', 'Prestataires'] }}
        core={{ label: 'LUXIA Identity', items: ['Connexions par organisation', 'Identité canonique', 'Habilitations', 'Journal en ajout seul'] }}
        outputs={{ label: 'Gouvernance', items: ['Administrateurs', 'Revues d’accès', 'Auditeurs'] }}
        base={{ label: 'Fournisseurs connectés', items: ['Passkeys LUXIA', 'Microsoft Entra ID', 'OIDC générique (conçu)'] }}
        links={{ in: 'Connexion', out: 'Décisions tracées', base: 'Preuve d’identité' }}
      />
      <div class="block">
        <ClaimList claims={federation} columns={3} />
      </div>
      <details class="disclosure">
        <summary>Fournisseurs et protocoles, avec leur niveau de preuve</summary>
        <div class="disclosure__body">
          <DataTable
            caption="Fournisseurs et protocoles, niveau de preuve"
            columns={[
              { key: 'name', label: 'Fournisseur ou protocole' },
              { key: 'level', label: 'Niveau' },
              { key: 'note', label: 'Précision' },
            ]}
            rows={identity.integrations.map((i) => ({ name: i.name, level: { text: '', level: i.level }, note: i.note }))}
          />
        </div>
      </details>
    </div>
  </section>

  <section class="section section--alt" id="modeles" aria-labelledby="modeles-title">
    <div class="wrap">
      <SectionHead
        id="modeles-title"
        index="02"
        kicker="Modèles de déploiement"
        title="Un modèle en service, deux modèles visés"
        lead="Choisissez un modèle : le schéma et les six aspects se mettent à jour. Les responsabilités sont précisées par contrat ; seul le modèle opéré existe aujourd’hui."
      >
        <p>
          <a class="more" href={href('runtime')}>Architecture d’exécution visée pour les déploiements sur site et souverains <Icon name="arrow-right" size={16} /></a>
        </p>
      </SectionHead>
      <ModelComparator />
    </div>
  </section>

  <section class="section" id="continuite" aria-labelledby="continuite-title">
    <div class="wrap">
      <SectionHead
        id="continuite-title"
        index="03"
        kicker="Continuité"
        title="Disponibilité, sauvegarde et reprise"
        lead="Une sauvegarde ne compte que si sa restauration a été démontrée. Les mesures ci-dessous viennent d’exercices datés."
      />
      <ClaimList claims={continuity} columns={2} />
    </div>
  </section>

  <CtaBlock
    title="Confronter une architecture à vos contraintes"
    text="Sécurité, localisation des données, disponibilité, exploitation : nous partons de ce qui existe, et disons ce qui reste à construire."
    href={`${href('contact')}?sujet=architecture`}
    label="Nous écrire"
    secondary={{ href: href('runtime'), label: 'Plateforme d’exécution' }}
  />
</BaseLayout>

<style>
  .toc ol {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    font-size: var(--fs-small);
  }

  .toc a {
    color: var(--link);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .block {
    margin-block: clamp(36px, 5vw, 56px);
  }
</style>
