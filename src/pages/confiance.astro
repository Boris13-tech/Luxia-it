---
/**
 * Centre de confiance de LUXIA Identity : architecture de sécurité,
 * exploitation, hébergement, feuille de route et limites. Source unique :
 * src/data/platforms.ts (niveaux de preuve), sans reformulation qui
 * l'arrondirait. La divulgation responsable reste sur /securite/.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import LevelTag from '../components/LevelTag.astro';
import CtaBlock from '../components/CtaBlock.astro';
import Icon from '../components/Icon.astro';
import { getPlatform } from '../data/platforms';
import { facts, formatDate } from '../data/facts';
import { href } from '../i18n/routes';

const identity = getPlatform('luxia-identity');
const sections = [
  { id: 'architecture', title: 'Architecture de sécurité', lead: 'Ce qui protège vos données dans la plateforme elle-même.', claims: identity.security },
  {
    id: 'exploitation',
    title: 'Exploitation et résilience',
    lead: 'Comment la plateforme est changée, sauvegardée et restaurée.',
    claims: identity.operations,
  },
  { id: 'hebergement', title: 'Hébergement et déploiement', lead: 'Où tourne la plateforme aujourd’hui, et où elle doit aller.', claims: identity.deployment },
] as const;
---

<BaseLayout
  title="Centre de confiance"
  description="Sécurité de LUXIA Identity : isolation des organisations, sessions, opérateur sans droit, sauvegardes et restauration vérifiées, hébergement, feuille de route et limites actuelles."
  crumbs={[{ label: 'Centre de confiance' }]}
>
  <PageHead
    crumbs={[{ label: 'Centre de confiance' }]}
    kicker="Sécurité"
    title="Centre de confiance"
    lead="Comment LUXIA Identity protège vos identités et vos accès : ce qui est en service, ce qui est répété, ce qui est prévu. Chaque mesure indique où elle en est."
  >
    <p class="t-meta">
      État au <time datetime={facts.evidenceAsOf}>{formatDate(facts.evidenceAsOf)}</time>
    </p>
    <nav class="jump" aria-label="Sections du centre de confiance">
      <ul>
        {sections.map((s) => <li><a href={`#${s.id}`}>{s.title}</a></li>)}
        <li><a href="#feuille-de-route">Feuille de route</a></li>
        <li><a href="#limites">Limites actuelles</a></li>
        <li><a href="#signaler">Signaler une vulnérabilité</a></li>
      </ul>
    </nav>
  </PageHead>

  {
    sections.map((s, i) => (
      <section class:list={['section', i % 2 === 1 && 'section--alt']} id={s.id} aria-labelledby={`${s.id}-title`}>
        <div class="wrap">
          <div class="head">
            <h2 class="t-h2" id={`${s.id}-title`}>
              {s.title}
            </h2>
            <p class="t-lead">{s.lead}</p>
          </div>
          <ul class="cards">
            {s.claims.map((c) => (
              <li class="card">
                <LevelTag level={c.level} />
                <h3 class="card__title">{c.title}</h3>
                <p class="card__text">{c.text}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }

  <section class="section section--alt" id="feuille-de-route" aria-labelledby="route-title">
    <div class="wrap">
      <div class="head">
        <h2 class="t-h2" id="route-title">Feuille de route</h2>
        <p class="t-lead">Ce qui est conçu ou prévu, sans date promise : une capacité n’est annoncée qu’une fois démontrée.</p>
      </div>
      <ul class="cards">
        {
          identity.next.map((c) => (
            <li class="card">
              <LevelTag level={c.level} />
              <h3 class="card__title">{c.title}</h3>
              <p class="card__text">{c.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" id="limites" aria-labelledby="limites-title">
    <div class="wrap limits">
      <div class="head">
        <h2 class="t-h2" id="limites-title">Limites actuelles</h2>
        <p class="t-lead">Ce qu’un acheteur ou un auditeur doit savoir avant tout engagement.</p>
      </div>
      <ul class="limits__list">
        {identity.limits.map((l) => <li>{l}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section--dark" id="signaler" aria-labelledby="signaler-title">
    <div class="wrap report">
      <div>
        <h2 class="t-h2 report__title" id="signaler-title">Signaler une vulnérabilité</h2>
        <p class="report__text">
          Vous pensez avoir trouvé une faille dans ce site ou dans l’une de nos plateformes ? Écrivez-nous avant toute publication.
          Le code source de nos plateformes est public sur GitHub.
        </p>
      </div>
      <div class="actions">
        <a class="btn btn--light" href={href('security')}>
          Politique de divulgation
          <Icon name="arrow-right" size={18} />
        </a>
        <a class="report__link" href="/.well-known/security.txt">security.txt</a>
      </div>
    </div>
  </section>

  <CtaBlock
    title="Une question de votre équipe sécurité ?"
    text="Questionnaire de sécurité, architecture, hébergement des données : nous répondons précisément, y compris quand la réponse est « pas encore »."
    href={`${href('contact')}?sujet=securite`}
    label="Poser la question"
    secondary={{ href: href('identity'), label: 'Découvrir le produit' }}
  />
</BaseLayout>

<style>
  .head {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 48rem;
    margin-bottom: clamp(28px, 4vw, 44px);
  }

  .cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .card__title {
    font-size: var(--fs-h4);
    line-height: 1.3;
  }

  .card__text {
    font-size: var(--fs-small);
    color: var(--ink-2);
  }

  .limits__list {
    display: grid;
    gap: 0;
    max-width: 52rem;
    border-top: 1px solid var(--line);
  }

  .limits__list li {
    padding-block: 16px;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
  }

  .report {
    display: grid;
    gap: 28px var(--gap);
    align-items: end;
  }

  .report__title {
    color: var(--on-dark);
    margin-bottom: 12px;
  }

  .report__text {
    max-width: 40rem;
  }

  .report__link {
    color: var(--on-dark);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (min-width: 720px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .report {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }
</style>
