---
/**
 * Labs : uniquement les axes réellement poursuivis, avec leur étape.
 * ALMA : dépôt Boris13-tech/alma. Journal vérifiable : prévu dans
 * iam-azure-pme/docs/legal/SECURITY-OVERVIEW.md (« LUXIA Trust Ledger »).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import SectionHead from '../components/SectionHead.astro';
import StageTag from '../components/StageTag.astro';
import LevelTag from '../components/LevelTag.astro';
import EvidenceScale from '../components/EvidenceScale.astro';
import CtaBlock from '../components/CtaBlock.astro';
import Icon from '../components/Icon.astro';
import { getPlatform, platformHref } from '../data/platforms';
import { href } from '../i18n/routes';

const alma = getPlatform('alma');
---

<BaseLayout
  title="Labs"
  description="Luxia-IT Labs : recherche appliquée sur les agents IA gouvernés (ALMA) et les journaux vérifiables. Chaque travail indique son étape : recherche, prototype ou produit."
  crumbs={[{ label: 'Labs' }]}
>
  <PageHead
    crumbs={[{ label: 'Labs' }]}
    kicker="Labs"
    title="Recherche appliquée, distinguée du produit"
    lead="Les Labs explorent ce que l’identité devra couvrir demain. Chaque travail indique son étape : recherche, prototype ou produit. Aucun n’est un produit à ce jour."
  />

  <section class="section" aria-labelledby="axes-title">
    <div class="wrap">
      <SectionHead id="axes-title" index="01" kicker="Axes" title="Deux axes poursuivis" />
      <ol class="axes">
        <li class="axes__item">
          <div class="axes__id">
            <h3 class="t-h3">Agents IA gouvernés</h3>
            <StageTag stage={alma.stage} />
          </div>
          <div class="axes__body">
            <p class="t-lead">{alma.lead}</p>
            <p>
              Le prototype ALMA agit par des outils déclarés, chacun avec son niveau de risque. Toute action irréversible
              exige un accord explicite, et aucune action n’est annoncée si l’outil n’a pas répondu avec succès. La
              question suivante, celle des droits d’un agent dans une organisation, relève de LUXIA Identity.
            </p>
            <a class="more" href={platformHref(alma.slug)}>
              ALMA : capacités et limites
              <Icon name="arrow-right" size={16} />
            </a>
          </div>
        </li>
        <li class="axes__item">
          <div class="axes__id">
            <h3 class="t-h3">Journaux vérifiables</h3>
            <StageTag stage="research" />
          </div>
          <div class="axes__body">
            <p class="t-lead">Des enregistrements dont l’intégrité peut être démontrée à un tiers.</p>
            <p>
              Aujourd’hui, le journal de LUXIA Identity est en ajout seul : l’application ne peut ni le modifier ni le
              supprimer. Ce n’est pas une immuabilité cryptographique : un administrateur privilégié de la base pourrait
              encore modifier cette garde par une migration revue. L’objectif est un journal dont toute altération se
              détecte.
            </p>
            <LevelTag level="target" />
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="etapes-title">
    <div class="wrap">
      <SectionHead
        id="etapes-title"
        index="02"
        kicker="Lecture"
        title="Recherche, prototype, produit"
        lead="Un travail des Labs ne devient une capacité de plateforme qu’en montant l’échelle de preuve, comme le reste."
      />
      <EvidenceScale />
    </div>
  </section>

  <CtaBlock
    title="Vous travaillez sur ces sujets ?"
    text="Agents IA, preuves d’intégrité, authentification : nous échangeons volontiers avec les équipes qui s’y confrontent."
    href={`${href('contact')}?sujet=labs`}
    label="Nous écrire"
  />
</BaseLayout>

<style>
  .axes__item {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px var(--gap);
    padding-block: 36px 40px;
    border-top: 1px solid var(--line);
  }

  .axes__item:last-child {
    border-bottom: 1px solid var(--line);
  }

  .axes__id {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .axes__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    max-width: 46rem;
  }

  @media (min-width: 1024px) {
    .axes__item {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    }
  }
</style>
