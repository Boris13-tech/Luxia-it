---
/**
 * Carrières. Les principes de travail reprennent les règles écrites des
 * dépôts (décisions d'architecture, preuve en production, retour arrière).
 * Les postes ne s'affichent que s'ils sont renseignés ci-dessous.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import SectionHead from '../components/SectionHead.astro';
import Icon from '../components/Icon.astro';
import { facts } from '../data/facts';

const principles = [
  { title: 'Écrire avant de coder', text: 'Une décision d’architecture précède le code. Elle est relue, puis conservée.' },
  { title: 'Une preuve, pas une impression', text: 'Une capacité n’est terminée que lorsqu’elle est vérifiée là où elle doit fonctionner.' },
  { title: 'Le retour arrière d’abord', text: 'Aucune migration sans répétition sur une copie ni retour arrière écrit.' },
  { title: 'Dire ce qui manque', text: 'Une limite connue s’écrit. Elle ne se tait pas.' },
];

/** Postes ouverts : à renseigner (intitulé, lieu, contrat, lien vers l'annonce). */
const openings: readonly { title: string; place: string; contract: string }[] = [];
const applyHref = `mailto:${facts.contact.email}?subject=${encodeURIComponent('Candidature')}`;
---

<BaseLayout
  title="Carrières"
  description="Travailler chez Luxia-IT : des systèmes d’identité dont d’autres dépendent, une méthode fondée sur la preuve. Postes publiés et candidatures spontanées."
  crumbs={[{ label: 'Entreprise', href: '/entreprise/' }, { label: 'Carrières' }]}
>
  <PageHead
    crumbs={[{ label: 'Entreprise', href: '/entreprise/' }, { label: 'Carrières' }]}
    kicker="Carrières"
    title="Travailler sur des systèmes dont d’autres dépendent"
    lead="Les postes ouverts sont publiés sur cette page lorsqu’il y en a. Les candidatures spontanées sont lues."
  />

  <section class="section" aria-labelledby="principes-title">
    <div class="wrap">
      <SectionHead id="principes-title" index="01" kicker="Méthode" title="Comment nous travaillons" />
      <ul class="ruled ruled--4">
        {
          principles.map((p) => (
            <li>
              <h3 class="ruled__title">{p.title}</h3>
              <p class="ruled__text">{p.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--alt" id="postes" aria-labelledby="postes-title">
    <div class="wrap">
      <SectionHead id="postes-title" index="02" kicker="Postes" title="Postes ouverts">
        {
          openings.length > 0 ? (
            <ul class="jobs">
              {openings.map((o) => (
                <li>
                  <p class="jobs__title">{o.title}</p>
                  <p class="t-small">
                    {o.place} · {o.contract}
                  </p>
                </li>
              ))}
            </ul>
          ) : (
            <p class="t-lead">Aucun poste n’est publié pour le moment.</p>
          )
        }
        <p>
          Candidature spontanée : écrivez à
          <a class="link" href={applyHref}>{facts.contact.email}</a>, avec l’objet « Candidature ».
        </p>
        <p>
          <a class="btn btn--secondary" href={applyHref}>
            <Icon name="mail" size={18} />
            Envoyer une candidature
          </a>
        </p>
      </SectionHead>
    </div>
  </section>
</BaseLayout>

<style>
  .jobs {
    border-top: 2px solid var(--ink);
  }

  .jobs li {
    padding-block: 14px;
    border-bottom: 1px solid var(--line);
  }

  .jobs__title {
    font-weight: 500;
    color: var(--ink);
  }
</style>
