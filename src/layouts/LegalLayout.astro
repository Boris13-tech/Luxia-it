---
import BaseLayout from './BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
}

const { title, description, eyebrow = 'Informations légales' } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <PageBanner crumbs={[{ label: title }]} kicker={eyebrow} title="" hl={title} />
  <section class="section bg-gray">
    <div class="container">
      <article class="prose">
        <slot />
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .prose {
    max-width: 860px;
    margin-inline: auto;
    padding: clamp(28px, 4vw, 56px);
    border-radius: var(--radius);
    background-color: var(--white);
    box-shadow: var(--shadow);
    color: var(--fg);
  }

  .prose :global(h2) {
    margin: 40px 0 14px;
    padding-left: 14px;
    border-left: 4px solid var(--brand);
    font-size: var(--fs-h4);
    line-height: 1.3;
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(p),
  .prose :global(ul) {
    margin-bottom: 14px;
  }

  .prose :global(ul) {
    padding-left: 22px;
    list-style: disc;
  }

  .prose :global(li) {
    margin-bottom: 6px;
  }

  .prose :global(li::marker) {
    color: var(--brand);
  }

  .prose :global(a) {
    color: var(--brand-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose :global(strong) {
    color: var(--slate-darker);
  }
</style>
