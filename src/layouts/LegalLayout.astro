---
/** Pages légales : ouverture commune, texte long en colonne de lecture. */
import BaseLayout from './BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import { formatDate } from '../data/facts';

interface Props {
  title: string;
  description: string;
  kicker?: string | undefined;
  lead?: string | undefined;
  /** Date ISO de dernière mise à jour du texte. */
  updated: string;
}

const { title, description, kicker = 'Informations légales', lead, updated } = Astro.props;
---

<BaseLayout title={title} description={description} crumbs={[{ label: title }]}>
  <PageHead crumbs={[{ label: title }]} kicker={kicker} title={title} lead={lead}>
    <p class="t-meta">Dernière mise à jour : <time datetime={updated}>{formatDate(updated)}</time></p>
  </PageHead>
  <section class="section">
    <div class="wrap">
      <article class="prose">
        <slot />
      </article>
    </div>
  </section>
</BaseLayout>
