---
/**
 * Gabarit commun : métadonnées, référencement (canonique, hreflang, Open
 * Graph, Twitter Card, JSON-LD), en-tête et pied de page.
 * Les données structurées ne reprennent que des faits du registre.
 */
import '@fontsource-variable/roboto';
// Police principale préchargée : elle arrive avec la feuille de style (pas de décalage au remplacement).
import robotoLatin from '@fontsource-variable/roboto/files/roboto-latin-wght-normal.woff2?url';
import interTightLatin from '@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url';
import '../styles/global.css';
import '../styles/motion.css';
import '../styles/transitions.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { facts } from '../data/facts';
import { defaultLocale, localeFromPath, localeMeta } from '../i18n/config';
import { alternatesOf, href } from '../i18n/routes';
import { ui } from '../i18n/ui';

export interface Crumb {
  label: string;
  href?: string | undefined;
}

interface Props {
  title: string;
  description: string;
  /** Fil d'Ariane (sans l'accueil), repris en BreadcrumbList. */
  crumbs?: readonly Crumb[] | undefined;
  /** Exclure la page des moteurs (404, pages de résultat du formulaire). */
  noindex?: boolean | undefined;
  /** Image de partage, chemin public (1200 × 630). */
  image?: string | undefined;
  imageAlt?: string | undefined;
  /** Univers de couleur d'un produit (docs/CREATIVE_DIRECTION.md, section 4). */
  universe?: 'key' | 'alma' | undefined;
}

const {
  title,
  description,
  crumbs = [],
  noindex = false,
  image = '/og/luxia-it.png',
  imageAlt = 'LUXIA-IT, Identité & confiance : plateformes d’identité et de confiance pour les opérations critiques.',
} = Astro.props;

const site = Astro.site ?? new URL(facts.brand.origin);
const path = Astro.url.pathname;
const locale = localeFromPath(path);
const t = ui[locale];
const isHome = path === href('home', locale);
const fullTitle = isHome ? `${facts.brand.name} — ${title}` : `${title} — ${facts.brand.name}`;
const canonical = new URL(path, site).href;
const imageUrl = new URL(image, site).href;
const alternates = noindex ? [] : alternatesOf(path);
const xDefault = alternates.find((a) => a.locale === defaultLocale);

const organization = {
  '@type': 'Organization',
  '@id': new URL('/#organisation', site).href,
  name: facts.brand.name,
  ...(facts.publisher.legalName ? { legalName: facts.publisher.legalName } : {}),
  url: new URL('/', site).href,
  logo: new URL('/brand/luxia-it-logo-512.png', site).href,
  slogan: facts.brand.signature,
  email: facts.contact.email,
  telephone: facts.contact.phoneHref.replace('tel:', ''),
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: 'sales',
      email: facts.contact.email,
      telephone: facts.contact.phoneHref.replace('tel:', ''),
      availableLanguage: ['fr'],
    },
  ],
  ...(facts.contact.linkedin ? { sameAs: [facts.contact.linkedin] } : {}),
};

const graph: Record<string, unknown>[] = [organization];

if (isHome) {
  graph.push({
    '@type': 'WebSite',
    '@id': new URL('/#site', site).href,
    name: facts.brand.name,
    url: new URL('/', site).href,
    inLanguage: localeMeta[locale].lang,
    publisher: { '@id': organization['@id'] },
  });
}

if (crumbs.length > 0) {
  const trail = [{ label: t.home, href: href('home', locale) }, ...crumbs];
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: trail.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.label,
      item: new URL(c.href ?? path, site).href,
    })),
  });
}

// « < » échappé : le JSON ne peut pas refermer la balise <script>.
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={localeMeta[locale].lang} data-universe={Astro.props.universe}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {
      alternates.length > 0 &&
        alternates.map((a) => <link rel="alternate" hreflang={localeMeta[a.locale].lang} href={new URL(a.path, site).href} />)
    }
    {xDefault && <link rel="alternate" hreflang="x-default" href={new URL(xDefault.path, site).href} />}
    <link rel="preload" href={robotoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interTightLatin} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#07090d" />
    <meta name="color-scheme" content="dark" />
    <!-- Sens des transitions de page : doit précéder le premier rendu -->
    <script is:inline src="/scripts/transitions.js"></script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={facts.brand.name} />
    <meta property="og:locale" content={localeMeta[locale].og} />
    {
      alternates
        .filter((a) => a.locale !== locale)
        .map((a) => <meta property="og:locale:alternate" content={localeMeta[a.locale].og} />)
    }
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <a class="skip-link" href="#contenu">{t.skip}</a>
    <div class="beam" aria-hidden="true"></div>
    <Header />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import { initTabs } from '../scripts/tabs';
      initTabs();
    </script>
  </body>
</html>
