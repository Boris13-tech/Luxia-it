{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "regions": [
    "fra1"
  ],
  "functions": {
    "api/contact.ts": {
      "maxDuration": 10,
      "memory": 256
    }
  },
  "redirects": [
    {
      "source": "/:locale(fr|en|zh)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:locale(fr|en|zh)/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:locale(fr|en|zh)?/company/careers",
      "destination": "/carrieres/",
      "permanent": true
    },
    {
      "source": "/:locale(fr|en|zh)?/company/careers/",
      "destination": "/carrieres/",
      "permanent": true
    },
    {
      "source": "/:locale(fr|en|zh)?/company",
      "destination": "/entreprise/",
      "permanent": true
    },
    {
      "source": "/:locale(fr|en|zh)?/company/",
      "destination": "/entreprise/",
      "permanent": true
    },
    {
      "source": "/:locale(fr|en|zh)?/expertise/cloud",
      "destination": "/architectures/",
      "permanent": true
    },
    {
      "source": "/:locale(fr|en|zh)?/expertise/cloud/",
      "destination": "/architectures/",
      "permanent": true
    },
    {
      "source": "/:locale(fr|en|zh)?/expertise/:rest*",
      "destination": "/services/",
      "permanent": true
    },
    {
      "source": "/:locale(fr|en|zh)?/expertise/:rest*/",
      "destination": "/services/",
      "permanent": true
    },
    {
      "source": "/:locale(fr|en|zh)?/solutions/:rest*",
      "destination": "/plateformes/",
      "permanent": true
    },
    {
      "source": "/:locale(fr|en|zh)?/solutions/:rest*/",
      "destination": "/plateformes/",
      "permanent": true
    },
    {
      "source": "/:locale(fr|en|zh)?/industries/:rest*",
      "destination": "/plateformes/",
      "permanent": true
    },
    {
      "source": "/:locale(fr|en|zh)?/industries/:rest*/",
      "destination": "/plateformes/",
      "permanent": true
    },
    {
      "source": "/:locale(fr|en|zh)?/case-studies/:rest*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:locale(fr|en|zh)?/case-studies/:rest*/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:locale(fr|en|zh)?/insights/:rest*",
      "destination": "/labs/",
      "permanent": true
    },
    {
      "source": "/:locale(fr|en|zh)?/insights/:rest*/",
      "destination": "/labs/",
      "permanent": true
    },
    {
      "source": "/:locale(fr|en|zh)?/privacy",
      "destination": "/confidentialite/",
      "permanent": true
    },
    {
      "source": "/:locale(fr|en|zh)?/privacy/",
      "destination": "/confidentialite/",
      "permanent": true
    },
    {
      "source": "/:locale(fr|en|zh)?/legal",
      "destination": "/mentions-legales/",
      "permanent": true
    },
    {
      "source": "/:locale(fr|en|zh)?/legal/",
      "destination": "/mentions-legales/",
      "permanent": true
    },
    {
      "source": "/:locale(fr|en|zh)/labs",
      "destination": "/labs/",
      "permanent": true
    },
    {
      "source": "/:locale(fr|en|zh)/labs/",
      "destination": "/labs/",
      "permanent": true
    },
    {
      "source": "/:locale(fr|en|zh)/contact",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/:locale(fr|en|zh)/contact/",
      "destination": "/contact/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; media-src 'self'; connect-src 'self'; form-action 'self'; manifest-src 'self'; base-uri 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests; require-trusted-types-for 'script'; trusted-types 'none'"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "off"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
