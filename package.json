{
  "name": "luxia-it-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && node scripts/check-dist.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "astro check && node scripts/lint-content.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "verify": "npm run lint && npm run build && npm test",
    "release:check": "node scripts/release-check.mjs",
    "audit:deps": "npm audit --omit=dev",
    "preview:secure": "node tools/preview-secure.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/inter-tight": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/roboto": "5.3.0",
    "@lucide/astro": "1.48.0",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3"
  }
}
