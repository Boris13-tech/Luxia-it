# ─────────────────────────────────────────────────────────────────────────────
# Luxia-IT .gitattributes
# Normalize line endings. LF in the repository, handled by the platform on
# Windows. This prevents LF<->CRLF churn across developer machines and CI.
# ─────────────────────────────────────────────────────────────────────────────

* text=auto eol=lf

# Explicit overrides for specific file types
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.conf  text eol=lf

# Binary files — never touch line endings
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.zip   binary
