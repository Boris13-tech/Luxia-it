# URL publique du site (canonical, sitemap, robots.txt, security.txt).
# Facultative : vide ou absente, c'est https://luxia-it.com qui s'applique.
# « luxia-it.com » sans https:// est accepté ; une valeur invalide arrête le build.
SITE_URL=
# Adresse de traitement du formulaire de contact (laisser vide tant qu'elle n'existe pas)
PUBLIC_FORM_ENDPOINT=
