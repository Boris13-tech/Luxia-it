# Sample environment configuration for Luxia-IT
# Copy this file to `.env` and fill in the values you need.
# `.env` is git-ignored. Never commit real values.

# Contact form endpoint (server-side, injected at deploy time).
# Leave blank to keep the form in preview mode. No data is transmitted then.
# Wire this to a form service such as Formspree or Basin, or to a small
# serverless function that validates and forwards submissions to a mailbox.
CONTACT_ENDPOINT=

# Analytics (optional). Leave blank to ship without analytics.
# Use a privacy-respecting provider such as Plausible, Fathom, or self-hosted
# Umami. No third-party analytics loads by default.
ANALYTICS_DOMAIN=

# Public site URL. Used in canonical tags and sitemap generation.
SITE_URL=https://luxia-it.example
